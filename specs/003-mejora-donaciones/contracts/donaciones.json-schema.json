{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Donaciones",
  "description": "Array de donaciones individuales para el indicador de donaciones de Acordes Gaditanos",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["fecha", "importe"],
    "properties": {
      "fecha": {
        "type": "string",
        "pattern": "^\\d{2}/\\d{2}/\\d{4}$",
        "description": "Fecha de la donación en formato DD/MM/YYYY"
      },
      "importe": {
        "type": "number",
        "minimum": 0.01,
        "description": "Importe donado en euros"
      },
      "donante": {
        "type": "string",
        "description": "Nombre del donante (opcional, por defecto 'Anónimo')"
      }
    }
  },
  "minItems": 0
}
