# Índice del buscador: se descarga al abrir el buscador, así que conviene que
# el navegador lo guarde y no lo revalide en cada página.
/indice-busqueda.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Catálogo de cards de /buscar (lo pinta en el navegador). Es más grande que el
# índice de sugerencias, así que se cachea una hora: si se publica una copla,
# como mucho tarda eso en salir en los resultados de quien ya lo había bajado.
/indice-tarjetas.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Fechas de alta de las rutas (solo lo pide el panel al abrir Estadísticas).
# Se revalida para que una publicación reciente no tarde en verse.
/rutas-fechas.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Fuentes autoalojadas (woff2). Nombres sin versión: si se regenera un archivo,
# renombrarlo para no servir la versión vieja durante el max-age.
/fonts/*
  Cache-Control: public, max-age=31536000

# Imágenes del aviso push (badge e icono). El navegador las descarga al pintar
# la notificación y, si no las tiene en caché, las vuelve a pedir en cada push:
# con `max-age=0` ese viaje se hace en el momento menos oportuno y, si falla, el
# móvil pierde la AG y Android pinta su campana por defecto. Como /fonts/*, si se
# regeneran hay que renombrarlas para no servir la vieja durante un año.
/badge-96.png
  Cache-Control: public, max-age=31536000, immutable

/icon-192.png
  Cache-Control: public, max-age=31536000, immutable

# Service worker: nunca debe cachearse en CDN/edge, o se serviría una versión
# vieja y la app no se actualizaría.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# Manifest de la PWA: caché corta para que los cambios lleguen pronto.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
