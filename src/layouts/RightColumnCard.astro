---
const { title, headingId, class: className, flush = false } = Astro.props;
const hasTitle = Boolean(title);
// Build a stable id from the explicit `headingId` prop or the title.
const headingIdFinal =
  headingId ??
  `rightcard-${String(title || '')}`
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
---

<section class:list={[className, { 'is-flush': flush }]} aria-labelledby={hasTitle ? headingIdFinal : undefined}>
  {
    hasTitle && (
      <header>
        <h3 id={headingIdFinal}>{title}</h3>
      </header>
    )
  }

  <div role='region' aria-labelledby={hasTitle ? headingIdFinal : undefined}>
    <slot />
  </div>
</section>

<style>
  section {
    position: relative;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;

    &::after {
      content: none;
    }
  }

  section.is-flush {
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
  }

  header {
    display: flex;
    flex-direction: column;
    position: relative;
    width: fit-content;
  }

  h3 {
    color: var(--primary-color);
    font-size: 1.1rem;
    font-family: 'Roboto Mono', monospace;
    letter-spacing: 1px;
    font-weight: 800;
    text-transform: uppercase;
    margin: 0;

    &::after {
      content: '';
      display: block;
      position: absolute;
      bottom: -4px;
      width: 95%;
      height: 4px;
      background: var(--primary-contrast-color);
      border-radius: 0;
    }
  }

  /* @media (--mq-sm) { */
  @media (max-width: 640px) {
    section {
      gap: var(--card-padding-sm);
      padding: 0;
    }
    h3 {
      font-size: var(--acorde-card-header-font-size-sm);
    }
  }
</style>
