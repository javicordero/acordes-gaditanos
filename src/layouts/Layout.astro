---
import '../styles/global.css';
import ContactInit from '../components/utils/ContactInit.astro';
import AnchoPreInit from '../components/utils/AnchoPreInit.astro';
import FitTextInit from '../components/utils/FitTextInit.astro';
import PrefetchTap from '../components/utils/PrefetchTap.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AnuncioSobreFooter from '../components/right-column/anuncios/AnuncioSobreFooter.astro';
import InstalarAppPanel from '../components/pwa/InstalarAppPanel.astro';
import AvisoInstalar from '../components/pwa/AvisoInstalar.astro';
import AvisoAvisos from '../components/pwa/AvisoAvisos.astro';
import canales from '../data/canales.json';
import { ANALYTICS, SEO } from '../lib/constants';
import {
  HOSTS_SIN_ANUNCIOS,
  SUFIJOS_SIN_ANUNCIOS,
  RUTAS_PRIVADAS,
  SCRIPT_ADSENSE,
  esRutaPrivada,
} from '../lib/anuncios';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  keywords?: string;
  noInPagePush?: boolean;
  /** Herramientas con su propio anuncio manual: no sumar el global sobre el footer. */
  sinAnuncioSobreFooter?: boolean;
  articlePublishedTime?: string;
  articleAuthors?: string[];
}

const {
  title = 'Acordes Gaditanos - Acordes del Carnaval de Cádiz',
  description = 'La mayor colección de acordes de guitarra del Carnaval de Cádiz. Aprende a tocar con tu guitarra todas las presentaciones, pasodobles, tangos, cuplés y popurrís de tus comparsas, chirigotas, coros y cuartetos favoritos.',
  image = '/og-image.jpg',
  noindex = false,
  keywords = 'carnaval, carnaval de cadiz, COAC, guitarra, acordes de guitarra, comparsa, chirigota, coro, cuartetos, letras carnaval, acordes carnaval',
  noInPagePush = false,
  sinAnuncioSobreFooter = false,
  articlePublishedTime,
  articleAuthors,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Páginas privadas (panel, borradores, listas internas, stats): son visitas del
// propietario, así que no se miden ni llevan anuncios. La lista vive en
// src/lib/anuncios.ts y la comparte el script del head.
const sinAnalitica = esRutaPrivada(Astro.url.pathname);
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='theme-color' content='#e5e5e5' id='theme-color-meta' />

    <!-- PWA / iOS: instalable a pantalla de inicio -->
    <meta name='mobile-web-app-capable' content='yes' />
    <meta name='apple-mobile-web-app-capable' content='yes' />
    <meta name='apple-mobile-web-app-status-bar-style' content='black' />
    <meta name='apple-mobile-web-app-title' content='Acordes Gaditanos' />

    <!-- Aplica el tema oscuro antes del primer pintado para evitar destellos -->
    <script is:inline>
      (function () {
        var dark = false;
        try {
          dark = localStorage.getItem('ag_theme') === 'dark';
        } catch (e) {}
        if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        var meta = document.getElementById('theme-color-meta');
        if (meta) meta.setAttribute('content', dark ? '#12141a' : '#e5e5e5');
      })();
    </script>

    <!-- PWA: captura el beforeinstallprompt antes de que carguen los módulos.
         En móvil suprimimos el mini-infobar automático del navegador: el aviso lo
         damos nosotros (botón de la cabecera y tarjeta de la ficha) y el diálogo
         nativo sale al pulsar. En escritorio no lo tocamos. -->
    <script is:inline>
      (function () {
        window.__agPwa = { prompt: null, installed: false };
        window.addEventListener('beforeinstallprompt', function (e) {
          var ua = navigator.userAgent;
          var esMovil = /android|iphone|ipod|ipad/i.test(ua) ||
            (/macintosh/i.test(ua) && navigator.maxTouchPoints > 1);
          if (esMovil) e.preventDefault();
          window.__agPwa.prompt = e;
          window.dispatchEvent(new CustomEvent('ag:beforeinstallprompt'));
        });
        window.addEventListener('appinstalled', function () {
          window.__agPwa.installed = true;
          window.dispatchEvent(new CustomEvent('ag:appinstalled'));
        });
      })();
    </script>

    <!-- Resource Hints - Preconnect for faster external resources -->
    <link rel='preconnect' href='https://www.googletagmanager.com' />
    <link rel='preconnect' href='https://static.cloudflareinsights.com' />

    <!-- Preload critical fonts -->
    <link rel='preload' href='/fonts/roboto-mono-latin.woff2' as='font' type='font/woff2' crossorigin />
    <link rel='preload' href='/fonts/bodoni-logo.woff2' as='font' type='font/woff2' crossorigin />

    <link rel='icon' type='image/png' sizes='32x32' href='/favicon-32.png' />
    <link rel='icon' type='image/png' sizes='192x192' href='/favicon-192.png' />
    <link rel='alternate icon' type='image/x-icon' href='/favicon.ico' />
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
    <link rel='manifest' href='/manifest.webmanifest' />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <link rel='canonical' href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name='title' content={title} />
    <meta name='description' content={description} />
    <meta name='keywords' content={keywords} />
    <meta name='author' content='Acordes Gaditanos' />
    <meta name='generator' content={Astro.generator} />
    {noindex && <meta name='robots' content='noindex, nofollow' />}

    <!-- Open Graph / Facebook -->
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={imageURL} />
    <meta property='og:locale' content='es_ES' />
    <meta property='og:site_name' content='Acordes Gaditanos' />
    {articlePublishedTime && <meta property='article:published_time' content={articlePublishedTime} />}
    {articleAuthors?.map((author) => (
      <meta property='article:author' content={author} />
    ))}

    <!-- Twitter -->
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:url' content={canonicalURL} />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={imageURL} />

    <!-- Structured Data (Schema.org) -->
    <script
      type='application/ld+json'
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Acordes Gaditanos',
        url: Astro.site,
        description: 'Acordes del Carnaval de Cádiz',
        inLanguage: 'es-ES',
        potentialAction: {
          '@type': 'SearchAction',
          target: `${Astro.site}?q={search_term_string}`,
          'query-input': 'required name=search_term_string',
        },
      })}
    />
    <script
      type='application/ld+json'
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Acordes Gaditanos',
        url: Astro.site,
        description: 'La mayor colección de acordes de guitarra del Carnaval de Cádiz',
        sameAs: [
          'https://twitter.com/acordesgaditano',
          canales.telegram,
          canales.whatsapp,
        ],
        contactPoint: {
          '@type': 'ContactPoint',
          email: 'acordesgaditanos@gmail.com',
          contactType: 'customer service',
        },
      })}
    />

    {/* Sin anuncios ni medición en desarrollo: local, túneles de desarrollo
         (devtunnels, ngrok, cloudflare…), deploy previews (*.netlify.app), IPs
         de la red local y páginas privadas del propietario. La lista vive en
         src/lib/anuncios.ts. Tiene que ir antes de GA y del loader de AdSense. */}
    <script
      is:inline
      define:vars={{ exactos: HOSTS_SIN_ANUNCIOS, sufijos: SUFIJOS_SIN_ANUNCIOS, rutas: RUTAS_PRIVADAS, gaId: ANALYTICS.gaId }}
    >
      (function () {
        var host = (location.hostname || '').toLowerCase().replace(/^\[|\]$/g, '');
        var desarrollo =
          !host ||
          exactos.indexOf(host) !== -1 ||
          sufijos.some(function (sufijo) {
            return host.slice(-sufijo.length) === sufijo;
          }) ||
          /^\d{1,3}(\.\d{1,3}){3}$/.test(host);
        var ruta = location.pathname;
        var privada = rutas.some(function (p) {
          return ruta === p || ruta.indexOf(p + '/') === 0;
        });
        var anuncios = !desarrollo && !privada;
        window.__agAnuncios = anuncios;
        if (!anuncios) {
          document.documentElement.setAttribute('data-anuncios', 'off');
          window['ga-disable-' + gaId] = true;
        }
      })();
    </script>

    <!-- Cloudflare Web Analytics -->
    {
      !import.meta.env.DEV && !import.meta.env.VITE_DISABLE_CLOUDFLARE && !sinAnalitica && (
        <script
          defer
          src='https://static.cloudflareinsights.com/beacon.min.js'
          data-cf-beacon='{"token": "69575422c7ad4587aad9e1a1b02a5b43", "spa": true}'
        />
      )
    }

    <!-- End Cloudflare Web Analytics -->



    <!-- Google Search Console -->
    <meta name='google-site-verification' content='rcKUCESBALVUqnlrzW0AnQh8FqUzluPR9L1zex9eMw0' />
    <!-- End Google Search Console -->

    <!-- Google Adsense: el loader solo se inyecta donde se permite (ver arriba).
         Inline para que se ejecute durante el parseo y no retrase el anuncio. -->
    <meta name="google-adsense-account" content={SEO.adsenseAccount}>
    <script is:inline define:vars={{ src: SCRIPT_ADSENSE }}>
      (function () {
        if (!window.__agAnuncios) {
          document.documentElement.setAttribute('data-anuncios', 'off');
          return;
        }
        var s = document.createElement('script');
        s.async = true;
        s.src = src;
        s.crossOrigin = 'anonymous';
        // Si el loader está bloqueado (adblock, red, CSP), no habrá anuncios:
        // se apagan los slots para no dejar huecos ni márgenes.
        s.onerror = function () {
          document.documentElement.setAttribute('data-anuncios', 'off');
        };
        document.head.appendChild(s);
      })();
    </script>
    <!-- End Google Adsense -->

    {/* Google Analytics (solo gtag). No hay Google Tag Manager: tener los dos
         descargaba gtm.js para nada y, si el contenedor llevaba GA4, contaba
         cada visita dos veces. No volver a añadir GTM sin quitar gtag. */}
 {
      !import.meta.env.DEV && !sinAnalitica && (
        <>
          <script is:inline define:vars={{ gaId: ANALYTICS.gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }

            // `define:vars` hace que Astro envuelva este script en una IIFE, así
            // que sin esta línea `gtag` quedaría encerrado y los componentes no
            // podrían enviar eventos (solo funcionaría el `config` de aquí).
            window.gtag = gtag;

            // Consent Mode v2: todo denegado hasta que el CMP de Google lo conceda
            gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
              wait_for_update: 500,
            });
            // Solo añade redacción cuando ad_storage está denegado; Google ignora
            // este ajuste cuando ad_storage está concedido.
            gtag('set', 'ads_data_redaction', true);

            // El CMP de Google (Privacy & messaging) es el gestor único de consentimiento
            window.googlefc = window.googlefc || {};
            window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
            // Estado que consume el experimento de precios de Amazon. Si no hay
            // consentimiento de analítica, el experimento se queda en la
            // variante A (sin precio) y no se asigna ningún bucket.
            window.__agConsentimiento = window.__agConsentimiento || {
              listo: false,
              analitica: false,
            };
            window.googlefc.callbackQueue.push({
              CONSENT_MODE_DATA_READY: () => {
                try {
                  const vals = window.googlefc.getGoogleConsentModeValues();
                  const notDenied = (s) =>
                    s !==
                    window.googlefc.ConsentModePurposeStatusEnum
                      .CONSENT_MODE_PURPOSE_STATUS_DENIED;
                  const analitica = notDenied(
                    vals.analyticsStoragePurposeConsentStatus,
                  );
                  window.__agConsentimiento = { listo: true, analitica };
                  window.dispatchEvent(
                    new CustomEvent('ag:consentimiento', {
                      detail: window.__agConsentimiento,
                    }),
                  );
                  // Por window.gtag para que el envoltorio de la PWA (que
                  // encola eventos hasta el consentimiento) también se entere.
                  window.gtag('consent', 'update', {
                    ad_storage: notDenied(vals.adStoragePurposeConsentStatus)
                      ? 'granted'
                      : 'denied',
                    analytics_storage: analitica ? 'granted' : 'denied',
                    ad_user_data: notDenied(vals.adUserDataPurposeConsentStatus)
                      ? 'granted'
                      : 'denied',
                    ad_personalization: notDenied(vals.adPersonalizationPurposeConsentStatus)
                      ? 'granted'
                      : 'denied',
                  });
                } catch (e) {}
              },
            });

            // Inicialización básica
            gtag('js', new Date());

            // Enviar visita (Consent Mode decide si se bloquea o no)
            function sendPageView() {
              gtag('config', gaId, {
                page_path: window.location.pathname,
                page_location: window.location.href,
                page_title: document.title,
              });
            }

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', sendPageView);
            } else {
              sendPageView();
            }
          </script>

          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.gaId}`}></script>
        </>
      )
    }
    <!-- End Google Analytics -->
    <!-- Contador propio  -->
    {!sinAnalitica && (
      <script is:inline>
  const registerVisit = async () => {
    const path = window.location.pathname;
    // Capturamos de dónde viene (ej: google.com) o ponemos 'direct' si viene vacío
    const referrer = document.referrer ? new URL(document.referrer).hostname : 'direct';
    
    // Solo enviamos el referrer si viene de fuera de nuestra propia web
    const refParam = referrer !== window.location.hostname ? referrer : 'direct';

    try {
      await fetch(`https://stats-worker.javiercorderotoscano.workers.dev?path=${path}&ref=${refParam}`);
    } catch (e) {
      console.error("Error");
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const host = location.hostname;
    // No cuentan: local, deploy previews (*.netlify.app) ni páginas privadas.
    if (host === 'localhost' || host.endsWith('.netlify.app')) return;
    registerVisit();
  });
      </script>
    )}

<!-- End contador propio -->
    
  </head>
  <body>
    <Header />
    <slot />
    <!-- Sobre footer -->
    {!sinAnalitica && !sinAnuncioSobreFooter && <AnuncioSobreFooter />}
    <Footer />
    <InstalarAppPanel />
    {!sinAnalitica && <AvisoInstalar />}
    {!sinAnalitica && <AvisoAvisos />}
    <ContactInit />
    <AnchoPreInit />
    <FitTextInit />
    <PrefetchTap />

    <!-- PWA: registra el service worker e inicializa la analítica de instalación -->
    <script>
      import '../pwa';
    </script>

  </body>
</html>
