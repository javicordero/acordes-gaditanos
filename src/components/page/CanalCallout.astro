---
// src/components/page/CanalCallout.astro
//
// Invitación a seguir los canales de avisos (WhatsApp y Telegram).
// - variante 'linea' (home): una línea discreta con dos enlaces.
// - variante 'destacado' (/pedir-copla): texto normal y dos botones.
import { Icon } from 'astro-icon/components';
import canales from '../../data/canales.json';

interface Props {
  /** Pregunta que encabeza el bloque. */
  titulo: string;
  /** Página donde se pinta: se manda a la analítica. */
  ubicacion: string;
  /** 'linea' (por defecto) o 'destacado'. */
  variante?: 'linea' | 'destacado';
  /** Título visible, solo en la variante destacada. */
  subtitulo?: string;
}

const { titulo, ubicacion, variante = 'linea', subtitulo } = Astro.props;
const destacado = variante === 'destacado';
// Nombre de evento propio por página: click_canal_home, click_canal_pedir_copla…
const sufijo = ubicacion.replace(/[^a-z0-9]+/gi, '_');
const evento = `click_canal_${sufijo}`;
const eventoInfo = `click_canal_info_${sufijo}`;
---

{
  destacado ? (
    <div class='canal-callout canal-callout--destacado'>
      {subtitulo && <h2 class='canal-callout__titulo'>{subtitulo}</h2>}

      <p class='canal-callout__parrafo'>
        {titulo} Únete a nuestros canales de WhatsApp y Telegram.
      </p>

      <p class='canal-callout__info'>
        Más información de los canales en
        <a
          href='/suscribirse'
          data-ga-event={eventoInfo}
          data-ga-params={JSON.stringify({ ubicacion })}>Avisos de coplas nuevas</a
        >.
      </p>

      <div class='canal-callout__botones'>
        <a
          class='boton'
          href={canales.whatsapp}
          target='_blank'
          rel='noopener noreferrer'
          aria-label='Seguir el canal de WhatsApp de Acordes Gaditanos'
          data-ga-event={evento}
          data-ga-params={JSON.stringify({ canal: 'whatsapp', ubicacion })}>
          <Icon name='whatsapp' width={18} height={18} />
          <span>WhatsApp</span>
        </a>

        <a
          class='boton'
          href={canales.telegram}
          target='_blank'
          rel='noopener noreferrer'
          aria-label='Unirse al canal de Telegram de Acordes Gaditanos'
          data-ga-event={evento}
          data-ga-params={JSON.stringify({ canal: 'telegram', ubicacion })}>
          <Icon name='telegram' width={18} height={18} />
          <span>Telegram</span>
        </a>
      </div>
    </div>
  ) : (
    <p class='canal-callout'>
      <span class='canal-callout__pregunta'>{titulo}</span>

      <span class='canal-callout__sigue'>
        Únete a nuestros canales de
        <a
          class='canal-callout__enlace'
          href={canales.whatsapp}
          target='_blank'
          rel='noopener noreferrer'
          aria-label='Seguir el canal de WhatsApp de Acordes Gaditanos'
          data-ga-event={evento}
          data-ga-params={JSON.stringify({ canal: 'whatsapp', ubicacion })}>
          <Icon name='whatsapp' width={15} height={15} />
          <span>WhatsApp</span>
        </a>
        y
        <a
          class='canal-callout__enlace'
          href={canales.telegram}
          target='_blank'
          rel='noopener noreferrer'
          aria-label='Unirse al canal de Telegram de Acordes Gaditanos'
          data-ga-event={evento}
          data-ga-params={JSON.stringify({ canal: 'telegram', ubicacion })}>
          <Icon name='telegram' width={15} height={15} />
          <span>Telegram</span>
        </a>
      </span>
    </p>
  )
}

<script>
  declare const gtag: (...args: unknown[]) => void;

  function pistaCanales() {
    document.querySelectorAll<HTMLElement>('.canal-callout [data-ga-event]').forEach((enlace) => {
      if (enlace.dataset.trackingInit) return;
      enlace.dataset.trackingInit = 'true';

      enlace.addEventListener('click', () => {
        if (typeof gtag !== 'function') return;
        const evento = enlace.getAttribute('data-ga-event');
        const params = JSON.parse(enlace.getAttribute('data-ga-params') || '{}');
        gtag('event', evento, {
          ...params,
          page_location: window.location.href,
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', pistaCanales);
  } else {
    pistaCanales();
  }
</script>

<style>
  /* Variante discreta (home) */
  .canal-callout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 6px;
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    text-align: center;
    color: var(--text-secondary-color);
  }

  .canal-callout__pregunta {
    color: var(--text-color);
  }

  .canal-callout__sigue {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 6px;
  }

  .canal-callout__enlace {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--link-color);
    font-weight: 700;
    text-decoration: none;

    &:focus-visible {
      outline: 2px solid var(--primary-contrast-color);
      outline-offset: 2px;
    }

    & :global(svg) {
      display: block;
      flex: none;
    }
  }

  /* Variante destacada (/pedir-copla) */
  .canal-callout--destacado {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    text-align: left;
  }

  .canal-callout__titulo {
    margin: 0 0 4px;
    color: var(--primary-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    position: relative;
    max-width: fit-content;

    &::after {
      content: '';
      display: block;
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 95%;
      height: 5px;
      background: var(--primary-contrast-color);
    }
  }

  .canal-callout__parrafo {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-color);
    text-wrap: pretty;
  }

  .canal-callout__info {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-secondary-color);

    & a {
      color: var(--link-color);
      font-weight: 700;
      text-decoration: none;

      &:focus-visible {
        outline: 2px solid var(--primary-contrast-color);
        outline-offset: 2px;
      }
    }
  }

  .canal-callout__botones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
  }

  .boton {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 10px 16px;
    background: var(--surface-color);
    color: var(--primary-contrast-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid var(--primary-color);
    border-radius: 0;
    box-shadow: 4px 4px 0 0 var(--primary-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.2s ease,
      color 0.2s ease;

    &:hover {
      background-color: var(--primary-contrast-color);
      color: var(--on-bright-color);
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 0 var(--primary-color);
    }

    &:active {
      transform: translate(0, 0);
      box-shadow: 2px 2px 0 0 var(--primary-color);
    }

    &:focus-visible {
      outline: 3px solid var(--primary-contrast-color);
      outline-offset: 3px;
    }

    & :global(svg) {
      display: block;
      flex: none;
    }
  }

  :global(html[data-theme='dark']) .boton {
    background-color: var(--card-background-color);
    color: var(--text-color);
  }
</style>
