---
// src/components/page/CanalCallout.astro
//
// Invitación discreta a seguir los canales de avisos (WhatsApp y Telegram).
// Se usa en la home y en /pedir-copla con un texto propio para cada sitio.
import { Icon } from 'astro-icon/components';
import canales from '../../data/canales.json';

interface Props {
  /** Frase que encabeza el bloque. */
  titulo: string;
  /** Página donde se pinta: se manda a la analítica. */
  ubicacion: string;
}

const { titulo, ubicacion } = Astro.props;
---

<p class='canal-callout'>
  <span class='canal-callout__pregunta'>{titulo}</span>

  <span class='canal-callout__sigue'>
    Sígueme en
    <a
      class='canal-callout__enlace'
      href={canales.whatsapp}
      target='_blank'
      rel='noopener noreferrer'
      aria-label='Seguir el canal de WhatsApp de Acordes Gaditanos'
      data-ga-event='click_canal'
      data-ga-params={JSON.stringify({ canal: 'whatsapp', ubicacion })}>
      <Icon name='whatsapp' width={15} height={15} />
      WhatsApp
    </a>
    <span class='canal-callout__punto' aria-hidden='true'>·</span>
    <a
      class='canal-callout__enlace'
      href={canales.telegram}
      target='_blank'
      rel='noopener noreferrer'
      aria-label='Unirse al canal de Telegram de Acordes Gaditanos'
      data-ga-event='click_canal'
      data-ga-params={JSON.stringify({ canal: 'telegram', ubicacion })}>
      <Icon name='telegram' width={15} height={15} />
      Telegram
    </a>
  </span>
</p>

<script>
  declare const gtag: (...args: unknown[]) => void;

  function pistaCanales() {
    document.querySelectorAll<HTMLElement>('.canal-callout [data-ga-event]').forEach((enlace) => {
      if (enlace.dataset.trackingInit) return;
      enlace.dataset.trackingInit = 'true';

      enlace.addEventListener('click', () => {
        if (typeof gtag !== 'function') return;
        const evento = enlace.getAttribute('data-ga-event');
        const params = JSON.parse(enlace.getAttribute('data-ga-params') || '{}');
        gtag('event', evento, {
          ...params,
          page_location: window.location.href,
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', pistaCanales);
  } else {
    pistaCanales();
  }

  // El botón flotante de «Pedir una copla» se aparta mientras el bloque está a
  // la vista: en móvil puede tapar el enlace de Telegram.
  const flotante = document.querySelector<HTMLElement>('.fab-container');
  const bloques = document.querySelectorAll<HTMLElement>('.canal-callout');
  if (flotante && bloques.length && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        const visible = entradas.some((entrada) => entrada.isIntersecting);
        flotante.classList.toggle('is-oculto', visible);
      },
      { threshold: 0.35 },
    );

    bloques.forEach((bloque) => observador.observe(bloque));
  }
</script>

<style>
  .canal-callout {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 4px 6px;
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    text-align: center;
    color: var(--text-secondary-color);
  }

  .canal-callout__pregunta {
    color: var(--text-color);
  }

  .canal-callout__sigue {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 4px 6px;
  }

  .canal-callout__enlace {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--link-color);
    font-weight: 700;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 3px;
    }

    &:focus-visible {
      outline: 2px solid var(--primary-contrast-color);
      outline-offset: 2px;
    }

    & :global(svg) {
      position: relative;
      top: 2px;
    }
  }

  .canal-callout__punto {
    color: var(--text-secondary-color);
  }
</style>
