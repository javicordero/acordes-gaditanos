---
// src/components/page/CanalCallout.astro
//
// Invitación a seguir los canales de avisos (WhatsApp y Telegram).
// Se usa en la home y en /pedir-copla con un título propio para cada sitio.
import { Icon } from 'astro-icon/components';
import canales from '../../data/canales.json';

interface Props {
  /** Pregunta que encabeza el bloque. */
  titulo: string;
  /** Página donde se pinta: se manda a la analítica. */
  ubicacion: string;
}

const { titulo, ubicacion } = Astro.props;
const id = `canal-${ubicacion}`;
---

<section class='canal-callout' aria-labelledby={id}>
  <div class='canal-callout__texto'>
    <h2 class='canal-callout__titulo' id={id}>{titulo}</h2>
    <p class='canal-callout__nota'>Solo avisos de coplas nuevas. Puedes salir cuando quieras.</p>
  </div>

  <div class='canal-callout__canales'>
    <a
      class='canal'
      href={canales.whatsapp}
      target='_blank'
      rel='noopener noreferrer'
      aria-label='Seguir el canal de WhatsApp de Acordes Gaditanos'
      data-ga-event='click_canal'
      data-ga-params={JSON.stringify({ canal: 'whatsapp', ubicacion })}>
      <span class='canal__icono' aria-hidden='true'>
        <Icon name='whatsapp' width={22} height={22} />
      </span>
      <span class='canal__nombre'>WhatsApp</span>
      <span class='canal__flecha' aria-hidden='true'>→</span>
    </a>

    <a
      class='canal'
      href={canales.telegram}
      target='_blank'
      rel='noopener noreferrer'
      aria-label='Unirse al canal de Telegram de Acordes Gaditanos'
      data-ga-event='click_canal'
      data-ga-params={JSON.stringify({ canal: 'telegram', ubicacion })}>
      <span class='canal__icono' aria-hidden='true'>
        <Icon name='telegram' width={22} height={22} />
      </span>
      <span class='canal__nombre'>Telegram</span>
      <span class='canal__flecha' aria-hidden='true'>→</span>
    </a>
  </div>

  <p class='canal-callout__mas'>
    <a
      href='/suscribirse'
      data-ga-event='click_canal_info'
      data-ga-params={JSON.stringify({ ubicacion })}>¿Qué es esto?</a
    >
  </p>
</section>

<script>
  declare const gtag: (...args: unknown[]) => void;

  function pistaCanales() {
    document.querySelectorAll<HTMLElement>('.canal-callout [data-ga-event]').forEach((enlace) => {
      if (enlace.dataset.trackingInit) return;
      enlace.dataset.trackingInit = 'true';

      enlace.addEventListener('click', () => {
        if (typeof gtag !== 'function') return;
        const evento = enlace.getAttribute('data-ga-event');
        const params = JSON.parse(enlace.getAttribute('data-ga-params') || '{}');
        gtag('event', evento, {
          ...params,
          page_location: window.location.href,
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', pistaCanales);
  } else {
    pistaCanales();
  }

  // El botón flotante de «Pedir una copla» se aparta mientras el bloque está a
  // la vista: pide el mismo clic y, en móvil, lo tapaba.
  const flotante = document.querySelector<HTMLElement>('.fab-container');
  const bloques = document.querySelectorAll<HTMLElement>('.canal-callout');
  if (flotante && bloques.length && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        const visible = entradas.some((entrada) => entrada.isIntersecting);
        flotante.classList.toggle('is-oculto', visible);
      },
      { threshold: 0.35 },
    );

    bloques.forEach((bloque) => observador.observe(bloque));
  }
</script>

<style>
  .canal-callout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }

  .canal-callout__texto {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .canal-callout__titulo {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.35;
    text-wrap: balance;
  }

  .canal-callout__nota {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-secondary-color);
  }

  .canal-callout__canales {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    width: 100%;
  }

  /* Cada canal es una tarjeta entera pulsable, no un botón suelto. */
  .canal {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1 1 200px;
    min-width: 0;
    padding: 10px 14px;
    background: var(--surface-color);
    color: var(--primary-contrast-color);
    border: 2px solid var(--primary-color);
    border-radius: 0;
    box-shadow: 4px 4px 0 0 var(--primary-color);
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.2s ease;

    &:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 0 var(--primary-color);
    }

    &:active {
      transform: translate(0, 0);
      box-shadow: 2px 2px 0 0 var(--primary-color);
    }

    &:focus-visible {
      outline: 3px solid var(--primary-contrast-color);
      outline-offset: 3px;
    }

    &:hover .canal__flecha {
      transform: translateX(3px);
    }
  }

  .canal__icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: none;
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  .canal__nombre {
    flex: 1;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .canal__flecha {
    flex: none;
    font-size: 1rem;
    line-height: 1;
    transition: transform 0.15s ease;
  }

  .canal-callout__mas {
    margin: 0;
    font-size: 0.75rem;

    & a {
      color: var(--text-secondary-color);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;

      &:hover {
        color: var(--link-color);
      }
    }
  }

  :global(html[data-theme='dark']) .canal {
    background-color: var(--card-background-color);
  }

  @media (max-width: 480px) {
    .canal {
      flex: 1 1 100%;
    }
  }
</style>
