---
import DiagramaAcorde from './DiagramaAcorde.astro';
import { indicePostura, type EntradaGlosario } from '../../lib/acordes';

interface Props {
  acordes: Array<{ etiqueta: string; entrada: EntradaGlosario }>;
  posturas?: Record<string, string>;
}

const { acordes, posturas = {} } = Astro.props;
const nombres = acordes.map(({ etiqueta }) => etiqueta);
const hayPosturas = nombres.some((nombre) => Boolean(posturas[nombre]));
---

{
  <div class='acordes-pieza'>
    <div class='acordes-pieza__resumen'>
      {acordes.length > 0 && (
        <p class='acordes-pieza__linea'>
          <span class='acordes-pieza__titulo'>Acordes usados:</span>{' '}
          <span class='acordes-pieza__nombres'>
            {nombres.map((nombre, i) => (
              <>
                <span class='acordes-pieza__item'>
                  <button
                    type='button'
                    class='acordes-pieza__nombre'
                    data-acorde={nombre}
                    data-postura={posturas[nombre]}
                    aria-haspopup='dialog'
                    aria-expanded='false'
                    aria-label={`Ver cómo se toca ${nombre}${posturas[nombre] ? ' (postura de la pieza)' : ''}`}
                  >
                    {nombre}
                  </button>
                  {i < nombres.length - 1 ? ',' : ''}
                </span>{' '}
              </>
            ))}
          </span>
        </p>
      )}

      {hayPosturas && (
        <p class='acordes-pieza__leyenda'>
          <span class='acordes-pieza__asterisco' aria-hidden='true'>*</span>{' '}
          Postura concreta para esta pieza
        </p>
      )}

      <p class='acordes-pieza__ayuda'>
        <svg
          class='acordes-pieza__ayuda-icono'
          xmlns='http://www.w3.org/2000/svg'
          width='14'
          height='14'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
          focusable='false'
        >
          <path d='m9 9 5 12 1.8-5.2L21 14Z'></path>
          <path d='M7.2 2.2 8 5.1'></path>
          <path d='m5.1 8-2.9-.8'></path>
          <path d='M14 4.1 12 6'></path>
          <path d='m6 12-1.9 2'></path>
        </svg>
        <span>Pincha en cualquier acorde de la letra para ver su diagrama.</span>
      </p>

      <div class='acordes-pieza__acciones'>
        <div class='transporte'>
          <span class='transporte__titulo' id='transporte-titulo'>Transportar acordes</span>
          <div class='transpose-controls' role='group' aria-labelledby='transporte-titulo'>
            <button
              class='transpose-btn transpose-down'
              aria-label='Bajar tono'
              title='Bajar tono'
              type='button'>−</button>
            <span
              class='transpose-display'
              data-transpose-display
              role='status'
              aria-live='polite'>0</span>
            <button
              class='transpose-btn transpose-up'
              aria-label='Subir tono'
              title='Subir tono'
              type='button'>+</button>
          </div>
        </div>

        {acordes.length > 0 && (
          <button
            type='button'
            class='acordes-pieza__accion'
            data-ver-mas
            aria-expanded='false'
            aria-controls='acordes-pieza-cuerpo'
          >
            Ver diagramas
          </button>
        )}
      </div>
    </div>

    {acordes.length > 0 && (
      <div class='acordes-pieza__caja'>
        <div class='acordes-pieza__cuerpo' id='acordes-pieza-cuerpo' inert aria-hidden='true'>
          <div class='acordes-pieza__interior'>
            <ul class='acordes-pieza__grid'>
              {acordes.map(({ etiqueta, entrada }) => {
                const postura = posturas[etiqueta];
                const indice = postura ? (indicePostura(entrada, postura) ?? 0) : 0;
                return (
                  <li class='acorde-mini'>
                    <button
                      type='button'
                      class='acorde-mini__btn'
                      data-acorde={etiqueta}
                      data-postura={postura}
                      aria-haspopup='dialog'
                      aria-expanded='false'
                      aria-label={`Ver cómo se toca ${etiqueta}${postura ? ' (postura de la pieza)' : ''}`}
                    >
                      <span class='acorde-mini__nombre'>{etiqueta}</span>
                      <DiagramaAcorde
                        nombre={etiqueta}
                        posicion={entrada.posiciones[indice]!}
                        total={entrada.posiciones.length}
                        ancho={104}
                        alto={132}
                      />
                    </button>
                  </li>
                );
              })}
            </ul>

            <a
              class='acordes-pieza__enlace'
              href='/glosario'
              data-ga-event='click_glosario_acordes_usados'
            >
              Ver glosario completo
            </a>
          </div>
        </div>
      </div>
    )}
  </div>
}

<style>
  .acordes-pieza {
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    border: 2px solid var(--primary-color);
    background: var(--card-background-color);
    font-family: 'Roboto Mono', monospace;
  }

  .acordes-pieza__resumen {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    color: var(--text-color);
  }

  .acordes-pieza__linea {
    margin: 0;
    line-height: 1.5;
  }

  .acordes-pieza__acciones {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .transporte {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .transporte__titulo {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--primary-color);
  }

  .transpose-controls {
    display: inline-flex;
    align-items: stretch;
    border: 2px solid var(--primary-color);
    background: var(--card-background-color);
    box-shadow: 2px 2px 0 0 var(--primary-color);
  }

  .transpose-btn {
    width: 28px;
    min-height: 26px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--primary-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .transpose-btn:hover {
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  .transpose-btn:focus-visible {
    outline: 3px solid var(--primary-contrast-color);
    outline-offset: 2px;
  }

  .transpose-display {
    min-width: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 2px solid var(--primary-color);
    border-right: 2px solid var(--primary-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    color: var(--acorde-color);
  }

  .acordes-pieza__titulo {
    display: inline;
    margin-right: 2px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--primary-color);
  }

  .acordes-pieza__nombres {
    display: inline;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--acorde-color);
    word-spacing: -0.2em;
  }

  .acordes-pieza__item {
    display: inline;
    white-space: nowrap;
  }

  .acordes-pieza__nombre {
    display: inline;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    font: inherit;
    color: var(--acorde-color);
    cursor: pointer;
    text-decoration: none;
  }

  .acordes-pieza__nombre:focus-visible {
    outline: 2px solid var(--primary-contrast-color);
    outline-offset: 1px;
  }

  .acordes-pieza__nombre[data-postura] {
    position: relative;
  }

  .acordes-pieza__nombre[data-postura]::after {
    content: '*';
    position: absolute;
    top: 0;
    right: -0.7em;
    font-size: 1em;
    line-height: 1;
    pointer-events: none;
  }

  .acorde-mini__btn[data-postura] .acorde-mini__nombre {
    position: relative;
  }

  .acorde-mini__btn[data-postura] .acorde-mini__nombre::after {
    content: '*';
    position: absolute;
    top: 0;
    right: -0.7em;
    font-size: 1em;
    line-height: 1;
    pointer-events: none;
  }

  .acordes-pieza__leyenda {
    margin: 2px 0 0;
    font-size: 0.68rem;
    color: var(--text-secondary-color);
  }

  .acordes-pieza__asterisco {
    color: var(--acorde-color);
    font-weight: 800;
  }

  /* Nota de ayuda: sin caja, solo una línea discreta sobre el transportador. */
  .acordes-pieza__ayuda {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 6px 0 0;
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-secondary-color);
  }

  .acordes-pieza__ayuda-icono {
    flex: none;
    align-self: center;
    color: var(--acorde-color);
  }

  .acordes-pieza__accion {
    align-self: center;
    display: block;
    flex: none;
    margin-left: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--link-color);
    text-align: right;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .acordes-pieza__accion:hover {
    color: var(--link-hover-color);
  }

  .acordes-pieza__accion:focus-visible {
    outline: 3px solid var(--primary-contrast-color);
    outline-offset: 2px;
  }

  .acordes-pieza--abierto .acordes-pieza__resumen {
    border-bottom: 2px solid var(--primary-color);
  }

  .acordes-pieza__caja {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.22s ease;
  }

  .acordes-pieza--abierto .acordes-pieza__caja {
    grid-template-rows: 1fr;
  }

  .acordes-pieza__cuerpo {
    min-height: 0;
    overflow: hidden;
  }

  .acordes-pieza__interior {
    padding: 12px 14px 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .acordes-pieza__caja {
      transition: none;
    }
  }

  .acordes-pieza__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 8px;
  }

  .acorde-mini {
    margin: 0;
  }

  .acorde-mini__btn {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 4px 6px;
    background: var(--card-background-color);
    border: 2px solid var(--primary-color);
    border-radius: 0;
    color: var(--primary-color);
    cursor: pointer;
    font-family: inherit;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .acorde-mini__btn:hover,
  .acorde-mini__btn:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 0 var(--primary-color);
  }

  .acorde-mini__btn:focus-visible {
    outline: 3px solid var(--primary-contrast-color);
    outline-offset: 2px;
  }

  .acorde-mini__nombre {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: var(--acorde-color);
  }

  .acordes-pieza__enlace {
    display: inline-block;
    margin-top: 12px;
    color: var(--link-color);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .acordes-pieza__grid {
      grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
      gap: 6px;
    }

    .acordes-pieza__acciones,
    .transporte {
      gap: 6px;
    }

    .transporte__titulo {
      font-size: 0.66rem;
      letter-spacing: 0.5px;
    }

    .transpose-btn {
      width: 26px;
    }

    .transpose-display {
      min-width: 26px;
    }

    .acordes-pieza__accion {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  function analitica(evento: string, params: Record<string, unknown> = {}) {
    const w = window as any;
    if (typeof w.gtag === 'function') {
      w.gtag('event', evento, {
        ...params,
        event_category: 'acordes',
        event_label: window.location.pathname,
      });
    } else {
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ event: evento, ...params });
    }
  }

  document.addEventListener('click', (e) => {
    const boton = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-ver-mas]');
    if (!boton) return;

    const bloque = boton.closest('.acordes-pieza');
    const cuerpo = bloque?.querySelector<HTMLElement>('.acordes-pieza__cuerpo');
    if (!bloque || !cuerpo) return;

    const abierto = boton.getAttribute('aria-expanded') === 'true';
    const nuevo = !abierto;
    boton.setAttribute('aria-expanded', String(nuevo));
    boton.textContent = nuevo ? 'Ver menos' : 'Ver diagramas';
    bloque.classList.toggle('acordes-pieza--abierto', nuevo);

    if (nuevo) {
      cuerpo.inert = false;
      cuerpo.setAttribute('aria-hidden', 'false');
    } else {
      if (cuerpo.contains(document.activeElement)) boton.focus();
      cuerpo.inert = true;
      cuerpo.setAttribute('aria-hidden', 'true');
    }

    analitica(nuevo ? 'click_acordes_usados_ver_mas' : 'click_acordes_usados_ver_menos', {
      total: bloque.querySelectorAll('.acorde-mini').length,
    });
  });

  document.querySelectorAll<HTMLElement>('.acordes-pieza [data-ga-event]').forEach((enlace) => {
    enlace.addEventListener('click', () => {
      const evento = enlace.getAttribute('data-ga-event');
      if (evento) analitica(evento);
    });
  });
</script>

<script>
  import { buscarEnIndice, crearIndice, indicePostura, type Glosario } from '../../lib/acordes';
  import { svgDiagrama } from '../../lib/diagrama';
  import { transportarEtiqueta } from '../../lib/transporte';

  const panel = document.querySelector('.acordes-pieza');
  const datosEl = document.getElementById('glosario-datos');

  if (panel instanceof HTMLElement && datosEl) {
    let indice: ReturnType<typeof crearIndice> | null = null;
    let originales: Map<HTMLElement, string> | null = null;

    function preparar() {
      if (indice && originales) return;

      let glosario: Glosario = {};
      try {
        glosario = JSON.parse(datosEl!.textContent || '{}') as Glosario;
      } catch {
        glosario = {};
      }

      indice = crearIndice(glosario);
      originales = new Map();

      panel!.querySelectorAll<HTMLElement>('[data-acorde]').forEach((el) => {
        originales!.set(el, el.dataset.acorde || '');
      });
    }

    /** Marca el botón como interactivo solo si el acorde tiene diagrama. */
    function aplicarInteractividad(el: HTMLElement, etiqueta: string): boolean {
      if (!entradaDe(etiqueta)) {
        el.removeAttribute('data-acorde');
        el.removeAttribute('aria-haspopup');
        el.removeAttribute('aria-expanded');
        el.setAttribute('aria-label', etiqueta);
        return false;
      }

      el.dataset.acorde = etiqueta;
      el.setAttribute('aria-haspopup', 'dialog');
      el.setAttribute('aria-expanded', 'false');
      el.setAttribute(
        'aria-label',
        `Ver cómo se toca ${etiqueta}${el.dataset.postura ? ' (postura de la pieza)' : ''}`,
      );
      return true;
    }

    function entradaDe(etiqueta: string) {
      return indice ? buscarEnIndice(indice, etiqueta) : null;
    }

    function pintarDiagrama(boton: HTMLElement, etiqueta: string) {
      const contenedor = boton.querySelector<HTMLElement>('.diagrama-acorde');
      const entrada = entradaDe(etiqueta);
      if (!contenedor) return;

      if (!entrada) {
        contenedor.innerHTML = '';
        contenedor.style.display = 'none';
        return;
      }

      const postura = boton.dataset.postura;
      const indicePos = postura ? (indicePostura(entrada, postura) ?? 0) : 0;

      contenedor.style.display = '';
      contenedor.innerHTML = svgDiagrama({
        nombre: etiqueta,
        posicion: entrada.posiciones[indicePos]!,
        indice: indicePos,
        total: entrada.posiciones.length,
        ancho: 104,
        alto: 132,
      });
    }

    function aplicar(semitonos: number) {
      preparar();

      originales!.forEach((original, el) => {
        const etiqueta = semitonos ? transportarEtiqueta(original, semitonos) : original;

        if (el.classList.contains('acorde-mini__btn')) {
          const nombre = el.querySelector<HTMLElement>('.acorde-mini__nombre');
          if (nombre) nombre.textContent = etiqueta;
          pintarDiagrama(el, etiqueta);
        } else {
          el.textContent = etiqueta;
        }

        aplicarInteractividad(el, etiqueta);
      });
    }

    document.addEventListener('ag:transpose', (evento) => {
      const detalle = (evento as CustomEvent<{ semitonos?: number }>).detail;
      aplicar(detalle?.semitonos ?? 0);
    });
  }
</script>
