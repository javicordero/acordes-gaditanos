---
// Props:
// - year: string | number
// - agrupacion: string (opcional)
// - agrupacionSlug: string (opcional)
// - pieza: string (opcional)
// - autor: string (opcional)
// - autorSlug: string (opcional)
// - tipoAutor: 'musica' | 'letra' (opcional)
// - simple: boolean (solo año)
// - current: string (página actual, sin enlace)
const {
  year,
  agrupacion,
  agrupacionSlug,
  pieza,
  autor,
  autorSlug,
  tipoAutor,
  simple = false,
  current,
} = Astro.props;

const site = Astro.site || new URL('https://acordesgaditanos.com');
const breadcrumbItems = [];

breadcrumbItems.push({
  '@type': 'ListItem',
  position: 1,
  name: 'Inicio',
  item: new URL('/', site).toString(),
});

if (year) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: `Carnaval ${year}`,
    item: new URL(`/carnaval/${year}`, site).toString(),
  });
}

if (agrupacion && agrupacionSlug) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: year ? 3 : 2,
    name: agrupacion,
    item: new URL(`/agrupacion/${agrupacionSlug}`, site).toString(),
  });
}

if (pieza) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: agrupacion ? (year ? 4 : 3) : (year ? 3 : 2),
    name: pieza,
  });
}

if (autor && autorSlug && tipoAutor && !year && !agrupacion && !pieza) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: `${autor} (${tipoAutor === 'musica' ? 'Música' : 'Letra'})`,
    item: new URL(`/autor/${tipoAutor}/${autorSlug}`, site).toString(),
  });
}

if (current) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: breadcrumbItems.length + 1,
    name: current,
  });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};
---

<script type='application/ld+json' set:html={JSON.stringify(breadcrumbSchema)} />

<div class='breadcrumb-container container-layout'>
  <nav aria-label='Navegación contextual' class='breadcrumb'>
    <a href='/'>Inicio</a>
    {
      year && (
        <>
          <span class='separator'>›</span>
          <a href={`/carnaval/${year}`}>Carnaval {year}</a>
        </>
      )
    }
    {
      agrupacion && agrupacionSlug && (
        <>
          <span class='separator'>›</span>
          <a href={`/agrupacion/${agrupacionSlug}`}>{agrupacion}</a>
        </>
      )
    }
    {
      pieza && (
        <>
          <span class='separator'>›</span>
          <span class='breadcrumb-piece'>{pieza}</span>
        </>
      )
    }
    {
      autor && autorSlug && tipoAutor && !year && !agrupacion && !pieza && (
        <>
          <span class='separator'>›</span>
          <span class='breadcrumb-piece'>{autor}</span>
        </>
      )
    }
    {
      current && (
        <>
          <span class='separator'>›</span>
          <span class='breadcrumb-piece'>{current}</span>
        </>
      )
    }
  </nav>
</div>

<style>
  .breadcrumb-container {
    position: relative;
    top: calc(var(--nav-height) + 6px);
    height: 0;
    margin-top: 0;
    padding: 0;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: nowrap;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    color: var(--text-secondary-color);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    & a {
      color: var(--primary-color);
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 2px;
      transition: color 0.2s ease;
      max-width: 220px;
      text-wrap: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    & .separator {
      color: var(--primary-contrast-color);
      font-weight: 700;
      user-select: none;
    }
    & .breadcrumb-piece {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      display: inline-block;
      color: var(--text-secondary-color);
    }
  }
  @media (max-width: 640px) {
    .breadcrumb-container {
      top: calc(var(--nav-height) + 6px);
      /* height: 16px; */
    }
    .breadcrumb {
      font-size: 0.64rem;
      gap: 4px;
      & a {
        max-width: 540px;
      }

      & .breadcrumb-piece {
        max-width: 145px;
      }
    }
  }
</style>
