---
import Card from '../ui/Card.astro';
const { year, acordes, subtitle, headingAs = 'h2', headingTransition = null } = Astro.props;

// Generar ID estable para accesibilidad
const headingId = `year-${year}`;
const Heading = headingAs;
---

<article
  class={`year-group${subtitle ? ' year-group--with-subtitle' : ''}`}
  aria-labelledby={headingId}>
  <div class='container-layout inner-content'>
    <header>
      <Heading
        id={headingId}
        class='is-title-minus'
        style={headingTransition ? `view-transition-name: ${headingTransition}` : undefined}>{year}</Heading>
      {subtitle && <h3>{subtitle}</h3>}
    </header>

    <slot name='notice' />

    <slot />

    <div class='acordes-grid' role='region' aria-labelledby={headingId}>
      {
        acordes.map((acorde, idx) => {
          const { slug, data } = acorde;
          const { pieza, agrupacion, musica, letra, letraTitulo, img, year: y, musicaList, letraList, musicaSlugs, letraSlugs, musicaSlug, letraSlug } = data;
          return (
            <Card
              pieza={pieza}
              agrupacion={agrupacion}
              musica={musica}
              letra={letra}
              letraTitulo={letraTitulo}
              img={img}
              year={y}
              slug={slug}
              musicaList={musicaList}
              letraList={letraList}
              musicaSlugs={musicaSlugs}
              letraSlugs={letraSlugs}
              musicaSlug={musicaSlug}
              letraSlug={letraSlug}
              transitionKey={`${year}-${idx}`}
            />
          );
        })
      }
    </div>
  </div>
</article>

<style>
  .year-group {
    position: relative;
    border-radius: 0;
  }

  .inner-content {
    display: flex;
    flex-direction: column;
    gap: var(--card-padding);
  }

  .year-group--with-subtitle .inner-content {
    gap: 8px;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 10px;

    & :is(h1, h2) {
      position: relative;
      color: var(--primary-color);
      font-size: 1.6rem;
      font-family: 'Roboto Mono', monospace;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      max-width: fit-content;
      margin: 0;

      &::after {
        content: '';
        display: block;
        position: absolute;
        left: 0;
        bottom: -6px;
        width: 95%;
        height: 6px;
        background: var(--primary-contrast-color);
      }
    }

    & h3 {
      font-size: 1.355rem;
      font-weight: 600;
      color: var(--secondary-color);
      letter-spacing: 0.3px;
    }
  }

  .acordes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--card-padding);
  }

  /* Solo mientras se miden los títulos: content-visibility deja sin maquetar
     las cards que están fuera del viewport y no se podrían medir. */
  .acordes-grid.midiendo-titulos :global(.card) {
    content-visibility: visible;
  }

  /* Media queries */
  @media (max-width: 1024px) {
    .acordes-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .inner-content {
      gap: var(--card-padding-sm);
    }
    .year-group--with-subtitle .inner-content {
      gap: 4px;
    }

    .acordes-grid {
      gap: 2.5vw;
      grid-template-columns: repeat(2, 1fr);
      align-items: stretch;
    }

    header {
      gap: 6px;
      & :is(h1, h2) {
        font-size: 1.25rem;
      }
      & :is(h1, h2)::after {
        height: 4px;
        bottom: -2px;
      }

      & h3 {
        font-size: 1.15rem;
        letter-spacing: 0.2px;
      }
    }
  }
</style>

<script>
  const CLASE_MIDIENDO = 'midiendo-titulos';

  const gridsObservados = new WeakSet<HTMLElement>();
  const anchos = new WeakMap<HTMLElement, number>();

  function ajustarGrid(grid: HTMLElement) {
    const tarjetas = Array.from(grid.children).filter(
      (hijo): hijo is HTMLElement =>
        hijo instanceof HTMLElement &&
        hijo.classList.contains('card') &&
        // Solo cards de acordes (el grid de autores usa la misma clase .acordes-grid).
        hijo.querySelector('a[href^="/acordes/"]') !== null,
    );
    if (tarjetas.length === 0) return;

    // Grid oculto (p. ej. resultados de búsqueda aún sin mostrar): no se puede medir.
    if (grid.getBoundingClientRect().width === 0) return;

    grid.classList.add(CLASE_MIDIENDO);

    const titulos = tarjetas.map((tarjeta) => tarjeta.querySelector<HTMLElement>('.card-title'));
    const bloquesAutores = tarjetas.map((tarjeta) => tarjeta.querySelector<HTMLElement>('.card-authors'));

    titulos.forEach((titulo) => {
      if (titulo) titulo.style.minHeight = '';
    });
    bloquesAutores.forEach((bloque) => {
      if (bloque) bloque.style.minHeight = '';
    });

    // Agrupar las cards por fila: las que comparten offsetTop van en la misma fila.
    const filas = new Map<number, number[]>();
    tarjetas.forEach((tarjeta, indice) => {
      const fila = Math.round(tarjeta.offsetTop);
      const indices = filas.get(fila);
      if (indices) {
        indices.push(indice);
      } else {
        filas.set(fila, [indice]);
      }
    });

    filas.forEach((indices) => {
      const alturasTitulos = indices
        .map((indice) => titulos[indice]?.getBoundingClientRect().height ?? 0)
        .filter((altura) => altura > 0);

      // Solo se reserva altura si en la fila hay títulos de distinto alto.
      const titulosDesiguales =
        alturasTitulos.length > 1 &&
        Math.max(...alturasTitulos) - Math.min(...alturasTitulos) > 1;

      if (titulosDesiguales) {
        const maxAlturaTitulo = Math.max(...alturasTitulos);
        indices.forEach((indice) => {
          const titulo = titulos[indice];
          if (titulo) titulo.style.minHeight = `${Math.ceil(maxAlturaTitulo)}px`;
        });
      }

      // Igual con los autores: solo si en la fila hay bloques de distinto alto,
      // todos reservan la altura del más alto para que la raya quede alineada.
      const alturasAutores = indices
        .map((indice) => bloquesAutores[indice]?.getBoundingClientRect().height ?? 0)
        .filter((altura) => altura > 0);

      if (alturasAutores.length > 1) {
        const maxAlturaAutores = Math.max(...alturasAutores);
        const minAlturaAutores = Math.min(...alturasAutores);

        if (maxAlturaAutores - minAlturaAutores > 1) {
          indices.forEach((indice) => {
            const bloque = bloquesAutores[indice];
            if (bloque) bloque.style.minHeight = `${Math.ceil(maxAlturaAutores)}px`;
          });
        }
      }
    });

    grid.classList.remove(CLASE_MIDIENDO);
  }

  const observadorResize = new ResizeObserver((entradas) => {
    entradas.forEach((entrada) => {
      const grid = entrada.target as HTMLElement;
      const ancho = Math.round(entrada.contentRect.width);
      if (ancho === 0 || ancho === anchos.get(grid)) return;

      anchos.set(grid, ancho);
      ajustarGrid(grid);
    });
  });

  function observarGrid(grid: HTMLElement) {
    if (gridsObservados.has(grid)) return;

    gridsObservados.add(grid);
    anchos.set(grid, Math.round(grid.getBoundingClientRect().width));
    ajustarGrid(grid);
    observadorResize.observe(grid);
  }

  function observarTodosLosGrids() {
    document.querySelectorAll<HTMLElement>('.acordes-grid').forEach(observarGrid);
  }

  function ajustarTodosLosGrids() {
    document.querySelectorAll<HTMLElement>('.acordes-grid').forEach(ajustarGrid);
  }

  observarTodosLosGrids();

  // La búsqueda sustituye el grid por uno clonado: hay que observarlo también.
  const observadorMutaciones = new MutationObserver((mutaciones) => {
    const hayGridNuevo = mutaciones.some((mutacion) =>
      Array.from(mutacion.addedNodes).some(
        (nodo) =>
          nodo instanceof Element &&
          (nodo.matches('.acordes-grid') || nodo.querySelector('.acordes-grid') !== null),
      ),
    );

    if (hayGridNuevo) {
      requestAnimationFrame(observarTodosLosGrids);
    }
  });

  observadorMutaciones.observe(document.body, { childList: true, subtree: true });

  // Al terminar de cargar la tipografía puede cambiar el corte de línea de los títulos.
  if (document.fonts?.ready) {
    document.fonts.ready.then(ajustarTodosLosGrids);
  }
</script>
