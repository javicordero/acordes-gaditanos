---
import Card from '../ui/Card.astro';
const { year, acordes, subtitle, headingAs = 'h2' } = Astro.props;

// Generar ID estable para accesibilidad
const headingId = `year-${year}`;
const Heading = headingAs;
---

<article
  class={`year-group${subtitle ? ' year-group--with-subtitle' : ''}`}
  aria-labelledby={headingId}>
  <div class='container-layout inner-content'>
    <header>
      <Heading id={headingId} class='is-title-minus'>{year}</Heading>
      {subtitle && <h3>{subtitle}</h3>}
    </header>

    <slot name='notice' />

    <slot />

    <div class='acordes-grid' role='region' aria-labelledby={headingId}>
      {
        acordes.map((acorde, idx) => {
          const { slug, data } = acorde;
          const { pieza, agrupacion, musica, letra, img, year: y, musicaList, letraList, musicaSlugs, letraSlugs, musicaSlug, letraSlug } = data;
          return (
            <Card
              pieza={pieza}
              agrupacion={agrupacion}
              musica={musica}
              letra={letra}
              img={img}
              year={y}
              slug={slug}
              musicaList={musicaList}
              letraList={letraList}
              musicaSlugs={musicaSlugs}
              letraSlugs={letraSlugs}
              musicaSlug={musicaSlug}
              letraSlug={letraSlug}
              transitionKey={`${year}-${idx}`}
            />
          );
        })
      }
    </div>
  </div>
</article>

<style>
  .year-group {
    position: relative;
    border-radius: 0;
  }

  .inner-content {
    display: flex;
    flex-direction: column;
    gap: var(--card-padding);
  }

  .year-group--with-subtitle .inner-content {
    gap: 8px;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 10px;

    & :is(h1, h2) {
      position: relative;
      color: var(--primary-color);
      font-size: 1.6rem;
      font-family: 'Roboto Mono', monospace;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      max-width: fit-content;
      margin: 0;

      &::after {
        content: '';
        display: block;
        position: absolute;
        left: 0;
        bottom: -6px;
        width: 95%;
        height: 6px;
        background: var(--primary-contrast-color);
      }
    }

    & h3 {
      font-size: 1.355rem;
      font-weight: 600;
      color: var(--secondary-color);
      letter-spacing: 0.3px;
    }
  }

  .acordes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--card-padding);
  }

  /* Media queries */
  @media (max-width: 1024px) {
    .acordes-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .inner-content {
      gap: var(--card-padding-sm);
    }
    .year-group--with-subtitle .inner-content {
      gap: 4px;
    }

    .acordes-grid {
      gap: 2.5vw;
      grid-template-columns: repeat(2, 1fr);
      align-items: stretch;
    }

    header {
      gap: 6px;
      & :is(h1, h2) {
        font-size: 1.25rem;
      }
      & :is(h1, h2)::after {
        height: 4px;
        bottom: -2px;
      }

      & h3 {
        font-size: 1.15rem;
        letter-spacing: 0.2px;
      }
    }
  }
</style>
