---
import { Icon } from 'astro-icon/components';
import Image from 'astro/components/Image.astro';
import DonationIndicator from '../DonationIndicator.astro';
---

<section class='banner-coac-2026'>
  <div class='container-layout'>
    <div class='text'>
      <header>
        <h2>Vuestras coplas</h2>
        <div class='subtitle'>
          <p>
            Desde hoy hasta el COAC 2027 aprovechamos para recoger las coplas que echa de menos la comunidad, vuestras coplas.</p>
          <p>
             Puedes hacer una petición y votar las de otros en esta  <a href='/pedir-copla'>página</a>. Las más votadas (y más me gusten) se irán subiendo.
          </p>
        </div>
      </header>

      <div class='apoyar'>
        <DonationIndicator variant='timeline' messageC='Ayuda a que siga subiendo más coplas' listStyle='pills' />
      </div>
    </div>
  </div>
</section>
<style>
  section.banner-coac-2026 {
    margin-top: 46px;
    --banner-overlay-opacity: 0.78;
    position: relative;
    display: flex;
    color: #fff;
    background: url('https://static.grupojoly.com/clip/e68a84a7-37c4-4bbe-a35c-f859862ca005_source-aspect-ratio_1600w_0.jpg')
      center/cover;
    border-bottom: 4px solid var(--primary-contrast-color);
    height: calc(var(--vh, 1vh) * 100 - 45px);
    height: calc(100svh - 45px);

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      backdrop-filter: brightness(0.2);
      background: transparent;
    }

    & .text {
      position: relative;
      z-index: 2;
      padding: 0;
      max-width: 620px;
      height: calc(var(--vh, 1vh) * 100 - 45px);
      height: calc(100svh - 45px);
      padding: 180px 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      font-family: 'Roboto Mono', monospace;

      & header {
        padding: 0;
      }

      & h2 {
        margin: 0 0 24px;
        font-size: 3.2rem;
        font-weight: 800;
        letter-spacing: 1px;
        line-height: 1;
        text-transform: uppercase;
        max-width: fit-content;

        &::after {
          content: '';
          display: block;
          width: 95%;
          height: 6px;
          margin-top: 10px;
          background-color: var(--primary-contrast-color);
        }
      }

      & p {
        margin: 0 0 12px;
        font-size: 1.05rem;
        line-height: 1.45;
      }

      & .apoyar {
        margin-top: 56px;
      }

      & a {
        color: var(--primary-contrast-color);
        text-decoration: none;
      }
    }

    @media (max-width: 640px) {
      & {
        flex-direction: column;
        justify-content: space-between;
      }

      &::before {
        backdrop-filter: brightness(0.15);
      }

      & .text {
        padding: 40px 0 120px;

        & header {
          padding: 0;
        }

        & h2 {
          font-size: 2rem;
          margin-bottom: 16px;
        }

        & p {
          font-size: 0.95rem;
        }

        & .apoyar {
          margin-top: 24px;
        }
      }
    }
  }


</style>

<script is:inline>
  // Set up CSS variable --vh to work around mobile viewport changes
  function setVh() {
    try {
      const vh = window.innerHeight * 0.01;
      document.documentElement.style.setProperty('--vh', `${vh}px`);
    } catch (e) {
      // fail silently
    }
  }

  setVh();
  window.addEventListener('resize', setVh, { passive: true });
  window.addEventListener('orientationchange', setVh);
  if (window.visualViewport && window.visualViewport.addEventListener) {
    window.visualViewport.addEventListener('resize', setVh);
  }
</script>
