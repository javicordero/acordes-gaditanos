---
import AutorCard from '../ui/AutorCard.astro';
const { autores, heading = 'Autores destacados' } = Astro.props;
const headingId = `autores-group`;
---

<article class='year-group' aria-labelledby={headingId}>
  <div class='container-layout inner-content'>
    <header>
      <h2 id={headingId} class='is-title-minus'>{heading}</h2>
    </header>

    <div class='acordes-grid' role='region' aria-labelledby={headingId}>
      {
        [...autores]
          .sort((a, b) => (a.data.order ?? 9999) - (b.data.order ?? 9999))
          .map((autor) => <AutorCard autor={autor.data} />)
      }
    </div>
  </div>
</article>

<style>
  .year-group {
  }

  .inner-content {
    display: flex;
    flex-direction: column;
    gap: var(--card-padding);
  }

  header {
    & h2 {
      position: relative;
      color: var(--on-surface-color);
      font-size: 1.6rem;
      font-family: 'Roboto Mono', monospace;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      max-width: fit-content;
      margin: 0;

      &::after {
        content: '';
        display: block;
        position: absolute;
        left: 0;
        bottom: -6px;
        width: 95%;
        height: 6px;
        background: var(--primary-contrast-color);
      }
    }
  }

  .acordes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--card-padding);
  }

  @media (max-width: 1024px) {
    .acordes-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .inner-content {
      gap: var(--card-padding-sm);
    }

    .acordes-grid {
      gap: 2.5vw;
      grid-template-columns: repeat(2, 1fr);
      align-items: stretch;
    }

    header {
      & h2 {
        font-size: 1.25rem;
      }
      & h2::after {
        height: 4px;
        bottom: -2px;
      }
    }
  }
</style>
