---
import AutorCard from '../ui/AutorCard.astro';
const {
  autores,
  creditos = {},
  heading = 'Autores destacados',
  headingAs = 'h2',
  ubicacion = 'index_autores',
} = Astro.props;

const headingSlug = heading
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
const headingId = `autores-${headingSlug}`;
const Heading = headingAs;
---

<article class='year-group' aria-labelledby={headingId}>
  <div class='container-layout inner-content'>
    <header>
      <Heading id={headingId} class='is-title-minus'>{heading}</Heading>
    </header>

    <div class='acordes-grid' role='region' aria-labelledby={headingId}>
      {
        [...autores]
          .sort((a, b) => (a.data.order ?? 9999) - (b.data.order ?? 9999))
          .map((autor) => {
            const creditosAutor = creditos[autor.data.autorSlug] ?? { musica: 0, letra: 0 };
            return (
              <AutorCard
                autor={autor.data}
                musicaCount={creditosAutor.musica}
                letraCount={creditosAutor.letra}
                ubicacion={ubicacion}
              />
            );
          })
      }
    </div>
  </div>
</article>

<style>
  .year-group {
  }

  .inner-content {
    display: flex;
    flex-direction: column;
    gap: var(--card-padding);
  }

  header {
    & :is(h1, h2) {
      position: relative;
      /* En la home va sobre el navy; en /autores, sobre el fondo normal */
      color: var(--autores-heading-color, var(--primary-color));
      font-size: 1.6rem;
      font-family: 'Roboto Mono', monospace;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      max-width: fit-content;
      margin: 0;

      &::after {
        content: '';
        display: block;
        position: absolute;
        left: 0;
        bottom: -6px;
        width: 95%;
        height: 6px;
        background: var(--primary-contrast-color);
      }
    }
  }

  .acordes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--card-padding);
    align-items: stretch;
  }

  @media (max-width: 640px) {
    .inner-content {
      gap: var(--card-padding-sm);
    }

    .acordes-grid {
      gap: var(--card-padding-sm);
      grid-template-columns: 1fr;
    }

    header {
      & :is(h1, h2) {
        font-size: 1.25rem;
      }
      & :is(h1, h2)::after {
        height: 4px;
        bottom: -2px;
      }
    }
  }
</style>
