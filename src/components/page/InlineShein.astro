---
const { inlineSheinData } = Astro.props;
---

<div class='rec-wrap' data-nosnippet>
  <a
    href={inlineSheinData.url}
    target='_blank'
    rel='noopener noreferrer sponsored'
    class='rec-card'>
    <div class='rec-img'>
      <img src={inlineSheinData.image} alt={inlineSheinData.name} loading='lazy' decoding='async' />
    </div>
  </a>
</div>

<style>
  .rec-wrap {
    width: 300px;
    height: 300px;
  }

  .rec-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;

    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    overflow: hidden;

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
