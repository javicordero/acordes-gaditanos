  img {
    height: auto;
    border: 2px solid var(--primary-color);
    border-radius: 0;
    width: 100%;
    min-height: 225px;
    max-height: 240px;
    object-fit: cover;
    display: block;
    /* Optimizaciones de performance */
    content-visibility: auto;
    contain-intrinsic-size: 482px 320px;
  }

  figcaption {
    position: absolute;
    bottom: 0;
    font-family: 'Roboto Mono', monospace;
    letter-spacing: 0.1px;
    font-weight: 700;
    border: 2px solid var(--primary-color);
    box-shadow: none;
    font-size: 14px;
    padding: 6px 8px;
  }

  .badge {
    max-width: 80%;
  }

  .badge--musica {
    display: none;
    left: 0;
    border-radius: 0;
    color: var(--on-bright-color);
    background-color: var(--primary-contrast-color);
  }

  .badge--letra {
    display: none;
    right: 0;
    color: var(--primary-contrast-color);
    background-color: var(--surface-color);
    border-radius: 0;
  }

  .acorde-content {
    position: relative;
    padding: 16px 0 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  /* Hueco para el control de autoscroll, que flota sobre la esquina
     superior derecha del cifrado sin tapar la primera línea. */
  .acorde-content > .acorde-content {
    padding-top: 26px;
  }

  .acorde-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--primary-color);
    padding: 4px 10px;
    border: 2px solid var(--primary-color);
    border-radius: 0;
    background-color: var(--card-background-color);
    box-shadow: 2px 2px 0 0 var(--primary-color);
  }

  :global(html[data-theme='dark']) .acorde-meta {
    background-color: var(--card-background-color);
    color: var(--primary-color);
    box-shadow: 2px 2px 0 0 var(--primary-color);
  }

  .acorde-content :global(pre) {
    margin: 0;
    font-family: 'Roboto Mono', monospace;
    letter-spacing: -0.3px;
    word-spacing: -0.3px;
    font-size: 0.95rem;
    line-height: 1.25rem;
    width: 100%;
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    position: relative;

    &::-webkit-scrollbar {
      display: none;
    }

& :global(a) {
      color: var(--acorde-color);
      position: relative;
      left: 7px;
    }

    /* Desplazamiento según la columna donde empieza el acorde:
       cuanto más a la izquierda, menos empujón necesita */
    & :global(a.acorde-col-0) {
      left: 0;
    }

    & :global(a.acorde-col-1) {
      left: 1px;
    }

    & :global(a.acorde-col-2) {
      left: 3px;
    }

    & :global(a.acorde-col-3) {
      left: 5px;
    }

    & :global(a.acorde-col-4) {
      left: 7px;
    }

    & :global(a.acorde-col-5) {
      left: 8px;
    }

    /* Asterisco de "postura concreta para esta pieza". Va absoluto para no
       desplazar la línea del <pre> ni romper la alineación con la letra. */
    & :global(a[data-postura])::after {
      content: '*';
      position: absolute;
      top: 0;
      right: -0.7em;
      font-size: 1em;
      line-height: 1;
      pointer-events: none;
    }

    /* Marcas de cejilla dentro del cifrado ("Cejilla: 4", "Cejilla: No"):
       mismo chip que .acorde-meta, pero dentro del <pre>. */
    & :global(strong) {
      display: flex;
      align-items: center;
      gap: 6px;
      width: fit-content;
      margin: 0.5rem auto;
      padding: 4px 10px;
      border: 2px solid var(--primary-color);
      background-color: var(--card-background-color);
      box-shadow: 2px 2px 0 0 var(--primary-color);
      color: var(--primary-color);
      font-size: 0.8rem;
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: normal;
      word-spacing: normal;
      text-transform: uppercase;
      white-space: nowrap;
    }

    & :global(strong)::before {
      content: '';
      flex: none;
      width: 18px;
      height: 18px;
      background-color: currentColor;
      -webkit-mask: url('/icons/cejilla.svg') center / contain no-repeat;
      mask: url('/icons/cejilla.svg') center / contain no-repeat;
    }
  }

  .autoscroll-wrapper {
    position: absolute;
    top: -22px;
    right: -6px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
    min-width: 40px;
    background: transparent;
    padding: 4px;
    border-radius: 0;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .autoscroll-btn {
    width: 32px;
    height: 32px;
    border-radius: 0;
    border: 2px solid var(--primary-color);
    background: var(--surface-color);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
    box-shadow: 2px 2px 0 0 var(--primary-color);
    flex-shrink: 0;
    order: -1;
    position: relative;
    left: 1px;
  }

  .autoscroll-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 0 var(--primary-color);
  }

  .autoscroll-btn:active {
    transform: translate(0, 0);
    box-shadow: 1px 1px 0 0 var(--primary-color);
  }

  .autoscroll-btn svg {
    width: 16px;
    height: 16px;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.2));
  }

  .pause-btn {
    display: none;
  }

  .autoscroll-wrapper .speed-options {
    gap: 2px;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.8s ease-in-out;
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .autoscroll-wrapper.playing {
    background: var(--card-background-color);
    border: 2px solid var(--primary-color);
    box-shadow: 2px 2px 0 0 var(--primary-color);
  }

  .autoscroll-wrapper.playing .speed-options {
    max-height: 200px;
    background: transparent;
  }

  .autoscroll-wrapper.playing .play-btn {
    display: none;
  }

  .autoscroll-wrapper.playing .pause-btn {
    display: flex;
  }

  .autoscroll-wrapper .play-btn {
    display: flex;
  }

  .speed-btn {
    padding: 2px 6px;
    border-radius: 0;
    border: 2px solid var(--primary-color);
    background: var(--card-background-color);
    color: var(--primary-color);
    font-size: 0.65rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Roboto Mono', monospace;
  }

  .speed-btn:hover {
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  .speed-btn.active {
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
    box-shadow: 2px 2px 0 0 var(--primary-color);
  }

  @media (max-width: 640px) {
    .autoscroll-btn {
      width: 28px;
      height: 28px;
    }

    .autoscroll-btn svg {
      width: 14px;
      height: 14px;
    }

    .speed-btn {
      padding: 2px 6px;
      font-size: 0.6rem;
    }
  }

  .acorde-content :global(pre.scrolling) {
    max-height: 85vh;
  }

  @media (max-width: 640px) {
    .acorde-content :global(pre.scrolling) {
      max-height: 70vh;
    }
  }
</style>

<script>
  // @ts-nocheck
  import { transportarEtiqueta } from '../../lib/transporte';

  (function() {
    const speeds = { 1: 2, 2: 4, 3: 7, 4: 10, 5: 14 };
    let currentSpeed = 2;
    let isPlaying = false;
    let animationFrameId = null;
    let lastScrollTime = 0;
    let scrollAccumulator = 0;
    let controlsContainer = null;
    let preElement = null;
    let initialized = false;

    let currentTranspose = 0;
    let transposeDisplay = null;
    let textosOriginales = [];
    let acordesOriginales = [];
    let originalesPorAncla = new Map();

    function guardarOriginales() {
      textosOriginales = [];
      acordesOriginales = [];
      originalesPorAncla = new Map();

      preElement.childNodes.forEach(function(nodo) {
        if (nodo.nodeType === Node.TEXT_NODE) {
          textosOriginales.push({ nodo: nodo, valor: nodo.nodeValue });
        }
      });

      preElement.querySelectorAll('a').forEach(function(el) {
        const texto = el.textContent || '';
        acordesOriginales.push({ el: el, texto: texto });
        originalesPorAncla.set(el, texto);
      });
    }

    function restaurarOriginales() {
      textosOriginales.forEach(function(entrada) {
        if (entrada.nodo.nodeValue !== entrada.valor) {
          entrada.nodo.nodeValue = entrada.valor;
        }
      });
      acordesOriginales.forEach(function(entrada) {
        if (entrada.el.textContent !== entrada.texto) {
          entrada.el.textContent = entrada.texto;
        }
      });
    }

    // Divide el <pre> en líneas: cada trozo de texto y cada <a> es un elemento.
    function construirLineas() {
      const lineas = [[]];

      preElement.childNodes.forEach(function(nodo) {
        if (nodo.nodeType === Node.TEXT_NODE) {
          const partes = (nodo.nodeValue || '').split('\n');
          partes.forEach(function(parte, i) {
            if (i > 0) lineas.push([]);
            lineas[lineas.length - 1].push({
              tipo: 'texto',
              nodo: nodo,
              parte: i,
              texto: parte,
            });
          });
        } else if (nodo.nodeType === Node.ELEMENT_NODE && originalesPorAncla.has(nodo)) {
          lineas[lineas.length - 1].push({ tipo: 'ancla', el: nodo });
        }
      });

      return lineas;
    }

    // Reparte los espacios de cada línea para que los acordes sigan sobre su sílaba.
    function realinear() {
      const lineas = construirLineas();
      const partesPorNodo = new Map();

      lineas.forEach(function(linea) {
        let desplazamiento = 0;

        for (let i = 0; i < linea.length; i++) {
          const item = linea[i];

          if (item.tipo === 'texto') continue;

          if (desplazamiento !== 0) {
            const hueco = linea[i - 1];
            if (hueco && hueco.tipo === 'texto' && /^ *$/.test(hueco.texto)) {
              const viejo = hueco.texto.length;
              const nuevo = Math.max(0, viejo - desplazamiento);
              if (nuevo !== viejo) {
                hueco.texto = ' '.repeat(nuevo);
                desplazamiento -= viejo - nuevo;
              }
            }
          }

          const original = originalesPorAncla.get(item.el) || '';
          desplazamiento += (item.el.textContent || '').length - original.length;
        }
      });

      lineas.forEach(function(linea) {
        linea.forEach(function(item) {
          if (item.tipo !== 'texto') return;
          if (!partesPorNodo.has(item.nodo)) partesPorNodo.set(item.nodo, []);
          partesPorNodo.get(item.nodo)[item.parte] = item.texto;
        });
      });

      partesPorNodo.forEach(function(partes, nodo) {
        nodo.nodeValue = partes.join('\n');
      });
    }

    function actualizarContador() {
      if (!transposeDisplay) return;
      if (currentTranspose === 0) {
        transposeDisplay.textContent = '0';
      } else {
        const signo = currentTranspose > 0 ? '+' : '−';
        transposeDisplay.textContent = signo + Math.abs(currentTranspose);
      }
    }

    function actualizarAccesibilidad() {
      acordesOriginales.forEach(function(entrada) {
        if (!entrada.el.hasAttribute('data-acorde')) return;
        const actual = (entrada.el.textContent || '').trim();
        entrada.el.setAttribute('aria-label', 'Ver cómo se toca ' + actual);
      });
    }

    function aplicarTransporte() {
      if (!preElement) return;

      restaurarOriginales();

      if (currentTranspose !== 0) {
        acordesOriginales.forEach(function(entrada) {
          const nuevo = transportarEtiqueta(entrada.texto, currentTranspose);
          if (nuevo !== entrada.texto) {
            entrada.el.textContent = nuevo;
          }
        });
        realinear();
      }

      actualizarAccesibilidad();
      actualizarContador();

      try {
        document.dispatchEvent(
          new CustomEvent('ag:transpose', { detail: { semitonos: currentTranspose } }),
        );
      } catch (e) {}
    }

    function analitica(evento, params) {
      try {
        const w = window as any;
        if (typeof w.gtag === 'function') {
          w.gtag('event', evento, {
            ...(params || {}),
            event_category: 'acordes',
            event_label: window.location.pathname,
          });
        } else {
          w.dataLayer = w.dataLayer || [];
          w.dataLayer.push({ event: evento, ...(params || {}) });
        }
      } catch (e) {}
    }

    function cambiarTono(delta) {
      currentTranspose += delta;
      aplicarTransporte();

      analitica('transpose_acorde', {
        direccion: delta > 0 ? 'subir' : 'bajar',
        semitonos: currentTranspose,
      });
    }

    function initAutoscroll() {
      if (initialized) return;
      initialized = true;

      const article = document.querySelector('.acorde-card');
      if (!article) return;

      controlsContainer = article.querySelector('.autoscroll-wrapper');
      const playBtn = article.querySelector('.play-btn');
      const pauseBtn = article.querySelector('.pause-btn');
      const speedBtns = article.querySelectorAll('.speed-btn');
      const speedOptions = article.querySelector('.speed-options');

      const contentArea = article.querySelector('.acorde-content');
      preElement = contentArea?.querySelector('pre');
      if (!preElement) return;

      guardarOriginales();

      // En la colección provisional los acordes aún no van envueltos en <a>.
      const controlesTono = article.querySelector('.transpose-controls');
      if (controlesTono && acordesOriginales.length === 0) {
        const grupo = controlesTono.closest('.transporte') || controlesTono;
        grupo.style.display = 'none';
      }

      const transposeUp = article.querySelector('.transpose-up');
      const transposeDown = article.querySelector('.transpose-down');
      transposeDisplay = article.querySelector('[data-transpose-display]');

      if (transposeUp) {
        transposeUp.addEventListener('click', function() {
          cambiarTono(1);
        });
      }

      if (transposeDown) {
        transposeDown.addEventListener('click', function() {
          cambiarTono(-1);
        });
      }

      if (playBtn) {
        playBtn.addEventListener('click', function() {
          startAutoscroll(speedOptions, playBtn, pauseBtn);
        });
      }

      if (pauseBtn) {
        pauseBtn.addEventListener('click', function() {
          stopAutoscroll(speedOptions, playBtn, pauseBtn);
        });
      }

      speedBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          speedBtns.forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          currentSpeed = parseInt(btn.getAttribute('data-speed'), 10);
          try {
            const w = window as any;
            if (typeof w.gtag === 'function') {
              w.gtag('event', 'autoscroll_speed', {
                speed: currentSpeed,
                page_location: window.location.href,
              });
            }
          } catch (e) {}
          if (isPlaying) {
            restartAutoscroll(speedOptions, playBtn, pauseBtn);
          }
        });
      });

      document.addEventListener('keydown', function(e) {
        if (e.code === 'Space' && e.target === document.body) {
          e.preventDefault();
          if (isPlaying) {
            stopAutoscroll(speedOptions, playBtn, pauseBtn);
          } else {
            startAutoscroll(speedOptions, playBtn, pauseBtn);
          }
        }
      });

      var contentParent = preElement.parentElement;
      if (contentParent) {
        contentParent.addEventListener('scroll', function() {
          if (isPlaying) {
            if (preElement.scrollTop + preElement.clientHeight >= preElement.scrollHeight - 5) {
              stopAutoscroll();
            }
          }
        });
      }

    }

    function animateScroll(timestamp) {
      if (!preElement || !isPlaying) {
        animationFrameId = requestAnimationFrame(animateScroll);
        return;
      }

      if (!lastScrollTime) lastScrollTime = timestamp;
      const elapsed = timestamp - lastScrollTime;
      lastScrollTime = timestamp;

      const pxPerSec = speeds[currentSpeed];
      scrollAccumulator += (pxPerSec * elapsed) / 1000;

      if (scrollAccumulator >= 1) {
        const wholePixels = Math.floor(scrollAccumulator);
        const newScrollTop = preElement.scrollTop + wholePixels;
        if (newScrollTop >= preElement.scrollHeight - preElement.clientHeight) {
          scrollAccumulator = 0;
          stopAutoscroll();
          return;
        }
        preElement.scrollTop = newScrollTop;
        scrollAccumulator -= wholePixels;
      }

      animationFrameId = requestAnimationFrame(animateScroll);
    }

    function startAutoscroll(speedOptions, playBtn, pauseBtn) {
      if (controlsContainer) {
        controlsContainer.classList.add('playing');
      }
      isPlaying = true;
      try {
        const w = window as any;
        if (typeof w.gtag === 'function') {
          w.gtag('event', 'autoscroll_start', {
            page_location: window.location.href,
          });
        }
      } catch (e) {}
      lastScrollTime = 0;
      scrollAccumulator = 0;

      if (preElement) {
        preElement.classList.add('scrolling');
        animationFrameId = requestAnimationFrame(animateScroll);
      }
    }

    function stopAutoscroll(speedOptions, playBtn, pauseBtn) {
      if (isPlaying) {
        try {
          const w = window as any;
          if (typeof w.gtag === 'function') {
            w.gtag('event', 'autoscroll_stop', {
              page_location: window.location.href,
            });
          }
        } catch (e) {}
      }
      isPlaying = false;
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      if (controlsContainer) {
        controlsContainer.classList.remove('playing');
      }

    }

    function restartAutoscroll(speedOptions, playBtn, pauseBtn) {
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      startAutoscroll(speedOptions, playBtn, pauseBtn);
    }

    // Pausa el autoscroll mientras se consulta un diagrama del glosario.
    var reanudarAlCerrarGlosario = false;

    document.addEventListener('ag:popover-abierto', function() {
      if (isPlaying) {
        stopAutoscroll();
        reanudarAlCerrarGlosario = true;
      }
    });

    document.addEventListener('ag:popover-cerrado', function() {
      if (reanudarAlCerrarGlosario) {
        reanudarAlCerrarGlosario = false;
        startAutoscroll();
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAutoscroll);
    } else {
      initAutoscroll();
    }
  })();
</script>
