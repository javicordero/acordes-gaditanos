---
import { render } from 'astro:content';
import { readFileSync } from 'node:fs';
import { Icon } from 'astro-icon/components';
import AcordeAvisoMigracion from './AcordeAvisoMigracion.astro';
import { Image } from 'astro:assets';
import RecomendacionInline from './RecomendacionInline.astro';
import Anuncio from '../right-column/anuncios/Anuncio.astro';
import AcordesDeLaPieza from './AcordesDeLaPieza.astro';
import GlosarioPopover from './GlosarioPopover.astro';
import glosarioJson from '../../data/glosario-acordes.json';
import { acordesDePieza, crearIndice, type Glosario } from '../../lib/acordes';
import { mapaGlosarioConTransportes } from '../../lib/transporte';

const { acorde, glosario: conGlosario = true } = Astro.props;
const { data, slug } = acorde;
const {
  pieza,
  agrupacion,
  musica,
  img,
  year,
  letra,
  cejilla,
  modalidad,
  musicaSlug,
  letraSlug,
  agrupacionSlug,
  musicaList,
  letraList,
  musicaSlugs,
  letraSlugs,
} = data;
const { Content } = await render(acorde);

// Glosario de acordes de la pieza (solo se calcula si está activo)
const indiceGlosario = conGlosario
  ? crearIndice((glosarioJson as unknown as { acordes: Glosario }).acordes)
  : null;
const cuerpoAcorde =
  typeof acorde.body === 'string'
    ? acorde.body
    : typeof acorde.filePath === 'string'
      ? readFileSync(acorde.filePath, 'utf8')
      : '';
const acordesPieza =
  indiceGlosario && cuerpoAcorde ? acordesDePieza(cuerpoAcorde, indiceGlosario) : [];

/** Posturas predeterminadas por acorde: <a data-postura="x 0 2 2 2 4">LaM7</a>. */
const posturasPieza: Record<string, string> = {};
for (const m of cuerpoAcorde.matchAll(/<a\b([^>]*)>([\s\S]*?)<\/a>/gi)) {
  const etiqueta = (m[2] ?? '').trim();
  const atributos = m[1] ?? '';
  const postura = atributos.match(/\bdata-postura\s*=\s*(?:"([^"]*)"|'([^']*)')/i);
  const valor = (postura?.[1] ?? postura?.[2] ?? '').trim();
  if (etiqueta && valor && !(etiqueta in posturasPieza)) {
    posturasPieza[etiqueta] = valor;
  }
}

const datosGlosario: Glosario = indiceGlosario
  ? mapaGlosarioConTransportes(acordesPieza, indiceGlosario)
  : {};

// Generar texto ALT descriptivo para SEO
const altText = `${agrupacion} - ${modalidad} del Carnaval de Cádiz ${year}`;

// ID para accesibilidad
const headingId = `acorde-${slug}`;
---

<article class='acorde-card'>
  <!-- <Banner320X50 adKey='00168e813d28ccdbf699a41e61d3b2ab' />
  <Banner468X60 adKey='0a8164971e8c287ce3c84cea534f2266' /> -->
  <!-- <AcordeAvisoMigracion /> -->

  <header>
    <h2 id={headingId} class='is-title-minus' transition:name={`titulo-${slug}`}>
      {pieza} {agrupacion}
    </h2>

    <section class='autores-year'>
      <div class='autores'>
        <p>
          <strong>Letra:</strong>
          {
            (letraList && letraList.length > 0 ? letraList : (letra ? [letra] : [])).map((nombre: string, i: number, arr: string[]) => (
              <>{i > 0 && (i === arr.length - 1 ? ' y ' : ', ')}<a href={`/autor/letra/${(letraSlugs && letraSlugs[i]) || letraSlug}`} rel='noopener'>{nombre}</a></>
            ))
          }
        </p>
        <p>
          <strong>Música:</strong>
          {
            (musicaList && musicaList.length > 0 ? musicaList : (musica ? [musica] : [])).map((nombre: string, i: number, arr: string[]) => (
              <>{i > 0 && (i === arr.length - 1 ? ' y ' : ', ')}<a href={`/autor/musica/${(musicaSlugs && musicaSlugs[i]) || musicaSlug}`} rel='noopener'>{nombre}</a></>
            ))
          }
        </p>
      </div>
      <div class='year'>
        <a href={`/carnaval/${year}`} rel='noopener'>
          <p>
            {year}
          </p>
        </a>
      </div>
    </section>

    <figure>
      <Image
        class='acorde-image'
        src={img}
        alt={altText}
        loading='lazy'
        decoding='async'
        transition:name={`img-${slug}`}
        width={480}
        height={320}
        unoptimized
      />

      <figcaption class='badge badge--musica'>
        {musica}
      </figcaption>
      <figcaption class='badge badge--letra'>
        {letra}
      </figcaption>
    </figure>
  </header>

  <div class='container-layout anuncio-movil'>
    <Anuncio adSlot='8116046706' />
  </div>

  <section class='acorde-content' role='region' aria-labelledby={headingId}>

    {conGlosario && <AcordesDeLaPieza acordes={acordesPieza} posturas={posturasPieza} />}

    <div class='acorde-meta'>
      <Icon name='cejilla' width={18} height={18} />
      <span>Cejilla: {cejilla == 0 || !cejilla ? 'No' : cejilla}</span>
    </div>

    <div class='acorde-content'>
      <div class='autoscroll-wrapper'>
        <button class='autoscroll-btn play-btn' aria-label='Iniciar autoscroll'>
          <svg style='position: relative; left: 1px;' xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='var(--primary-contrast-color)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='5 3 19 12 5 21 5 3'></polygon></svg>
        </button>
        <button class='autoscroll-btn pause-btn' aria-label='Pausar autoscroll'>
          <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='var(--primary-contrast-color)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='6' y='4' width='4' height='16'></rect><rect x='14' y='4' width='4' height='16'></rect></svg>
        </button>
        <div class='speed-options'>
          <button class='speed-btn' data-speed='1'>1x</button>
          <button class='speed-btn active' data-speed='2'>2x</button>
          <button class='speed-btn' data-speed='3'>3x</button>
          <button class='speed-btn' data-speed='4'>4x</button>
          <button class='speed-btn' data-speed='5'>5x</button>
        </div>
      </div>
      <Content />
    </div>
  </section>
</article>

{conGlosario && <GlosarioPopover />}
{conGlosario && (
  <script type='application/json' id='glosario-datos' set:html={JSON.stringify(datosGlosario)} />
)}

<style>
  article {
    border-radius: 0;
    width: 100%;
    max-width: 600px;
    box-sizing: border-box;
    margin: 0;
    display: flex;
    flex-direction: column;
    flex: 0 1 auto;
    /* gap: 8px; */
    position: relative; /* TODO: quitar cuando quitemos el aviso de migración */
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 10px;

    box-sizing: border-box;
    /* text-transform: uppercase; */
  }

  h2 {
    color: var(--primary-color);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    line-height: normal;
    max-width: fit-content;
    margin: 0;
    text-transform: uppercase;
    position: relative;

    &::after {
      content: '';
      display: block;
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 95%;
      height: 6px;
      background: var(--primary-contrast-color);

      @media (max-width: 640px) {
        height: 4px;
        bottom: -2px;
      }
    }
  }

  @media (max-width: 640px) {
    h2 {
      font-size: 1.25rem;
    }
  }

  .autores-year {
    display: flex;
    justify-content: space-between;
  }

  .year {
    font-size: 1rem;
    font-weight: 500;
    text-transform: none;

    & a {
      color: var(--link-color);
      font-family: 'Roboto Mono', monospace;
      text-decoration: none;
    }
  }

  .autores {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--secondary-color);
    font-weight: 500;
    text-transform: none;
    position: relative;

    & strong {
      font-family: 'Roboto Mono', monospace;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--text-secondary-color);
    }

    & a {
      color: var(--link-color);
      text-decoration: none;
    }
  }

  figure {
    position: relative;
    width: 360px;
    max-width: 100%;
    margin: 0 auto;
  }

  .anuncio-movil {
    display: none;
    margin-top: 24px;
  }

  @media (max-width: 640px) {
    .anuncio-movil {
