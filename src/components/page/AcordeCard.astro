---
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import AcordeAvisoMigracion from './AcordeAvisoMigracion.astro';
import { Image } from 'astro:assets';
import RecomendacionInline from './RecomendacionInline.astro';
import TutorialAutoscroll from './TutorialAutoscroll.astro';
import Anuncio from '../right-column/anuncios/Anuncio.astro';

const { acorde } = Astro.props;
const { data, slug } = acorde;
const {
  pieza,
  agrupacion,
  musica,
  img,
  year,
  letra,
  cejilla,
  modalidad,
  musicaSlug,
  letraSlug,
  agrupacionSlug,
  musicaList,
  letraList,
  musicaSlugs,
  letraSlugs,
} = data;
const { Content } = await render(acorde);

// Generar texto ALT descriptivo para SEO
const altText = `${agrupacion} - ${modalidad} del Carnaval de Cádiz ${year}`;

// ID para accesibilidad
const headingId = `acorde-${slug}`;
---

<article class='acorde-card'>
  <!-- <Banner320X50 adKey='00168e813d28ccdbf699a41e61d3b2ab' />
  <Banner468X60 adKey='0a8164971e8c287ce3c84cea534f2266' /> -->
  <!-- <AcordeAvisoMigracion /> -->

  <header>
    <h2 id={headingId} class='is-title-minus'>
      <span class='pieza'>
        {pieza}
      </span>
      <span class='agrupacion'>
        {agrupacion}
      </span>
    </h2>

    <section class='autores-year'>
      <div class='autores'>
        <p>
          <strong>Letra:</strong>
          {
            (letraList && letraList.length > 0 ? letraList : (letra ? [letra] : [])).map((nombre: string, i: number, arr: string[]) => (
              <>{i > 0 && (i === arr.length - 1 ? ' y ' : ', ')}<a href={`/autor/letra/${(letraSlugs && letraSlugs[i]) || letraSlug}`} rel='noopener'>{nombre}</a></>
            ))
          }
        </p>
        <p>
          <strong>Música:</strong>
          {
            (musicaList && musicaList.length > 0 ? musicaList : (musica ? [musica] : [])).map((nombre: string, i: number, arr: string[]) => (
              <>{i > 0 && (i === arr.length - 1 ? ' y ' : ', ')}<a href={`/autor/musica/${(musicaSlugs && musicaSlugs[i]) || musicaSlug}`} rel='noopener'>{nombre}</a></>
            ))
          }
        </p>
      </div>
      <div class='year'>
        <a href={`/carnaval/${year}`} rel='noopener'>
          <p>
            {year}
          </p>
        </a>
      </div>
    </section>

    <figure>
      <Image
        class='acorde-image'
        src={img}
        alt={altText}
        loading='lazy'
        decoding='async'
        transition:name={`img-${slug}`}
        width={480}
        height={320}
        unoptimized
      />

      <figcaption class='badge badge--musica' transition:name={`musica-${slug}`}>
        {musica}
      </figcaption>
      <figcaption class='badge badge--letra'>
        {letra}
      </figcaption>
    </figure>
  </header>

  <div class='container-layout anuncio-movil'>
    <Anuncio adSlot='8116046706' />
  </div>

  <section class='acorde-content' role='region' aria-labelledby={headingId}>

    <div class='acorde-meta'>
      <Icon name='cejilla' width={22} height={22} />
      <span>{cejilla == 0 || !cejilla ? 'No' : cejilla}</span>
    </div>

      <div class='acorde-content'>
      <TutorialAutoscroll />
      <div class='autoscroll-wrapper'>
       <button class='autoscroll-help-btn' data-tutorial-help aria-label='Ayuda sobre controles' type='button'>?</button>
         <!-- <div class='transpose-controls'>
          <button class='transpose-btn transpose-up' aria-label='Subir tono' title='Subir tono' type='button'>+</button>
          <span class='transpose-display' data-transpose-display></span>
          <button class='transpose-btn transpose-down' aria-label='Bajar tono' title='Bajar tono' type='button'>−</button>
        </div> -->
        <button class='autoscroll-btn play-btn' aria-label='Iniciar autoscroll'>
          <svg style='position: relative; left: 1px;' xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='var(--primary-contrast-color)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='5 3 19 12 5 21 5 3'></polygon></svg>
        </button>
        <button class='autoscroll-btn pause-btn' aria-label='Pausar autoscroll'>
          <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='var(--primary-contrast-color)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='6' y='4' width='4' height='16'></rect><rect x='14' y='4' width='4' height='16'></rect></svg>
        </button>
        <div class='speed-options'>
          <button class='speed-btn' data-speed='1'>1x</button>
          <button class='speed-btn active' data-speed='2'>2x</button>
          <button class='speed-btn' data-speed='3'>3x</button>
          <button class='speed-btn' data-speed='4'>4x</button>
          <button class='speed-btn' data-speed='5'>5x</button>
        </div>
      </div>
      <Content />
    </div>
  </section>
</article>

<style>
  article {
    border-radius: 8px;
    width: 100%;
    max-width: 600px;
    box-sizing: border-box;
    margin: 0;
    display: flex;
    flex-direction: column;
    flex: 0 1 auto;
    /* gap: 8px; */
    position: relative; /* TODO: quitar cuando quitemos el aviso de migración */
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 8px;

    box-sizing: border-box;
    /* text-transform: uppercase; */
  }

  h2 {
    color: var(--primary-color);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.79rem;
    max-width: fit-content;
    margin: 0;
    text-transform: none;

    &::after {
      content: '';
      display: block;
      width: 92%;
      height: 4px;
      background: var(--primary-contrast-color);
    }
  }

  .autores-year {
    display: flex;
    justify-content: space-between;
  }

  .year {
    font-size: 1.3rem;
    font-weight: 500;
    text-transform: none;

    & a {
      color: var(--link-color);
      text-decoration: none;

      &:hover {
        text-decoration: none;
        color: var(--link-hover-color);
      }
    }
  }

  .autores {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 1rem;
    color: var(--secondary-color);
    font-weight: 500;
    text-transform: none;
    position: relative;

    & a {
      color: var(--link-color);
      text-decoration: none;

      &:hover {
        text-decoration: none;
        color: var(--link-hover-color);
      }
    }
  }

  figure {
    position: relative;
    width: 360px;
    max-width: 100%;
    margin: 0 auto;
  }

  .anuncio-movil {
    display: none;
    margin-top: 24px;
  }

  @media (max-width: 640px) {
    .anuncio-movil {
      display: block;
    }
  }

  img {
    height: auto;
    border-radius: 8px;
    width: 100%;
    min-height: 225px;
    max-height: 240px;
    object-fit: cover;
    display: block;
    /* Optimizaciones de performance */
    content-visibility: auto;
    contain-intrinsic-size: 482px 320px;
  }

  figcaption {
    position: absolute;
    bottom: 0;
    font-family: 'Raleway', sans-serif;
    /* text-transform: uppercase; */
    letter-spacing: 0.1px;
    font-weight: 500;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    font-size: 14px;
    padding: 6px 8px;
  }

  .badge {
    max-width: 80%;
  }

  .badge--musica {
    display: none;
    left: 0;
    border-radius: 0 6px 0 6px;
    color: var(--primary-color);
    background-color: var(--primary-contrast-color);
  }

  .badge--letra {
    display: none;
    right: 0;
    color: var(--primary-contrast-color);
    background-color: var(--primary-color);
    border-radius: 6px 0 6px 0;
  }

  .acorde-content {
    position: relative;
    padding: 16px 0 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .acorde-meta {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 1.1rem;
    color: var(--secondary-color);
    padding: 4px 6px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .acorde-content :global(pre) {
    margin: 0;
    letter-spacing: -0.3px;
    word-spacing: -0.3px;
    font-size: 0.95rem;
    line-height: 1.25rem;
    width: 100%;
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    position: relative;

    &::-webkit-scrollbar {
      display: none;
    }

& :global(a) {
      color: var(--acorde-color);
      position: relative;
      left: 7px;
    }
  }

  .autoscroll-wrapper {
    position: absolute;
    top: -10px;
    right: -6px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
    min-width: 40px;
    background: transparent;
    padding: 4px;
    border-radius: 8px;
    transition: background 0.8s ease-in-out, box-shadow 0.8s ease-in-out;
  }

  .autoscroll-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(145deg, var(--secondary-color) 0%, var(--primary-color) 100%);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.5s ease, transform 0.2s ease, box-shadow 0.5s ease;
    box-shadow: 0 2px 8px rgba(59, 90, 100, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
    order: -1;
    position: relative;
    left: 1px;
  }

  .autoscroll-btn:hover {
    transform: scale(1.08);
  }

  .autoscroll-btn:active {
    transform: scale(0.95);
  }

  .autoscroll-btn svg {
    width: 16px;
    height: 16px;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.2));
  }

  .pause-btn {
    display: none;
  }

  .autoscroll-wrapper .speed-options {
    gap: 2px;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.8s ease-in-out;
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .autoscroll-wrapper.playing {
    background: rgba(255, 255, 255, 0.6);
    box-shadow: 0 2px 12px rgba(59, 90, 100, 0.15);
  }

  .autoscroll-wrapper.playing .speed-options {
    max-height: 200px;
    background: transparent;
  }

  .autoscroll-wrapper.playing .play-btn {
    display: none;
  }

  .autoscroll-wrapper.playing .pause-btn {
    display: flex;
  }

  .autoscroll-wrapper .play-btn {
    display: flex;
  }

  .autoscroll-help-btn {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid var(--secondary-color);
    background: transparent;
    color: var(--secondary-color);
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: all 0.2s ease;
    flex-shrink: 0;
    order: -2;
    padding: 0;
    font-family: 'Montserrat', sans-serif;
  }

  .autoscroll-help-btn:hover {
    background: var(--secondary-color);
    color: #fff;
  }

  .speed-btn {
    padding: 2px 6px;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: var(--secondary-color);
    font-size: 0.65rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Montserrat', sans-serif;
  }

  .speed-btn:hover {
    background: rgba(20, 33, 61, 0.12);
    color: var(--primary-color);
  }

  .speed-btn.active {
    background: linear-gradient(145deg, var(--secondary-color) 0%, var(--primary-color) 100%);
    color: #fff;
    box-shadow: 0 1px 4px rgba(20, 33, 61, 0.3);
  }

  .transpose-controls {
    display: flex;
    flex-direction: row;
    gap: 2px;
    align-items: center;
    order: -3;
  }

  .transpose-btn {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(145deg, var(--secondary-color) 0%, var(--primary-color) 100%);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease, transform 0.15s ease;
    box-shadow: 0 1px 4px rgba(59, 90, 100, 0.2);
    flex-shrink: 0;
    line-height: 1;
    padding: 0;
    font-family: 'Montserrat', sans-serif;
  }

  .transpose-btn:hover {
    transform: scale(1.1);
  }

  .transpose-btn:active {
    transform: scale(0.92);
  }

  .transpose-display {
    font-size: 0.55rem;
    font-weight: 700;
    color: var(--secondary-color);
    min-width: 16px;
    text-align: center;
    font-family: 'Montserrat', sans-serif;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .autoscroll-btn {
      width: 30px;
      height: 30px;
    }

    .autoscroll-btn svg {
      width: 16px;
      height: 16px;
    }

    .speed-btn {
      padding: 2px 8px;
      font-size: 0.6rem;
    }

    .autoscroll-wrapper {
      top: -50px;
    }
  }

  .acorde-content :global(pre.scrolling) {
    max-height: 85vh;
  }

  @media (max-width: 640px) {
    .acorde-content :global(pre.scrolling) {
      max-height: 70vh;
    }
  }
</style>

<script is:inline>
  (function() {
    const speeds = { 1: 2, 2: 4, 3: 7, 4: 10, 5: 14 };
    const ESCALA_CROMATICA = ['Do','Do#','Re','Re#','Mi','Fa','Fa#','Sol','Sol#','La','La#','Si'];
    const NOTA_REGEX = /^(Sol#?|La#?|Si|Fa#?|Mi|Re#?|Do#?)(.*)$/;
    let currentSpeed = 2;
    let isPlaying = false;
    let animationFrameId = null;
    let lastScrollTime = 0;
    let scrollAccumulator = 0;
    let controlsContainer = null;
    let preElement = null;
    let initialized = false;

    let currentTranspose = 0;
    let originalChords = new Map();

    function transportarNota(nota, semitonos) {
      const idx = ESCALA_CROMATICA.indexOf(nota);
      if (idx === -1) return nota;
      const nuevoIdx = ((idx + semitonos) % 12 + 12) % 12;
      return ESCALA_CROMATICA[nuevoIdx];
    }

    function transportarAcorde(texto, semitonos) {
      if (!texto) return texto;
      const partes = texto.split('/');
      const transportarParte = function(p) {
        const match = p.match(NOTA_REGEX);
        if (!match) return p;
        const nuevaNota = transportarNota(match[1], semitonos);
        return nuevaNota + match[2];
      };
      return partes.map(transportarParte).join('/');
    }

    function transportarTodosLosAcordes(pre, semitonos) {
      if (!pre) return;
      const acordes = pre.querySelectorAll('a');
      acordes.forEach(function(a) {
        const original = originalChords.get(a);
        if (original !== undefined) {
          a.textContent = transportarAcorde(original, semitonos);
        }
      });
    }

    function actualizarDisplayTranspose(display) {
      if (!display) return;
      if (currentTranspose === 0) {
        display.textContent = '';
      } else {
        display.textContent = (currentTranspose > 0 ? '+' : '') + currentTranspose;
      }
    }

    function initAutoscroll() {
      if (initialized) return;
      initialized = true;

      const article = document.querySelector('.acorde-card');
      if (!article) return;

      controlsContainer = article.querySelector('.autoscroll-wrapper');
      const playBtn = article.querySelector('.play-btn');
      const pauseBtn = article.querySelector('.pause-btn');
      const speedBtns = article.querySelectorAll('.speed-btn');
      const speedOptions = article.querySelector('.speed-options');

      const contentArea = article.querySelector('.acorde-content');
      preElement = contentArea?.querySelector('pre');
      if (!preElement) return;

      const chordLinks = preElement.querySelectorAll('a');
      chordLinks.forEach(function(a) {
        originalChords.set(a, a.textContent);
      });

      const transposeUp = article.querySelector('.transpose-up');
      const transposeDown = article.querySelector('.transpose-down');
      const transposeDisplay = article.querySelector('[data-transpose-display]');

      if (transposeUp) {
        transposeUp.addEventListener('click', function() {
          currentTranspose += 1;
          transportarTodosLosAcordes(preElement, currentTranspose);
          actualizarDisplayTranspose(transposeDisplay);
        });
      }

      if (transposeDown) {
        transposeDown.addEventListener('click', function() {
          currentTranspose -= 1;
          transportarTodosLosAcordes(preElement, currentTranspose);
          actualizarDisplayTranspose(transposeDisplay);
        });
      }

      if (playBtn) {
        playBtn.addEventListener('click', function() {
          startAutoscroll(speedOptions, playBtn, pauseBtn);
        });
      }

      if (pauseBtn) {
        pauseBtn.addEventListener('click', function() {
          stopAutoscroll(speedOptions, playBtn, pauseBtn);
        });
      }

      speedBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          speedBtns.forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          currentSpeed = parseInt(btn.getAttribute('data-speed'), 10);
          try {
            if (typeof gtag === 'function') {
              gtag('event', 'autoscroll_speed', {
                speed: currentSpeed,
                page_location: window.location.href,
              });
            }
          } catch (e) {}
          if (isPlaying) {
            restartAutoscroll(speedOptions, playBtn, pauseBtn);
          }
        });
      });

      document.addEventListener('keydown', function(e) {
        if (e.code === 'Space' && e.target === document.body) {
          e.preventDefault();
          if (isPlaying) {
            stopAutoscroll(speedOptions, playBtn, pauseBtn);
          } else {
            startAutoscroll(speedOptions, playBtn, pauseBtn);
          }
        }
      });

      var contentParent = preElement.parentElement;
      if (contentParent) {
        contentParent.addEventListener('scroll', function() {
          if (isPlaying) {
            if (preElement.scrollTop + preElement.clientHeight >= preElement.scrollHeight - 5) {
              stopAutoscroll();
            }
          }
        });
      }

    }

    function animateScroll(timestamp) {
      if (!preElement || !isPlaying) {
        animationFrameId = requestAnimationFrame(animateScroll);
        return;
      }

      if (!lastScrollTime) lastScrollTime = timestamp;
      const elapsed = timestamp - lastScrollTime;
      lastScrollTime = timestamp;

      const pxPerSec = speeds[currentSpeed];
      scrollAccumulator += (pxPerSec * elapsed) / 1000;

      if (scrollAccumulator >= 1) {
        const wholePixels = Math.floor(scrollAccumulator);
        const newScrollTop = preElement.scrollTop + wholePixels;
        if (newScrollTop >= preElement.scrollHeight - preElement.clientHeight) {
          scrollAccumulator = 0;
          stopAutoscroll();
          return;
        }
        preElement.scrollTop = newScrollTop;
        scrollAccumulator -= wholePixels;
      }

      animationFrameId = requestAnimationFrame(animateScroll);
    }

    function startAutoscroll(speedOptions, playBtn, pauseBtn) {
      if (controlsContainer) {
        controlsContainer.classList.add('playing');
      }
      isPlaying = true;
      try {
        if (typeof gtag === 'function') {
          gtag('event', 'autoscroll_start', {
            page_location: window.location.href,
          });
        }
      } catch (e) {}
      lastScrollTime = 0;
      scrollAccumulator = 0;

      if (preElement) {
        preElement.classList.add('scrolling');
        animationFrameId = requestAnimationFrame(animateScroll);
      }
    }

    function stopAutoscroll(speedOptions, playBtn, pauseBtn) {
      if (isPlaying) {
        try {
          if (typeof gtag === 'function') {
            gtag('event', 'autoscroll_stop', {
              page_location: window.location.href,
            });
          }
        } catch (e) {}
      }
      isPlaying = false;
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      if (controlsContainer) {
        controlsContainer.classList.remove('playing');
      }

    }

    function restartAutoscroll(speedOptions, playBtn, pauseBtn) {
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      startAutoscroll(speedOptions, playBtn, pauseBtn);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAutoscroll);
    } else {
      initAutoscroll();
    }
  })();
</script>
