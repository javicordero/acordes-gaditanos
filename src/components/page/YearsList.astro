---
const { years, heading = 'Todos los carnavales', headingId = 'years-list-title' } = Astro.props;
---

<article class='years-list' aria-labelledby={headingId}>
  <div class='container-layout inner-content'>
    <header>
      <h2 id={headingId}>{heading}</h2>
      <slot name='subtitle' />
    </header>
    <ul>
      {
        years.map((year) => (
          <li key={year}>
            <a href={`/carnaval/${year}`}>{year}</a>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .years-list {
    border-radius: 0;
  }

  .inner-content {
    display: flex;
    flex-direction: column;
    gap: var(--card-padding);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: var(--card-padding);
  }

  header h2 {
    position: relative;
    color: var(--primary-color);
    font-size: 1.6rem;
    font-family: 'Roboto Mono', monospace;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    max-width: fit-content;
    margin: 0;
  }
  header h2::after {
    content: '';
    display: block;
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 95%;
    height: 6px;
    background: var(--primary-contrast-color);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
    width: 100%;
  }
  li {
    background: var(--primary-contrast-color);
    border: 2px solid var(--primary-color);
    border-radius: 0;
    box-shadow: 4px 4px 0 0 var(--primary-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
    font-family: 'Roboto Mono', monospace;
    width: 100%;
    text-align: center;
  }

  li a {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: var(--on-bright-color);
    padding: 14px;
    box-sizing: border-box;
    border-radius: 0;
    font-family: 'Roboto Mono', monospace;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.5px;
    transition: color 0.15s ease;
  }

  li:hover,
  li:focus-within {
    background: var(--surface-color);
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 0 var(--primary-contrast-color);
  }

  li:hover a,
  li:focus-within a {
    color: var(--primary-contrast-color);
  }

  @media (max-width: 640px) {
    .inner-content {
      gap: var(--card-padding-sm);
    }
    header {
      gap: var(--card-padding-sm);
    }
    ul {
      gap: 2.5vw;
      grid-template-columns: repeat(3, 1fr);
    }
    li {
      box-shadow: 3px 3px 0 0 var(--primary-color);

      &:hover,
      &:focus-within {
        transform: none;
        box-shadow: 3px 3px 0 0 var(--primary-color);
      }
    }
    header h2 {
      font-size: 1.25rem;
      letter-spacing: 0px;
    }
    header h2::after {
      height: 4px;
      bottom: -2px;
    }
    li a {
      padding: 12px;
      font-size: 1.2rem;
    }
  }
</style>
