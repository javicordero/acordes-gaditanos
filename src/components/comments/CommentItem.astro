---
interface Props {
  id: string;
  author: string;
  content: string;
  date: string;
  isAdmin: boolean;
  completed: boolean;
  depth?: number;
}

const { id, author, content, date, isAdmin, completed, depth = 0 } = Astro.props;

function formatDate(isoDate: string): string {
  const d = new Date(isoDate);
  const day = String(d.getDate()).padStart(2, '0');
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const year = d.getFullYear();
  const hours = String(d.getHours()).padStart(2, '0');
  const minutes = String(d.getMinutes()).padStart(2, '0');
  return `${day}/${month}/${year} ${hours}:${minutes}`;
}

const displayName = author && author.trim() ? author.trim() : 'Anónimo';
---

<div class:list={['comment-item', { 'is-admin': isAdmin, 'is-root': depth === 0 }]} style={`margin-left: ${depth * 24}px`}>
  <div class='comment-header'>
    <span class='comment-author'>
      {isAdmin && <span class='badge-admin'>Propietario</span>}
      {displayName}
    </span>
    <span class='comment-date'>{formatDate(date)}</span>
    {completed && <span class='badge-completed'>Completada</span>}
  </div>

  <div class='comment-content'>
    <p>{content}</p>
  </div>

  <div class='comment-actions'>
    <button class='reply-btn' data-parent-id={id} data-author={displayName}>
      Responder
    </button>
  </div>
</div>

<style>
  .comment-item {
    padding: 12px 0;
    border-bottom: 2px solid var(--primary-color);
  }

  .comment-item:last-child {
    border-bottom: none;
  }

  .comment-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .comment-author {
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--primary-color, #333);
  }

  .comment-date {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-secondary-color, #888);
  }

  .badge-admin {
    display: inline-block;
    background: var(--primary-contrast-color, #c2185b);
    color: var(--on-bright-color);
    border: 2px solid var(--on-bright-color);
    padding: 2px 8px;
    border-radius: 0;
    font-size: 0.65rem;
    font-weight: 800;
    margin-right: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .badge-completed {
    display: inline-block;
    background: #22c55e;
    color: var(--on-bright-color);
    border: 2px solid var(--on-bright-color);
    padding: 2px 8px;
    border-radius: 0;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .comment-content p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-color, #333);
    word-wrap: break-word;
  }

  .comment-actions {
    margin-top: 6px;
  }

  .reply-btn {
    background: none;
    border: 2px solid var(--primary-color);
    border-radius: 0;
    color: var(--primary-color);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    padding: 4px 10px;
    font-family: 'Roboto Mono', monospace;
  }

  .reply-btn:hover {
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
    text-decoration: none;
  }

  .is-root {
    padding: 16px 0;
  }
</style>
