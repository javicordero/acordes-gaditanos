---
interface Props {
  path?: string;
}

const { path = '/pedir-copla' } = Astro.props;
---

<div class='peticiones-stats' data-path={path}>
  <div class='stat'>
    <span class='stat__number' id='stats-total'>-</span>
    <span class='stat__label'>peticiones</span>
  </div>
  <div class='stat'>
    <span class='stat__number stat__number--completed' id='stats-completed'>-</span>
    <span class='stat__label'>completadas</span>
  </div>
</div>

<script>
  function initPeticionesStats() {
    document.querySelectorAll('.peticiones-stats').forEach(async (el) => {
      const pagePath = (el as HTMLElement).dataset.path || '/pedir-copla';
      const totalEl = el.querySelector('#stats-total');
      const completedEl = el.querySelector('#stats-completed');

      async function loadStats() {
        try {
          const { COMMENTS_CONFIG } = await import('../../lib/comments.ts');
          const res = await fetch(`${COMMENTS_CONFIG.workerUrl}/stats?path=${encodeURIComponent(pagePath)}`);
          const data = await res.json();
          if (totalEl) totalEl.textContent = data.total ?? '-';
          if (completedEl) completedEl.textContent = data.completed ?? '-';
        } catch {
          if (totalEl) totalEl.textContent = '-';
          if (completedEl) completedEl.textContent = '-';
        }
      }

      await loadStats();

      window.addEventListener('comment-added', () => {
        loadStats();
      });
    });
  }

  initPeticionesStats();
  document.addEventListener('astro:page-load', initPeticionesStats);
</script>

<style>
  .peticiones-stats {
    display: flex;
    gap: 24px;
    font-family: 'Roboto Mono', monospace;
  }

  .stat {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .stat__number {
    font-family: 'Roboto Mono', monospace;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--acorde-color);
    line-height: 1;
  }

  .stat__number--completed {
    color: var(--success-color);
  }

  .stat__label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary-color);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
</style>
