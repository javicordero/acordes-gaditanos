---
interface Props {
  path?: string;
  title?: string;
}

const { path = '/pedir-copla', title = 'Comentarios' } = Astro.props;
---

<section class='comments-section' data-path={path}>
  <h3 class='comments-title'>{title}</h3>
  <div class='comments-loading'>Cargando comentarios...</div>
  <div class='comments-list'></div>
  <div class='comments-empty' style='display:none'>
    <p>No hay comentarios aún. Sé el primero en comentar.</p>
  </div>
</section>

<style>
  .comments-section {
  }

  .comments-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--primary-color, #333);
    margin: 0 0 16px 0;
    position: relative;
    max-width: fit-content;

    &::after {
      content: '';
      display: block;
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 95%;
      height: 5px;
      background: var(--primary-contrast-color, #c2185b);
      border-radius: 0;
    }
  }

  .comments-loading {
    color: var(--secondary-color, #888);
    font-size: 0.9rem;
    padding: 16px 0;
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap-sm);
  }

  .comments-empty {
    color: var(--secondary-color, #888);
    font-size: 0.9rem;
    font-style: italic;
  }

  :global(.comment-item-wrapper) {
    padding-bottom: 8px;
    border-bottom: 2px solid var(--primary-color);
  }

  :global(.comment-header) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  :global(.comment-author) {
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--primary-color, #333);
  }

  :global(.comment-badge) {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 0;
    border: 2px solid var(--on-bright-color);
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  :global(.comment-badge--owner) {
    background: var(--primary-contrast-color, #c2185b);
    color: var(--on-bright-color);
    margin-right: 4px;
  }

  :global(.comment-badge--completed) {
    background: #22c55e;
    color: var(--on-bright-color);
  }

  :global(.comment-date) {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-secondary-color, #888);
  }

  :global(.comment-content) {
    margin-bottom: 4px;
  }

  :global(.comment-text) {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-color, #333);
    word-wrap: break-word;
  }

  :global(.comment-actions) {
    display: flex;
    gap: 12px;
  }

  :global(.reply-trigger-btn) {
    background: none;
    border: 2px solid var(--primary-color);
    border-radius: 0;
    color: var(--primary-color);
    font-size: 0.7rem;
    cursor: pointer;
    padding: 4px 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: 'Roboto Mono', monospace;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  :global(.reply-trigger-btn:hover) {
    background: transparent;
    color: var(--primary-color);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 0 var(--primary-contrast-color);
  }

  :global(.comment-vote-btn) {
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px 4px;
    font-size: 1rem;
    line-height: 1;
    color: var(--secondary-color, #888);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'Roboto Mono', monospace;
    transition: transform 0.15s ease;
  }

  :global(.comment-vote-btn:hover) {
    opacity: 0.7;
  }

  :global(.comment-vote-btn--animate) {
    animation: vote-pop 0.3s ease;
  }

  @keyframes vote-pop {
    0% { transform: scale(1); }
    40% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  :global(.comment-vote-btn--active) {
    color: var(--danger-color);
  }

  :global(.comment-vote-btn--active .heart-icon) {
    fill: var(--danger-color);
  }

  :global(.comment-votes-count) {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-secondary-color, #888);
    min-width: 12px;
  }

  :global(.top-peticiones) {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap-sm, 12px);
  }

  :global(.top-peticiones[hidden]) {
    display: none;
  }

  :global(.top-peticiones__list) {
    background: var(--card-background-color);
    border: 2px solid var(--primary-color);
    border-radius: 0;
    padding: 8px 16px;
  }

  :global(.top-peticiones__title) {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--primary-color, #333);
    margin: 0;
    position: relative;
    max-width: fit-content;
  }

  :global(.top-peticiones__title::after) {
    content: '';
    display: block;
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 95%;
    height: 5px;
    background: var(--primary-contrast-color, #c2185b);
    border-radius: 0;
  }

  :global(.top-peticiones__item) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 2px solid var(--primary-color);
    gap: 12px;
  }

  :global(.top-peticiones__item:last-child) {
    border-bottom: none;
  }

  :global(.top-peticiones__content) {
    font-size: 0.9rem;
    color: var(--text-color, #333);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.top-peticiones__votes) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.85rem;
    color: var(--danger-color);
    font-weight: 600;
    white-space: nowrap;
  }

  :global(.top-peticiones__empty) {
    color: var(--secondary-color, #888);
    font-size: 0.85rem;
    font-style: italic;
    margin: 0;
  }

  :global(.form-duplicate-warning) {
    background: var(--callout-bg);
    border: 2px solid var(--primary-contrast-color);
    border-left-width: 6px;
    padding: 10px 14px;
    margin-bottom: 8px;
    border-radius: 0;
    font-size: 0.8rem;
    color: var(--text-color);
    line-height: 1.5;
    text-wrap: balance;
  }
</style>

<script>
  type Comentario = {
    id: string;
    parentId?: string | null;
    author?: string;
    content: string;
    date: string;
    isAdmin?: boolean;
    completed?: boolean;
    votes?: number;
    votedBy?: string[];
  };

  function initCommentsSection() {
    document.querySelectorAll('.comments-section').forEach(async (section) => {
      if ((section as HTMLElement).dataset.loaded === 'true') return;
      (section as HTMLElement).dataset.loaded = 'true';

      const pagePath = (section as HTMLElement).dataset.path || '/pedir-copla';
      const loading = section.querySelector('.comments-loading') as HTMLElement;
      const list = section.querySelector('.comments-list') as HTMLElement;
      const empty = section.querySelector('.comments-empty') as HTMLElement;

      async function loadComments() {
        try {
          const { COMMENTS_CONFIG, getUserId } = await import('../../lib/comments.ts');
          const res = await fetch(`${COMMENTS_CONFIG.workerUrl}?path=${encodeURIComponent(pagePath)}`);
          const data = await res.json();
          const comments: Comentario[] = data.comments || [];

          loading.style.display = 'none';
          list.innerHTML = '';

          if (comments.length === 0) {
            empty.style.display = 'block';
            return;
          }

          empty.style.display = 'none';
          const userId = getUserId();
          renderComments(comments, list, null, 0, userId);
        } catch {
          loading.textContent = 'Error al cargar comentarios. Inténtalo de nuevo más tarde.';
        }
      }

      function renderComments(
        comments: Comentario[],
        container: HTMLElement,
        parentId: string | null,
        depth: number,
        userId: string
      ) {
        const children = comments.filter((c) => c.parentId === parentId);
        children.sort((a, b) => {
          const aCompleted = a.completed ? 1 : 0;
          const bCompleted = b.completed ? 1 : 0;
          if (aCompleted !== bCompleted) return aCompleted - bCompleted;
          return new Date(b.date).getTime() - new Date(a.date).getTime();
        });

        for (const comment of children) {

          const el = document.createElement('div');
          el.className = 'comment-item-wrapper';
          el.style.marginLeft = `${depth * 24}px`;

          const displayName = comment.isAdmin ? '' : (comment.author && comment.author.trim() ? comment.author.trim() : 'Anónimo');
          const date = new Date(comment.date);
          const dateStr = `${String(date.getDate()).padStart(2, '0')}/${String(date.getMonth() + 1).padStart(2, '0')}/${date.getFullYear()} ${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`;
          const isRoot = !comment.parentId;
          const votes = comment.votes ?? 0;
          const votedBy = comment.votedBy ?? [];
          const hasVoted = votedBy.includes(userId);

          // Se crean nodos y el nombre va con `textContent`/`dataset`: el
          // navegador no lo parsea, así que un autor con HTML se ve tal cual.
          el.appendChild(crearCabecera(comment, displayName, dateStr));
          el.appendChild(crearContenido(comment.content));
          el.appendChild(crearAcciones(comment, displayName, isRoot, votes, hasVoted));

          container.appendChild(el);

          // Render children
          renderComments(comments, container, comment.id, depth + 1, userId);
        }
      }

      function crear(tag: string, clase = '', texto: string | null = null) {
        const el = document.createElement(tag);
        if (clase) el.className = clase;
        if (texto !== null) el.textContent = texto;
        return el;
      }

      function crearCabecera(comment: Comentario, displayName: string, dateStr: string) {
        const header = crear('div', 'comment-header');
        const autor = crear('span', 'comment-author');
        if (comment.isAdmin) {
          autor.appendChild(crear('span', 'comment-badge comment-badge--owner', 'Propietario'));
        }
        autor.appendChild(document.createTextNode(displayName));
        header.appendChild(autor);
        header.appendChild(crear('span', 'comment-date', dateStr));
        if (comment.completed) {
          header.appendChild(crear('span', 'comment-badge comment-badge--completed', 'Completada'));
        }
        return header;
      }

      function crearContenido(texto: string) {
        const contenido = crear('div', 'comment-content');
        contenido.appendChild(crear('p', 'comment-text', texto));
        return contenido;
      }

      function crearAcciones(
        comment: Comentario,
        displayName: string,
        isRoot: boolean,
        votes: number,
        hasVoted: boolean
      ) {
        const acciones = crear('div', 'comment-actions');

        if (isRoot) {
          const votar = document.createElement('button');
          votar.type = 'button';
          votar.className = `comment-vote-btn${hasVoted ? ' comment-vote-btn--active' : ''}`;
          votar.dataset.commentId = comment.id;
          votar.dataset.votes = String(votes);
          votar.setAttribute('aria-label', 'Votar');
          votar.appendChild(corazon(hasVoted ? 'currentColor' : 'none'));
          votar.appendChild(crear('span', 'comment-votes-count', String(votes)));
          acciones.appendChild(votar);
        }

        const responder = crear('button', 'reply-trigger-btn', 'Responder') as HTMLButtonElement;
        responder.type = 'button';
        responder.dataset.commentId = comment.id;
        responder.dataset.author = displayName;
        acciones.appendChild(responder);

        return acciones;
      }

      function corazon(relleno: string) {
        const NS = 'http://www.w3.org/2000/svg';
        const svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('class', 'heart-icon');
        svg.setAttribute('width', '16');
        svg.setAttribute('height', '16');
        svg.setAttribute('viewBox', '0 0 24 24');
        svg.setAttribute('fill', relleno);
        svg.setAttribute('stroke', 'currentColor');
        svg.setAttribute('stroke-width', '2');
        const path = document.createElementNS(NS, 'path');
        path.setAttribute(
          'd',
          'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'
        );
        svg.appendChild(path);
        return svg;
      }

      // Handle vote button clicks
      section.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('.comment-vote-btn');
        if (!btn) return;

        const commentId = btn.dataset.commentId;
        if (!commentId) return;

        const { COMMENTS_CONFIG, getUserId } = await import('../../lib/comments.ts');
        const userId = getUserId();
        const isActive = btn.classList.contains('comment-vote-btn--active');
        const action = isActive ? 'unvote' : 'vote';

        try {
          const res = await fetch(`${COMMENTS_CONFIG.workerUrl}/vote`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ commentId, action, userId }),
          });

          const data = await res.json();

          if (!res.ok) {
            if (res.status === 409 && data.error === 'Already voted') {
              btn.classList.add('comment-vote-btn--active');
            }
            return;
          }

          const { comment, hasVoted } = data;
          const heartIcon = btn.querySelector('.heart-icon') as SVGElement;
          const votesCount = btn.querySelector('.comment-votes-count') as HTMLElement;

          if (hasVoted) {
            btn.classList.add('comment-vote-btn--active');
            if (heartIcon) heartIcon.setAttribute('fill', 'currentColor');
          } else {
            btn.classList.remove('comment-vote-btn--active');
            if (heartIcon) heartIcon.setAttribute('fill', 'none');
          }

          // Trigger animation
          btn.classList.remove('comment-vote-btn--animate');
          void btn.offsetWidth;
          btn.classList.add('comment-vote-btn--animate');

          if (votesCount) {
            votesCount.textContent = String(comment.votes ?? 0);
          }

          btn.dataset.votes = String(comment.votes ?? 0);

          // Update top peticiones if visible
          const topSection = document.querySelector('.top-peticiones');
          if (topSection && typeof (window as any).__reloadTopPeticiones === 'function') {
            (window as any).__reloadTopPeticiones();
          }
        } catch {
          // Silently fail
        }
      });

      // Handle reply button clicks
      section.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('.reply-trigger-btn');
        if (!btn) return;

        const commentId = btn.dataset.commentId;
        const autorNombre = btn.dataset.author || 'Anónimo';

        // Remove existing reply forms
        section.querySelectorAll('.reply-form-container').forEach((f) => f.remove());

        const replyContainer = document.createElement('div');
        replyContainer.className = 'reply-form-container';

        // El formulario también se crea con nodos: el nombre del autor no
        // puede acabar dentro de un atributo interpolado en HTML.
        const form = crear('form', 'comment-form') as HTMLFormElement;
        if (commentId) form.dataset.parentId = commentId;

        const authorInput = crear('input', 'comment-author-input') as HTMLInputElement;
        authorInput.type = 'text';
        authorInput.placeholder = 'Nombre (opcional)';
        authorInput.maxLength = 50;
        authorInput.setAttribute('aria-label', 'Nombre');

        const contentInput = crear('textarea', 'comment-content-input') as HTMLTextAreaElement;
        contentInput.placeholder = `Respondiendo a ${autorNombre}...`;
        contentInput.rows = 3;
        contentInput.maxLength = 1000;
        contentInput.setAttribute('aria-label', 'Comentario');
        contentInput.required = true;

        const formActions = crear('div', 'form-actions');
        const cancelReplyBtn = crear('button', 'cancel-reply-btn', 'Cancelar') as HTMLButtonElement;
        cancelReplyBtn.type = 'button';
        const submitBtn = crear('button', 'submit-btn', 'Enviar') as HTMLButtonElement;
        submitBtn.type = 'submit';
        const status = crear('div', 'form-status');
        status.setAttribute('aria-live', 'polite');
        formActions.append(cancelReplyBtn, submitBtn, status);

        form.append(authorInput, contentInput, formActions);
        replyContainer.appendChild(form);

        btn.closest('.comment-item-wrapper')?.after(replyContainer);

        cancelReplyBtn.addEventListener('click', () => replyContainer.remove());

        form.addEventListener('submit', async (ev) => {
          ev.preventDefault();
          const content = contentInput.value.trim();
          if (!content) {
            status.textContent = 'El comentario no puede estar vacío';
            status.className = 'form-status error';
            return;
          }

          submitBtn.disabled = true;
          status.textContent = 'Enviando...';
          status.className = 'form-status';

          try {
            const { COMMENTS_CONFIG } = await import('../../lib/comments.ts');
            const adminToken = localStorage.getItem('adminToken');
            const headers: Record<string, string> = { 'Content-Type': 'application/json' };
            if (adminToken) headers['Authorization'] = `Bearer ${adminToken}`;
            const res = await fetch(COMMENTS_CONFIG.workerUrl, {
              method: 'POST',
              headers,
              body: JSON.stringify({
                path: pagePath,
                author: authorInput.value.trim() || '',
                content,
                parentId: commentId,
              }),
            });

            if (!res.ok) {
              const data = await res.json();
              throw new Error(data.error || 'Error al enviar');
            }

            replyContainer.remove();
            (section as HTMLElement).dataset.loaded = 'false';
            list.innerHTML = '';
            initCommentsSection();
          } catch (err) {
            status.textContent = err instanceof Error ? err.message : 'Error al enviar';
            status.className = 'form-status error';
            submitBtn.disabled = false;
          }
        });
      });

      // Store reload function on section for external access
      (section as HTMLElement).__reloadComments = () => {
        list.innerHTML = '';
        loadComments();
      };

      await loadComments();
    });
  }

  function setupGlobalListener() {
    if ((window as any).__commentsListenerSetup) return;
    (window as any).__commentsListenerSetup = true;

    window.addEventListener('comment-added', () => {
      document.querySelectorAll('.comments-section').forEach((section) => {
        const reload = (section as HTMLElement).__reloadComments;
        if (typeof reload === 'function') reload();
      });
    });
  }

  initCommentsSection();
  setupGlobalListener();
  document.addEventListener('astro:page-load', initCommentsSection);
</script>
