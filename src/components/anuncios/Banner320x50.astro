---
// Banner320X502.astro
const { adKey } = Astro.props;
---

<div class='adsterra-slot mobile-only adsterra-320'>
  <div class='adsterra-wrapper' id={`wrap-${adKey}`}>
    <div id={`container-${adKey}`}></div>
  </div>
</div>

<script is:inline define:vars={{ adKey }}>
  const injectAd = () => {
    const container = document.getElementById(`container-${adKey}`);
    if (!container) return;

    // LIMPIEZA: Eliminamos cualquier anuncio anterior antes de crear el nuevo
    while (container.firstChild) {
      container.removeChild(container.firstChild);
    }

    // Reset de variables globales para evitar conflictos
    window.atOptions = undefined;

    const iframe = document.createElement('iframe');
    iframe.style.border = 'none';
    iframe.style.width = '320px';
    iframe.style.height = '50px';
    iframe.style.margin = '0';
    iframe.style.padding = '0';
    iframe.style.overflow = 'hidden';
    iframe.scrolling = 'no';

    container.appendChild(iframe);

    const adCode = `
          <html>
            <head>
              <meta name="referrer" content="no-referrer">
            </head>
            <body style="margin:0;padding:0;display:flex;justify-content:center;align-items:center;">
              <script type="text/javascript">
                var atOptions = {
                  'key' : '${adKey}',
                  'format' : 'iframe',
                  'height' : 50,
                  'width' : 320,
                  'params' : {}
                };
              <\/script>
              <script type="text/javascript" src="https://www.highperformanceformat.com/${adKey}/invoke.js"><\/script>
            </body>
          </html>
        `;

    const doc = iframe.contentWindow.document;
    doc.open();
    doc.write(adCode);
    doc.close();
  };

  // Carga inicial para la primera visita
  injectAd();

  // Re-carga limpia para View Transitions de Astro
  document.addEventListener('astro:page-load', injectAd);
</script>

<style>
  .adsterra-wrapper {
    width: 320px;
    height: 50px;
    margin-top: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>
