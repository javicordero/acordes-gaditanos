---
// Banner468x60.astro
const { adKey } = Astro.props;
---

<div class='adsterra-slot adsterra-468 desktop-only'>
  <div class='adsterra-wrapper-468' id={`wrap-${adKey}`}>
    <div id={`container-${adKey}`}></div>
  </div>
</div>

<script is:inline define:vars={{ adKey }}>
  const injectBanner468Dynamic = () => {
    const container = document.getElementById(`container-${adKey}`);
    if (!container) return;

    // SOLUCIÓN OPCIÓN 2: Limpieza total antes de inyectar
    // Si ya existe un iframe (de una navegación anterior), lo eliminamos
    while (container.firstChild) {
      container.removeChild(container.firstChild);
    }

    // Reset de la variable global por si acaso quedó rastro en window
    window.atOptions = undefined;

    const iframe = document.createElement('iframe');
    iframe.style.border = 'none';
    iframe.style.width = '468px';
    iframe.style.height = '60px';
    iframe.style.margin = '0';
    iframe.style.padding = '0';
    iframe.style.overflow = 'hidden';
    iframe.scrolling = 'no';

    container.appendChild(iframe);

    const adCode = `
        <html>
          <head>
            <meta name="referrer" content="no-referrer">
          </head>
          <body style="margin:0;padding:0;display:flex;justify-content:center;">
            <script type="text/javascript">
              var atOptions = {
                'key' : '${adKey}',
                'format' : 'iframe',
                'height' : 60,
                'width' : 468,
                'params' : {}
              };
            <\/script>
            <script type="text/javascript" src="https://www.highperformanceformat.com/${adKey}/invoke.js"><\/script>
          </body>
        </html>
      `;

    const doc = iframe.contentWindow.document;
    doc.open();
    doc.write(adCode);
    doc.close();
  };

  // Carga inicial
  injectBanner468Dynamic();

  // Reinyección limpia en cada cambio de página de Astro
  document.addEventListener('astro:page-load', injectBanner468Dynamic);
</script>

<style>
  .adsterra-wrapper-468 {
    width: 468px;
    height: 60px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  @media (max-width: 500px) {
    .adsterra-wrapper-468 {
      width: 100%;
      height: 45px;
    }

    .adsterra-wrapper-468 :global(iframe) {
      transform: scale(0.65);
      transform-origin: center;
    }
  }
</style>
