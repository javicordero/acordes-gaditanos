---
const { class: className } = Astro.props;
---

<div class:list={['fab-container', className]}>
  <a href='/pedir-copla' class='fab' aria-label='Pedir una copla'>
    <span class='fab-text'>Pedir una copla</span>
  </a>
</div>

<style>
  .fab-container {
    position: fixed;
    bottom: 24px;
    width: 90%;
    max-width: var(--app-max-width);
    margin: auto;
    z-index: 1000;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
    transform: translateX(8px);
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  .fab-container.hidden {
    display: none;
  }

  .fab {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 16px;
    border: 2px solid var(--on-bright-color);
    border-radius: 0;
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
    text-decoration: none;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 0 var(--on-bright-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
    white-space: nowrap;
    pointer-events: auto;
  }

  .fab:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--on-bright-color);
  }

  @media (min-width: 640px) {
    .fab-container {
      width: 95%;
    }
  }

  @media (max-width: 640px) {
    .fab-container {
      bottom: 16px;
    }

    .fab {
      padding: 8px 12px;
      font-size: 0.75rem;
      letter-spacing: 0.5px;
    }
  }
</style>

<script>
  function initFAB() {
    const container = document.querySelector('.fab-container');
    if (!container) return;

    localStorage.removeItem('fab-pedir-copla-closed');
    container.classList.remove('hidden');
  }

  initFAB();
  document.addEventListener('astro:page-load', initFAB);
</script>
