---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'

export interface Props {
  variant?: 'compact' | 'timeline'
  class?: string
  messageC?: string
  listStyle?: 'inline' | 'destacado' | 'pills' | 'rotativo'
}

const { variant = 'compact', class: className, messageC, listStyle = 'inline' } = Astro.props

// La colección vive en `src/content/donaciones/datos.md`. Si el archivo no está
// (o Astro aún no la ha cargado), `getCollection` devuelve []: se cae al estado
// vacío en vez de romper la página entera con un `datos.data` sobre undefined.
const [datos] = await getCollection('donaciones')
const donaciones = [...(datos?.data.donaciones ?? [])]
  .sort((a, b) => b.fecha.split('/').reverse().join('').localeCompare(a.fecha.split('/').reverse().join('')))

const totalDonantes = donaciones.length
const nombres = donaciones.map(d => d.donante || 'Anónimo')
---

<section class:list={['donation-indicator', variant, className]} aria-label='Indicador de donaciones'>
  {totalDonantes === 0 ? (
    <div class='donation-indicator--empty'>
      <p>Se el primero en apoyar el proyecto</p>
    </div>
  ) : (
    <>
      <div class='donation-indicator__widget'>
        {messageC && <p class='donation-indicator__message-c'>{messageC}</p>}
        <div class='donation-indicator__count'>{totalDonantes} <span class='donation-indicator__count-label'>personas ya han colaborado</span></div>
        {listStyle === 'destacado' && (
          <>
            <div class='donation-indicator__destacado'>
              <span class='destacado-label'>Último</span>
              <span class='destacado-name'>{nombres[0]}</span>
            </div>
            {nombres.slice(1).length > 0 && (
              <p class='donation-indicator__names donation-indicator__names--rest'>
                {nombres.slice(1).join(' · ')}
              </p>
            )}
          </>
        )}
        {listStyle === 'pills' && (
          <div class='donation-indicator__pills'>
            {nombres.map(name => (
              <span class='pill'>
                <svg class='pill__icon' width='12' height='14' viewBox='0 0 24 28' fill='currentColor'><path d='M4 8h16v9a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8z'/><path d='M10 2v3M14 2v3' stroke='currentColor' stroke-width='2' fill='none'/></svg>
                {name}
              </span>
            ))}
          </div>
        )}
        {listStyle === 'rotativo' && (
          <div class='donation-indicator__rotativo' data-rotador>
            <span class='rotativo__etiqueta'>Gracias a</span>
            <span class='rotativo__pista'>
              {nombres.map((name, i) => (
                <span class:list={['rotativo__nombre', { 'is-activo': i === 0 }]} data-rotador-nombre>
                  {name}
                </span>
              ))}
            </span>
          </div>
        )}
        {listStyle === 'inline' && (
          <p class='donation-indicator__names'>
            {nombres.join(' · ')}
          </p>
        )}
        <a href='https://www.buymeacoffee.com/AcordesGaditanos' target='_blank' rel='noopener noreferrer' class='btn' data-ga-event='support_bmc_donation_indicator' data-ga-params='{"method":"buymeacoffee","location":"donation_indicator"}'>
          <span class='btn__icon'>
            <Icon name='buy-me-a-coffee' width={20} height={28} />
          </span>
          <span class='btn__text'>Apoyar Acordes Gaditanos</span>
        </a>
      </div>
    </>
  )}
</section>

<style>
  .donation-indicator {
    font-family: 'Roboto Mono', monospace;
  }

  .donation-indicator__widget {
    border: 2px solid var(--primary-color);
    border-radius: 0;
    padding: 16px;
    background: var(--card-background-color);
  }

  :global(.compact) .donation-indicator__widget {
    border: none;
    border-radius: 0;
    padding: 0;
    background: none;
  }

  :global(.timeline) .donation-indicator__widget {
    width: 100%;
    border: none;
    border-radius: 0;
    background: #0003;
    /* backdrop-filter: blur(16px) saturate(160%) brightness(1.08); */
    box-shadow:
      6px 6px 0 0 #000,
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06);

    @media (max-width: 640px) {
      padding: 12px;
    }
  }

  .donation-indicator__message-c {
    font-size: 0.78rem;
    color: var(--text-secondary-color);
    margin: 0 0 6px;
    line-height: 1.3;
  }

  :global(.timeline) .donation-indicator__message-c {
    font-size: 0.9rem;
    color: #fff;
  }

  /* En móvil el texto va justo: se aprieta un pelín para que quepa en una
     línea y no robe altura al hero. */
  @media (max-width: 640px) {
    .donation-indicator__message-c,
    :global(.timeline) .donation-indicator__message-c {
      font-size: 0.85rem;
      letter-spacing: -0.015em;
      word-spacing: -0.05em;
    }
  }

  .donation-indicator__count {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--acorde-color);
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .donation-indicator__count-label {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  :global(.timeline) .donation-indicator__count {
    font-size: 1.6rem;
    color: var(--primary-contrast-color);
  }

  :global(.timeline) .donation-indicator__count-label {
    font-size: 0.85rem;
    color: #fff;
  }

  .donation-indicator__names {
    font-size: 0.85rem;
    color: var(--text-secondary-color);
    margin: 0 0 12px;
    line-height: 1.6;
  }

  :global(.timeline) .donation-indicator__names {
    color: rgba(255, 255, 255, 0.7);
  }

  .donation-indicator__name-more {
    font-style: italic;
    opacity: 0.7;
  }

  .donation-indicator__destacado {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .destacado-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-secondary-color);
  }

  .destacado-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--acorde-color);
  }

  :global(.timeline) .destacado-label {
    color: rgba(255, 255, 255, 0.5);
  }

  :global(.timeline) .destacado-name {
    color: var(--primary-contrast-color);
  }

  .donation-indicator__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 0;
    font-size: 0.75rem;
    color: var(--primary-contrast-color);
    border: 2px solid rgba(252, 163, 17, 0.35);
    background: transparent;
  }

  :global(.compact) .pill {
    color: var(--acorde-color);
    border-color: rgba(0, 68, 204, 0.3);
  }

  .pill__icon {
    flex-shrink: 0;
  }

  .pill--more {
    font-style: italic;
    background: transparent;
    color: var(--text-secondary-color);
  }

  :global(.timeline) .pill {
    font-size: 0.8rem;
    color: var(--primary-contrast-color);
    border-color: rgba(252, 163, 17, 0.35);
    background: transparent;
  }

  :global(.timeline) .pill--more {
    color: rgba(255, 255, 255, 0.6);
    background: transparent;
  }

  /* Rotativo: un donante cada vez, más grande y con entrada/salida animada.
     La altura es fija (una línea) para que el bloque no cambie de tamaño. */
  .donation-indicator__rotativo {
    margin-bottom: 6px;
  }

  /* El script baraja los nombres al arrancar. Hasta entonces no se pinta el
     bloque, para que no se vea un parpadeo del primer donante de la lista.
     Sin JS (o en navegadores sin `scripting`) se queda visible como siempre. */
  @media (scripting: enabled) {
    .donation-indicator__rotativo:not([data-rotador-iniciado]) {
      visibility: hidden;
    }
  }

  .rotativo__etiqueta {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-secondary-color);
    margin-bottom: 2px;
  }

  .rotativo__pista {
    position: relative;
    display: block;
    height: 1.5em;
    font-size: clamp(1.1rem, 4.4vw, 1.5rem);
    line-height: 1.5;
  }

  .rotativo__nombre {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: var(--acorde-color);
    opacity: 0;
    transform: translateY(0.45em);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .rotativo__nombre.is-activo {
    opacity: 1;
    transform: translateY(0);
  }

  .rotativo__nombre.is-saliendo {
    opacity: 0;
    transform: translateY(-0.45em);
  }

  :global(.timeline) .rotativo__etiqueta {
    color: rgba(255, 255, 255, 0.55);
  }

  :global(.timeline) .rotativo__nombre {
    color: var(--primary-contrast-color);
  }

  @media (prefers-reduced-motion: reduce) {
    .rotativo__nombre {
      transition: none;
    }
  }

  .donation-indicator .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 14px;
    border: none;
    border-radius: 0;
    text-decoration: none;
    color: var(--on-acorde-solid-color);
    background-color: var(--acorde-solid-color);
    font-family: 'Roboto Mono', monospace;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    min-height: 44px;
    box-shadow: 4px 4px 0 0 var(--on-bright-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .donation-indicator .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--on-bright-color);
  }

  .donation-indicator .btn:active {
    transform: translate(0, 0);
    box-shadow: 2px 2px 0 0 var(--on-bright-color);
  }

  .donation-indicator .btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    line-height: 1;
  }

  .donation-indicator .btn__icon :global(svg) {
    width: 20px;
    height: 28px;
  }

  .donation-indicator .btn__text {
    font-size: 14px;
    letter-spacing: 1.25px;
  }

  .donation-indicator--empty p {
    font-size: 0.85rem;
    color: var(--text-secondary-color);
    margin: 0 0 12px;
  }

  :global(.timeline) .donation-indicator--empty p {
    color: rgba(255, 255, 255, 0.7);
  }

  .donation-indicator:global(.compact) .btn,
  .donation-indicator:global(.timeline) .btn {
    width: 100%;
  }

  .donation-indicator:global(.timeline) .btn__text {
    font-size: 16px;
  }
</style>

<script>
  function setupTracking() {
    const trackableButtons = document.querySelectorAll('.donation-indicator [data-ga-event]')
    trackableButtons.forEach((button) => {
      if (button.getAttribute('data-tracking-init')) return
      button.setAttribute('data-tracking-init', 'true')

      button.addEventListener('click', () => {
        if (typeof gtag === 'function') {
          const eventName = button.getAttribute('data-ga-event')
          const eventParams = JSON.parse(button.getAttribute('data-ga-params') || '{}')
          gtag('event', eventName, {
            ...eventParams,
            page_location: window.location.href,
          })
        }
      })
    })
  }

  // Rotativo de donantes: pasa uno cada 2 s. Se para al pasar el ratón o al
  // enfocar (para poder leerlo) y con prefers-reduced-motion se queda quieto.
  // Los nombres se barajan en cada visita para que no empiece siempre el mismo.
  function barajar<T>(lista: T[]) {
    for (let i = lista.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[lista[i], lista[j]] = [lista[j], lista[i]]
    }
    return lista
  }

  function iniciarRotadores() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)')

    document.querySelectorAll<HTMLElement>('[data-rotador]').forEach((cont) => {
      if (cont.dataset.rotadorIniciado) return
      const nombres = barajar(Array.from(cont.querySelectorAll<HTMLElement>('[data-rotador-nombre]')))
      if (nombres.length === 0) return
      cont.dataset.rotadorIniciado = 'true'
      if (nombres.length < 2) return

      // El `is-activo` viene en el primero del HTML: se pasa al primero barajado.
      nombres.forEach((nombre) => nombre.classList.remove('is-activo', 'is-saliendo'))
      nombres[0].classList.add('is-activo')

      let actual = 0
      let timer: number | null = null

      const mostrar = (siguiente: number) => {
        const previo = nombres[actual]
        actual = siguiente
        previo.classList.remove('is-activo')
        previo.classList.add('is-saliendo')
        nombres[actual].classList.remove('is-saliendo')
        nombres[actual].classList.add('is-activo')
        window.setTimeout(() => previo.classList.remove('is-saliendo'), 350)
      }

      const arrancar = () => {
        if (timer !== null || reduce.matches) return
        timer = window.setInterval(() => mostrar((actual + 1) % nombres.length), 2000)
      }

      const parar = () => {
        if (timer !== null) window.clearInterval(timer)
        timer = null
      }

      const widget = cont.closest('.donation-indicator')
      if (widget) {
        widget.addEventListener('mouseenter', parar)
        widget.addEventListener('mouseleave', arrancar)
        widget.addEventListener('focusin', parar)
        widget.addEventListener('focusout', arrancar)
      }

      if (reduce.addEventListener) {
        reduce.addEventListener('change', () => (reduce.matches ? parar() : arrancar()))
      }

      arrancar()
    })
  }

  function setup() {
    setupTracking()
    iniciarRotadores()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup)
  } else {
    setup()
  }
  document.addEventListener('astro:page-load', setup)
</script>
