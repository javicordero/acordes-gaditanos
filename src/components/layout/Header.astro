---
import Logo from '../../../public/icons/logo.svg';
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import SugerenciasBusqueda from './SugerenciasBusqueda.astro';
---

<header role='banner' transition:name='site-header'>
  <div class='container-layout nav-bar-container'>
    <div class='branding'>
      <picture>
        <a href='/' aria-label='Inicio' id='logo-link'>
          <img
            src={Logo.src}
            alt='Acordes Gaditanos logo'
            transition:persist
            decoding='async'
            width={48}
            height={48}
            fetchpriority='high'
          />
        </a>
      </picture>
      <h1 class='branding-title' transition:persist>
        <a href='/' id='title-link'>Acordes Gaditanos</a>
      </h1>
    </div>

    <div class='right-controls'>
      <div class='search-container'>
        <button class='search-toggle' aria-label='Abrir búsqueda' type='button'>
          <Icon name='lupa' width={30} height={30} />
        </button>

        <form class='search-form' role='search' action='/buscar' method='get'>
          <div class='search-wrapper collapsed'>
            <input
              type='text'
              id='header-search'
              name='q'
              placeholder='Buscar acordes...'
              aria-label='Buscar acordes'
              autocomplete='off'
            />
            <button class='clear-search' aria-label='Borrar búsqueda' type='button' hidden>
              <Icon name='cruz' width={24} height={24} />
            </button>
          </div>
        </form>

        <SugerenciasBusqueda />
      </div>

      <div class='theme-container'>
        <ThemeToggle />
      </div>

      <button
        class='menu-toggle'
        aria-expanded='false'
        aria-controls='primary-menu'
        aria-label='Abrir menú'>
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav id='primary-menu' aria-label='Main navigation'>
    <ul>
      <li><a href='/'>Inicio</a></li>
      <li><a href='/pedir-copla'>Pedir copla</a></li>
      <li><a href='/lista'>Todas las coplas</a></li>
      <li><a href='/autores'>Autores Destacados</a></li>
      <li><a href='/glosario'>Glosario de acordes</a></li>
      <li><a href='/colaborar'>Colaborar</a></li>
      <li><a href='/contacto'>Contacto</a></li>
      <!-- <li><a href='/about'>Sobre nosotros</a></li> -->
    </ul>
  </nav>
</header>

<style>
  /* Header principal */
  header {
    height: var(--nav-height);
    width: 100%;
    position: fixed;
    top: 0;
    z-index: 9999;
    background-color: var(--surface-color);
    border-bottom: 4px solid var(--primary-contrast-color);
  }

  /* Container principal del nav-bar */
  .nav-bar-container {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    padding: 0 4px;
  }

  /* Branding (logo y título) */
  .branding {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    &.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    & picture {
      position: relative;
      top: 2px;
    }

    & img {
      border-radius: 40px;
      height: 29px;
      padding: 3px;
      width: auto;
      background-color: var(--primary-contrast-color);
    }

    & h1 {
      position: relative;
      bottom: 1px;
      font-family: 'Bodoni', serif;
      white-space: nowrap;
      max-width: 20px;
      transition:
        opacity 0.3s ease,
        visibility 0.3s ease;
      &.is-hidden {
        opacity: 0;
        visibility: hidden;
      }

      & a {
        text-decoration: none;
        font-size: 1.5rem;
        color: var(--primary-contrast-color);
        font-weight: bold;
      }
    }
  }

  /* Controles de la derecha (búsqueda + menú) */
  .right-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Container de búsqueda */
  .search-container {
    display: flex;
    align-items: center;
    position: relative;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .search-container.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Formulario de búsqueda (navegación nativa a /buscar?q=...) */
  .search-form {
    display: flex;
    align-items: center;
    margin: 0;
  }

  /* Container del botón de tema */
  .theme-container {
    display: flex;
    align-items: center;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .theme-container.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Botón de lupa */
  .search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: max-content;
    height: max-content;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: transform 0.5s ease;
    color: var(--primary-contrast-color);
    opacity: 1;

    &:hover {
      transform: translate(-2px, -2px);
    }
  }

  .search-toggle.hidden {
    width: 0;
    opacity: 0;
    pointer-events: none;
    padding: 0;
  }

  /* Wrapper del input de búsqueda */
  .search-wrapper {
    position: relative;
    width: 250px;
    overflow: hidden;
    transition:
      width 0.3s ease,
      opacity 0.3s ease;
    opacity: 1;
  }

  .search-wrapper.collapsed {
    width: 0;
    opacity: 0;
    pointer-events: none;
  }

  /* Input de búsqueda */
  #header-search {
    width: 100%;
    padding: 8px 36px 8px 12px;
    font-size: 0.9rem;
    border: 2px solid var(--primary-contrast-color);
    border-radius: 0;
    background: var(--card-background-color);
    color: var(--text-color);
    transition: all 0.2s ease;

    &:focus {
      background: var(--card-background-color);
      outline: 3px solid var(--primary-contrast-color);
      outline-offset: 1px;
    }

    &::placeholder {
      color: var(--placeholder-color);
      opacity: 1;
    }
  }

  /* Botón de limpiar búsqueda (cruz) */
  .clear-search {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    padding: 4px;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    color: var(--primary-contrast-color);
    transition: all 0.2s ease;

    &:hover {
      color: var(--on-surface-color);
    }
  }

  .clear-search[hidden] {
    display: none;
  }

  /* Botón menú hamburguesa */
  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    --bar-h: 4px;
    height: 24px;
    width: 32px;
    cursor: pointer;
    transition: transform 0.5s ease;
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    z-index: 2;

    &:hover {
      transform: translate(-1px, -1px);
    }

    & span {
      display: block;
      position: absolute;
      left: 0;
      width: 100%;
      height: var(--bar-h);
      border-radius: 0;
      background: var(--primary-contrast-color);
      transition:
        transform 0.4s ease-in-out,
        top 0.3s ease-in-out;
      transform-origin: center;
    }

    & span:nth-child(1) {
      top: 0;
    }

    & span:nth-child(2) {
      top: calc(50% - var(--bar-h) / 2);
    }

    & span:nth-child(3) {
      top: calc(100% - var(--bar-h));
    }
  }

  /* Navegación principal */
  nav {
    padding-top: 120px;
    background-color: var(--surface-color);
    height: 100vh;
    width: 100%;
    transform: translate(-150%);
    display: flex;
    flex-direction: column;
    transition: transform 0.5s ease-in-out;
    text-align: center;

    & ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
      align-items: center;
    }

    & a {
      text-decoration: none;
      color: var(--primary-contrast-color);
      font-family: 'Roboto Mono', monospace;
      font-weight: 800;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      font-size: 1.5rem;
      position: relative;
      display: inline-block;

      &::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -3px;
        height: 3px;
        width: 95%;
        background: var(--primary-contrast-color);
        transform-origin: left;
        transform: scaleX(0);
        transition: transform 0.3s ease;
      }

      &:hover::after,
      &:focus-visible::after {
        transform: scaleX(1);
      }
    }
  }

  /* Estados del menú hamburguesa abierto */
  nav.is-open {
    transform: translateX(0);
  }

  .menu-toggle.is-open span:nth-child(1) {
    top: calc(50% - var(--bar-h) / 2);
    transform: rotate(45deg);
  }

  .menu-toggle.is-open span:nth-child(2) {
    transform: scaleX(0);
  }

  .menu-toggle.is-open span:nth-child(3) {
    top: calc(50% - var(--bar-h) / 2);
    transform: rotate(-45deg);
  }

  /* Media queries - Responsive */
  @media (max-width: 640px) {
    /* Ocultar header al hacer scroll hacia abajo (reaparece al subir) */
    header {
      transition: transform 0.3s ease;
      will-change: transform;
    }

    header.header-hidden {
      transform: translateY(-100%);
    }

    .nav-bar-container {
      width: 95%;
      padding: 0;
    }

    .menu-toggle {
      height: 20px;
      width: 28px;
      --bar-h: 3px;
    }

    .branding h1 {
      bottom: 2px;
      & a {
        font-size: 1.2rem;
      }
    }

    .branding img {
      height: 28px;
    }

    .right-controls {
      gap: 8px;
      min-width: 0;
    }

    /* Tema y menú nunca se comprimen ni salen de pantalla */
    .theme-container,
    .menu-toggle {
      flex-shrink: 0;
    }

    /* El buscador ocupa solo el espacio libre que queda */
    .search-form {
      min-width: 0;
    }

    .search-wrapper {
      width: 100%;
      min-width: 0;
    }

    .search-wrapper.collapsed {
      width: 0;
    }

    /* Con el buscador abierto, ocupa todo el hueco y no empuja tema/menú */
    header.is-search-open .right-controls {
      flex: 1;
      min-width: 0;
    }

    header.is-search-open .search-container {
      flex: 1;
      min-width: 0;
    }

    header.is-search-open .search-form {
      flex: 1;
    }

    .search-toggle {
      & svg {
        width: 24px;
        height: 24px;
      }
    }

    #header-search {
      padding: 6px 32px 6px 10px;
      font-size: 0.85rem;
    }
  }
</style>

<style is:global>
  ::view-transition-group(site-header) {
    z-index: 9999;
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector('header');
    const toggle = document.querySelector('.menu-toggle');
    const nav = document.querySelector('#primary-menu');
    const branding = document.querySelector('.branding');
    const brandingTitle = document.querySelector('.branding-title');
    const searchContainer = document.querySelector('.search-container');
    const themeContainer = document.querySelector('.theme-container');
    const searchInput = document.querySelector('#header-search');
    const clearButton = document.querySelector('.clear-search');
    const searchToggle = document.querySelector('.search-toggle');
    const searchWrapper = document.querySelector('.search-wrapper');
    const searchForm = document.querySelector('.search-form');

    if (!toggle || !nav || !branding) return;

    // Ocultar header al hacer scroll hacia abajo en móvil (reaparece al subir)
    if (header) {
      const mobileQuery = window.matchMedia('(max-width: 640px)');
      const HIDE_AFTER = 80; // px de scroll antes de empezar a ocultar
      const DELTA = 6; // px mínimos para evitar parpadeo en el rubber-band
      let lastScrollY = window.scrollY;
      let ticking = false;

      const updateHeaderOnScroll = () => {
        ticking = false;
        if (!mobileQuery.matches) return;

        const y = window.scrollY;
        const diff = y - lastScrollY;

        const isMenuOpen = nav.classList.contains('is-open');
        const isSearchOpen =
          searchWrapper && !searchWrapper.classList.contains('collapsed');

        if (isMenuOpen || isSearchOpen) {
          header.classList.remove('header-hidden');
          lastScrollY = y;
          return;
        }

        if (y <= HIDE_AFTER) {
          header.classList.remove('header-hidden');
        } else if (diff > DELTA) {
          header.classList.add('header-hidden');
        } else if (diff < -DELTA) {
          header.classList.remove('header-hidden');
        }

        lastScrollY = y;
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateHeaderOnScroll);
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });

      // Al salir de móvil (resize/rotación) asegurar que el header es visible
      mobileQuery.addEventListener('change', () => {
        if (!mobileQuery.matches) {
          header.classList.remove('header-hidden');
        }
        lastScrollY = window.scrollY;
      });
    }

    toggle.onclick = () => {
      const isOpen = nav.classList.contains('is-open');
      if (isOpen) {
        nav.classList.remove('is-open');
        toggle.classList.remove('is-open');
        nav.setAttribute('aria-hidden', 'true');
        toggle.setAttribute('aria-expanded', 'false');
        branding.classList.remove('is-hidden');
        if (searchContainer) searchContainer.classList.remove('is-hidden');
        if (themeContainer) themeContainer.classList.remove('is-hidden');
      } else {
        nav.classList.add('is-open');
        toggle.classList.add('is-open');
        nav.setAttribute('aria-hidden', 'false');
        toggle.setAttribute('aria-expanded', 'true');
        branding.classList.add('is-hidden');
        if (searchContainer) searchContainer.classList.add('is-hidden');
        if (themeContainer) themeContainer.classList.add('is-hidden');
      }
    };

    // Mostrar u ocultar el buscador
    const setSearchOpen = (open = false) => {
      if (!searchWrapper || !searchToggle) return;
      if (header) header.classList.toggle('is-search-open', open);
      if (open) {
        searchWrapper.classList.remove('collapsed');
        searchToggle.classList.add('hidden');
        searchToggle.setAttribute('aria-label', 'Cerrar búsqueda');
        // Ocultar título en móvil
        if (window.innerWidth <= 640 && brandingTitle) {
          brandingTitle.classList.add('is-hidden');
        }
      } else {
        searchWrapper.classList.add('collapsed');
        searchToggle.classList.remove('hidden');
        searchToggle.setAttribute('aria-label', 'Abrir búsqueda');
        // Mostrar título en móvil
        if (window.innerWidth <= 640 && brandingTitle) {
          brandingTitle.classList.remove('is-hidden');
        }
      }
    };

    // Toggle del buscador con botón de lupa
    if (searchToggle && searchWrapper && searchInput) {
      searchToggle.addEventListener('click', () => {
        const isCollapsed = searchWrapper.classList.contains('collapsed');
        setSearchOpen(isCollapsed);
        if (isCollapsed) {
          setTimeout(() => searchInput.focus(), 100);
        } else {
          // Al cerrar con la lupa se limpia el texto (comportamiento previo)
          searchInput.value = '';
          if (clearButton) {
            clearButton.setAttribute('hidden', '');
          }
        }
      });
    }

    // Sistema de búsqueda
    if (searchInput && clearButton) {
      // Mostrar/ocultar botón de limpiar según el contenido
      const toggleClearButton = () => {
        if (searchInput.value.trim()) {
          clearButton.removeAttribute('hidden');
        } else {
          clearButton.setAttribute('hidden', '');
        }
      };

      searchInput.addEventListener('input', toggleClearButton);

      // Reflejar en el input el término de búsqueda actual (/buscar?q=...)
      if (window.location.pathname.replace(/\/+$/, '') === '/buscar') {
        const currentQuery = new URLSearchParams(window.location.search).get('q') || '';
        if (currentQuery) {
          searchInput.value = currentQuery;
          setSearchOpen(false);
        }
      }

      // Inicializar estado del botón
      toggleClearButton();

      // Limpiar búsqueda al hacer clic en X
      clearButton.addEventListener('click', () => {
        searchInput.value = '';
        toggleClearButton();
        setSearchOpen(false);
        // Disparar evento para limpiar búsqueda (y su ?q= en la URL)
        document.dispatchEvent(new CustomEvent('searchCleared'));
      });

      // Detectar cuando se limpia el input (botón X nativo del navegador)
      searchInput.addEventListener('search', () => {
        toggleClearButton();
      });
    }

    // Enviar la búsqueda: el formulario navega de forma nativa a /buscar?q=...
    // (en /buscar la página intercepta el envío para buscar sin recargar)
    if (searchForm && searchInput) {
      searchForm.addEventListener('submit', (e) => {
        if (!searchInput.value.trim()) {
          e.preventDefault();
          return;
        }
        setSearchOpen(false);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
</script>
