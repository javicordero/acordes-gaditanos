---
// src/components/layout/SugerenciasBusqueda.astro
//
// Desplegable de sugerencias del buscador del header. No descarga nada hasta
// que el usuario abre el buscador: entonces pide /indice-busqueda.json (~10 KB
// comprimido) y carga el motor por separado.
---

<div class='sugerencias-busqueda' id='sugerencias-busqueda' hidden>
  <p class='sugerencias-estado' role='status' aria-live='polite'></p>
  <ul class='sugerencias-lista' role='listbox' aria-label='Sugerencias de búsqueda'></ul>
</div>

<style>
  .sugerencias-busqueda {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    /* El ancho y la posición los ajusta el script para no salirse de la
       pantalla; esto es solo el respaldo. */
    width: 340px;
    max-width: calc(100vw - 16px);
    z-index: 20;
    background: var(--card-background-color);
    border: 2px solid var(--primary-contrast-color);
    box-shadow: 4px 4px 0 0 var(--primary-color);
    max-height: min(60vh, 500px);
    overflow-y: auto;
    overscroll-behavior: contain;
    text-align: left;
  }

  .sugerencias-estado {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .sugerencias-lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>

<style is:global>
  /* Filas creadas desde JavaScript: no llevan el ámbito del componente. */
  .sugerencia {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    padding: 9px 12px;
    border: 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--primary-contrast-color) 22%, transparent);
    background: transparent;
    color: var(--text-color);
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;

    &.activa {
      background: var(--primary-contrast-color);
      color: var(--on-bright-color);

      & .sugerencia-meta {
        color: inherit;
        opacity: 0.85;
      }
    }
  }

  /* Agrupación en su línea; la pieza va debajo como el badge de las cards. */
  .sugerencia-titulo {
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sugerencia-pieza {
    align-self: flex-start;
    max-width: 100%;
    padding: 2px 5px;
    border: 2px solid var(--primary-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 1.1;
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    &[data-pieza-type='presentacion'] {
      color: var(--pieza-presentacion-color);
      background-color: var(--pieza-presentacion-bg);
    }

    &[data-pieza-type='pasodoble'] {
      color: var(--pieza-pasodoble-color);
      background-color: var(--pieza-pasodoble-bg);
    }

    &[data-pieza-type='tango'] {
      color: var(--pieza-tango-color);
      background-color: var(--pieza-tango-bg);
    }

    &[data-pieza-type='estribillo'] {
      color: var(--pieza-estribillo-color);
      background-color: var(--pieza-estribillo-bg);
    }

    &[data-pieza-type='default'] {
      color: var(--pieza-default-color);
      background-color: var(--pieza-default-bg);
    }
  }

  .sugerencia-meta {
    font-size: 0.76rem;
    color: var(--text-secondary-color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sugerencias-vacio {
    padding: 10px 12px;
    font-size: 0.85rem;
    color: var(--text-secondary-color);
  }

  .sugerencias-pie {
    border-top: 2px solid var(--primary-contrast-color);
  }

  .sugerencias-todas {
    display: block;
    padding: 9px 12px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--primary-color);
    text-decoration: none;

    &:hover {
      background: var(--primary-contrast-color);
      color: var(--on-bright-color);
    }
  }

  /* En móvil el panel va del ancho del campo: se aprieta un poco para que la
     segunda línea quepa sin recortes. */
  @media (max-width: 640px) {
    .sugerencia {
      padding: 8px 10px;
    }

    .sugerencia-titulo {
      font-size: 0.85rem;
    }

    .sugerencia-meta {
      font-size: 0.72rem;
    }

    .sugerencias-todas {
      padding: 8px 10px;
    }
  }
</style>

<script>
  import { prefetch } from 'astro:prefetch';

  const MINIMO = 2;
  const MAXIMO = 6;
  const RETARDO = 120;
  // En móvil el panel va tan ancho como el campo; esto solo evita que quede
  // inservible en pantallas muy estrechas.
  const ANCHO_MINIMO = 180;

  interface Sugerencia {
    slug: string;
    agrupacion: string;
    year: string;
    etiquetaPieza: string;
    etiquetaAutores: string;
    tipoPieza: string;
  }

  interface Respuesta {
    resultados: Sugerencia[];
    total: number;
    sugerencia: string | null;
  }

  const input = document.querySelector<HTMLInputElement>('#header-search');
  const panel = document.querySelector<HTMLElement>('#sugerencias-busqueda');
  const lista = panel?.querySelector<HTMLUListElement>('.sugerencias-lista');
  const estado = panel?.querySelector<HTMLElement>('.sugerencias-estado');
  const toggle = document.querySelector<HTMLButtonElement>('.search-toggle');

  if (input && panel && lista) {
    let cargando: Promise<boolean> | null = null;
    let indice: Sugerencia[] = [];
    let buscarFn: ((entradas: Sugerencia[], consulta: string, limite?: number) => Respuesta) | null =
      null;

    let abierto = false;
    let activo = -1;
    let temporizador = 0;
    let consultaActual = '';

    // El input solo se anuncia como combobox cuando el JS está vivo.
    input.setAttribute('role', 'combobox');
    input.setAttribute('aria-expanded', 'false');
    input.setAttribute('aria-controls', 'sugerencias-busqueda');
    input.setAttribute('aria-autocomplete', 'list');

    function analitica(evento: string, params: Record<string, unknown>) {
      try {
        const w = window as any;
        if (typeof w.gtag === 'function') {
          w.gtag('event', evento, {
            ...params,
            event_category: 'busqueda',
            event_label: window.location.pathname,
          });
        } else {
          w.dataLayer = w.dataLayer || [];
          w.dataLayer.push({ event: evento, ...params });
        }
      } catch {
        /* nunca bloquear la búsqueda por analítica */
      }
    }

    function cargar(): Promise<boolean> {
      if (!cargando) {
        cargando = Promise.all([
          import('../../lib/busqueda'),
          fetch('/indice-busqueda.json').then((respuesta) => (respuesta.ok ? respuesta.json() : [])),
        ])
          .then(([modulo, datos]) => {
            buscarFn = modulo.buscar as any;
            indice = modulo.preparar(datos);
            return true;
          })
          .catch(() => {
            cargando = null;
            return false;
          });
      }

      return cargando;
    }

    function opciones(): HTMLElement[] {
      return Array.from(lista!.querySelectorAll<HTMLElement>('[role="option"]'));
    }

    /** Encaja el panel dentro de la pantalla, con el ancho del propio campo. */
    function colocar() {
      const contenedor = panel!.parentElement;
      const campo = input!.getBoundingClientRect();
      if (!contenedor) return;

      const caja = contenedor.getBoundingClientRect();
      const margen = 8;
      // Tan ancho como el campo, sin bajar de un mínimo legible ni salirse.
      const ancho = Math.min(
        Math.max(campo.width, ANCHO_MINIMO),
        window.innerWidth - margen * 2,
      );
      const derecha = Math.min(campo.right, window.innerWidth - margen);
      const izquierda = Math.max(margen, derecha - ancho);

      panel!.style.width = `${ancho}px`;
      panel!.style.left = `${izquierda - caja.left}px`;
    }

    function cerrar() {
      abierto = false;
      activo = -1;
      panel!.hidden = true;
      lista!.replaceChildren();
      input!.setAttribute('aria-expanded', 'false');
      input!.removeAttribute('aria-activedescendant');
      if (estado) estado.textContent = '';
    }

    function marcar(siguiente: number) {
      const ops = opciones();
      if (!ops.length) return;

      activo = (siguiente + ops.length) % ops.length;

      ops.forEach((op, i) => {
        op.classList.toggle('activa', i === activo);
        op.setAttribute('aria-selected', String(i === activo));
      });

      const elegida = ops[activo];
      input!.setAttribute('aria-activedescendant', elegida.id);
      elegida.scrollIntoView({ block: 'nearest' });

      if (elegida instanceof HTMLAnchorElement) prefetch(elegida.href);
    }

    function fila(resultado: Sugerencia, posicion: number): HTMLLIElement {
      const item = document.createElement('li');
      item.setAttribute('role', 'none');

      const enlace = document.createElement('a');
      enlace.className = 'sugerencia';
      enlace.id = `sugerencia-${posicion}`;
      enlace.href = `/acordes/${resultado.slug}/`;
      enlace.setAttribute('role', 'option');
      enlace.setAttribute('aria-selected', 'false');

      const titulo = document.createElement('span');
      titulo.className = 'sugerencia-titulo';
      titulo.textContent = resultado.agrupacion;

      const pieza = document.createElement('span');
      pieza.className = 'sugerencia-pieza';
      pieza.textContent = resultado.etiquetaPieza;
      pieza.dataset.piezaType = resultado.tipoPieza;

      const meta = document.createElement('span');
      meta.className = 'sugerencia-meta';
      // Música · letra (sin repetir); si no hay autores, al menos el año.
      meta.textContent = resultado.etiquetaAutores || resultado.year;

      if (titulo.textContent) enlace.append(titulo);
      if (pieza.textContent) enlace.append(pieza);
      enlace.append(meta);

      enlace.addEventListener('click', (evento) => {
        analitica('buscar_sugerencia_click', {
          consulta: consultaActual.slice(0, 40),
          posicion: posicion + 1,
          resultado: resultado.agrupacion,
          // Enter en el teclado dispara click() sin puntero: detail vale 0.
          origen: evento.detail === 0 ? 'teclado' : 'raton',
        });
      });

      enlace.addEventListener('pointerenter', () => marcar(posicion));

      item.append(enlace);
      return item;
    }

    function filaVacio(consulta: string, sugerencia: string | null): DocumentFragment {
      const fragmento = document.createDocumentFragment();

      const aviso = document.createElement('li');
      aviso.className = 'sugerencias-vacio';
      aviso.setAttribute('role', 'none');
      aviso.textContent = `Sin resultados para «${consulta}»`;
      fragmento.append(aviso);

      if (sugerencia) {
        const item = document.createElement('li');
        item.setAttribute('role', 'none');

        const boton = document.createElement('button');
        boton.type = 'button';
        boton.className = 'sugerencia';
        boton.id = 'sugerencia-0';
        boton.setAttribute('role', 'option');
        boton.setAttribute('aria-selected', 'false');

        const meta = document.createElement('span');
        meta.className = 'sugerencia-meta';
        meta.textContent = 'Quizá quisiste decir';

        const titulo = document.createElement('span');
        titulo.className = 'sugerencia-titulo';
        titulo.textContent = sugerencia;

        boton.append(meta, titulo);

        boton.addEventListener('click', () => {
          input!.value = sugerencia;
          input!.focus();
          buscarYa(sugerencia);
        });

        boton.addEventListener('pointerenter', () => marcar(0));

        item.append(boton);
        fragmento.append(item);
      }

      return fragmento;
    }

    function filaTodas(consulta: string, total: number): HTMLLIElement {
      const item = document.createElement('li');
      item.className = 'sugerencias-pie';
      item.setAttribute('role', 'none');

      const enlace = document.createElement('a');
      enlace.className = 'sugerencias-todas';
      enlace.href = `/buscar/?q=${encodeURIComponent(consulta)}`;
      enlace.textContent =
        total === 0
          ? 'Ver la búsqueda completa'
          : total === 1
            ? 'Ver el resultado'
            : `Ver los ${total} resultados`;

      // Navega a /buscar: se manda con beacon para que no se pierda en la descarga.
      enlace.addEventListener('click', () => {
        analitica('buscar_ver_resultados', {
          consulta: consulta.slice(0, 40),
          total,
          origen: 'panel',
          transport_type: 'beacon',
        });
      });

      item.append(enlace);
      return item;
    }

    function pintar(respuesta: Respuesta, consulta: string) {
      const fragmento = document.createDocumentFragment();

      if (respuesta.total === 0) {
        fragmento.append(filaVacio(consulta, respuesta.sugerencia));
      } else {
        respuesta.resultados.forEach((resultado, i) => fragmento.append(fila(resultado, i)));
      }

      fragmento.append(filaTodas(consulta, respuesta.total));

      lista!.replaceChildren(fragmento);
      panel!.hidden = false;
      abierto = true;
      activo = -1;
      colocar();
      input!.setAttribute('aria-expanded', 'true');

      if (estado) {
        estado.textContent =
          respuesta.total === 0
            ? 'Sin resultados'
            : `${respuesta.total} ${respuesta.total === 1 ? 'resultado' : 'resultados'}`;
      }

      if (respuesta.total === 0) {
        analitica('buscar_sin_resultados', { consulta: consulta.slice(0, 40) });
      }
    }

    async function buscarYa(consulta: string) {
      if (!(await cargar()) || !buscarFn) return;
      if (input!.value.trim() !== consulta) return;

      consultaActual = consulta;
      pintar(buscarFn(indice, consulta, MAXIMO), consulta);
    }

    function programar() {
      window.clearTimeout(temporizador);

      const consulta = input!.value.trim();
      consultaActual = consulta;

      if (consulta.length < MINIMO) {
        cerrar();
        return;
      }

      temporizador = window.setTimeout(() => buscarYa(consulta), RETARDO);
    }

    input.addEventListener('focus', () => {
      cargar();
    });

    input.addEventListener('input', programar);

    // Abrir el buscador ya es intención suficiente: se empieza a descargar.
    toggle?.addEventListener('click', () => {
      cargar();
    });

    input.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape') {
        if (abierto) {
          evento.preventDefault();
          cerrar();
        }
        return;
      }

      if (evento.key === 'ArrowDown' || evento.key === 'ArrowUp') {
        if (!abierto) {
          const consulta = input.value.trim();
          if (consulta.length < MINIMO) return;
          evento.preventDefault();
          buscarYa(consulta);
          return;
        }

        evento.preventDefault();
        marcar(evento.key === 'ArrowDown' ? activo + 1 : activo - 1);
        return;
      }

      if (evento.key === 'Home' || evento.key === 'End') {
        if (!abierto) return;
        evento.preventDefault();
        marcar(evento.key === 'Home' ? 0 : opciones().length - 1);
        return;
      }

      if (evento.key === 'Enter') {
        if (abierto && activo >= 0) {
          const elegida = opciones()[activo];
          if (elegida) {
            evento.preventDefault();
            elegida.click();
          }
          return;
        }

        cerrar();
        return;
      }

      if (evento.key === 'Tab') cerrar();
    });

    // Cerrar al pulsar fuera, al hacer scroll de la página o al perder el foco.
    document.addEventListener('pointerdown', (evento) => {
      if (!abierto) return;
      const objetivo = evento.target as Node;
      if (panel.contains(objetivo) || panel === objetivo) return;
      if (input.contains(objetivo)) return;
      cerrar();
    });

    document.addEventListener(
      'scroll',
      (evento) => {
        if (!abierto) return;
        if (panel.contains(evento.target as Node)) return;
        cerrar();
      },
      true,
    );

    input.addEventListener('focusout', (evento) => {
      if (!abierto) return;
      const destino = evento.relatedTarget as Node | null;
      if (destino && panel.contains(destino)) return;
      cerrar();
    });

    window.addEventListener('resize', () => {
      if (abierto) colocar();
    });

    document.addEventListener('searchCleared', cerrar);

    input.addEventListener('search', () => {
      if (!input.value.trim()) cerrar();
    });
  }
</script>
