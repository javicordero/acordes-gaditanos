---
interface Props {
  pieza: string;
  agrupacion: string;
  musicaList: string[];
  letraList: string[];
  year: string;
  modalidad: string;
  url: string;
  image: string;
}

const { pieza, agrupacion, musicaList, letraList, year, modalidad, url, image } = Astro.props;

// Generar estructura de datos para Schema.org
const schema = {
  '@context': 'https://schema.org',
  '@type': 'MusicComposition',
  name: `${pieza} - ${agrupacion}`,
  composer: musicaList.map(n => ({ '@type': 'Person', name: n })),
  lyricist: letraList.length > 0 ? letraList.map(n => ({ '@type': 'Person', name: n })) : undefined,
  datePublished: `${year}-01-01`,
  genre: 'Carnaval de Cádiz',
  inLanguage: 'es-ES',
  about: `${modalidad} del Carnaval de Cádiz ${year}`,
  url: url,
  image: image,
};

// Eliminar campos undefined
const cleanSchema = JSON.parse(JSON.stringify(schema));
---

<script type='application/ld+json' set:html={JSON.stringify(cleanSchema)} />
