---
const FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSeEe8EOiiOBaq4nI0RrTQRzxYeAtTKFbzy1vmg_I4rgXnecMg/viewform?embedded=true';
---

<div id='encuesta-modal' class='encuesta-modal' aria-hidden='true'>
  <div class='encuesta-modal__backdrop'></div>
  <div class='encuesta-modal__content'>
    <header class='encuesta-modal__header'>
      <h2 class='encuesta-modal__title'>Encuesta curso de guitarra</h2>
      <button class='encuesta-modal__close' aria-label='Cerrar'>×</button>
    </header>
    <iframe
      src={FORM_URL}
      width='100%'
      height='1257'
      frameborder='0'
      loading='lazy'
      title='Encuesta sobre cursos de guitarra'>
    </iframe>
  </div>
</div>

<style>
  .encuesta-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .encuesta-modal--visible {
    display: flex;
  }

  .encuesta-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    animation: fadeIn 0.3s ease;
  }

  .encuesta-modal__content {
    position: relative;
    background: var(--card-background-color);
    border-radius: 16px;
    width: 100%;
    max-width: 720px;
    max-height: 95vh;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    animation: slideUp 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .encuesta-modal__close {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: 12px;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: #000;
    border-radius: 50%;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: transform 0.2s, color 0.2s;
  }

  .encuesta-modal__close:hover {
    transform: scale(1.1);
    color: #444;
  }

.encuesta-modal__header {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 48px 12px;
    position: relative;
    flex-shrink: 0;
  }

  .encuesta-modal__title {
    margin: 0;
    color: var(--text-color);
    font-size: 1.5rem;
    text-align: center;
  }

  .encuesta-modal__close {
    position: absolute;
    right: 12px;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: #000;
    border-radius: 50%;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: transform 0.2s, color 0.2s;
  }

  .encuesta-modal__close:hover {
    transform: scale(1.1);
    color: #444;
  }

  .encuesta-modal iframe {
    display: block;
    width: 100%;
    border: none;
    flex: 1;
    min-height: 650px;
    max-height: 85vh;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .encuesta-modal {
      padding: 6px;
    }

    .encuesta-modal__content {
      border-radius: 12px;
      max-height: 96vh;
    }

    .encuesta-modal__header {
      padding: 12px 40px 10px;
    }

    .encuesta-modal__title {
      font-size: 1.25rem;
    }

    .encuesta-modal__close {
      right: 6px;
      width: 32px;
      height: 32px;
      font-size: 20px;
    }

    .encuesta-modal iframe {
      min-height: 500px;
      max-height: 75vh;
    }
  }
</style>

<script>
  const MODAL_ID = 'encuesta-modal';
  const CLOSE_BTN_SELECTOR = '.encuesta-modal__close';
  const BACKDROP_SELECTOR = '.encuesta-modal__backdrop';
  const MODAL_CONTENT_SELECTOR = '.encuesta-modal__content';

  let modalShownInSession = false;
  let timeoutId: ReturnType<typeof setTimeout> | null = null;
  let isInitialized = false;

  function showModal() {
    const modal = document.getElementById(MODAL_ID);
    if (!modal) return;

    modal.classList.add('encuesta-modal--visible');
    modal.setAttribute('aria-hidden', 'false');

    const iframe = modal.querySelector('iframe');
    if (iframe) {
      const src = iframe.getAttribute('src');
      if (src && src.includes('viewform?embedded=true')) {
        iframe.src = src;
      }
    }
  }

  function hideModal() {
    const modal = document.getElementById(MODAL_ID);
    if (!modal) return;

    modal.classList.remove('encuesta-modal--visible');
    modal.setAttribute('aria-hidden', 'true');

    if (timeoutId) {
      clearTimeout(timeoutId);
      timeoutId = null;
    }
  }

  function saveShownState() {
    try {
      sessionStorage.setItem('ag_encuesta_modal_session', 'true');

      const thirtyDays = 30 * 24 * 60 * 60 * 1000;
      const expires = new Date(Date.now() + thirtyDays).toUTCString();
      localStorage.setItem('ag_encuesta_modal', expires);
    } catch (e) {
      console.error('Error guardando estado de encuesta', e);
    }
  }

  function shouldShowModal() {
    try {
      if (sessionStorage.getItem('ag_encuesta_modal_session')) {
        return false;
      }

      const expires = localStorage.getItem('ag_encuesta_modal');
      if (expires && new Date(expires) > new Date()) {
        return false;
      }

      return true;
    } catch (e) {
      return true;
    }
  }

  function initModal() {
    const modal = document.getElementById(MODAL_ID);
    if (!modal) return;

    if (isInitialized) return;
    isInitialized = true;

    const closeBtn = modal.querySelector(CLOSE_BTN_SELECTOR);
    const backdrop = modal.querySelector(BACKDROP_SELECTOR);
    const content = modal.querySelector(MODAL_CONTENT_SELECTOR);

    closeBtn?.addEventListener('click', () => {
      hideModal();
      saveShownState();
    });

    backdrop?.addEventListener('click', () => {
      hideModal();
      saveShownState();
    });

    content?.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('encuesta-modal--visible')) {
        hideModal();
        saveShownState();
      }
    });
  }

  function scheduleModal() {
    if (modalShownInSession) return;

    timeoutId = setTimeout(() => {
      if (!shouldShowModal()) return;

      modalShownInSession = true;
      showModal();
    }, 5000);
  }

  document.addEventListener('astro:page-load', () => {
    initModal();
    scheduleModal();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initModal();
      scheduleModal();
    });
  }
</script>