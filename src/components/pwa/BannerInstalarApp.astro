---
// src/components/pwa/BannerInstalarApp.astro
//
// Banner propio (estilo del antiguo NovedadCallout del «listado de todas las
// coplas») que invita a instalar la app. Se usa tras el título de «Novedades»
// (portada) y bajo la cejilla en las fichas. Solo en móvil, oculto si ya está
// instalada o descartada.
interface Props {
  /** Para la analítica: 'portada' o 'ficha'. */
  ubicacion: string;
}

const { ubicacion } = Astro.props;
---

<div class='banner-instalar' data-pwa-banner data-ubicacion={ubicacion}>
  <span class='banner-instalar__badge'>Novedad</span>
  <div class='banner-instalar__cuerpo'>
    <p class='banner-instalar__texto'>Instala la aplicación Acordes Gaditanos en tu móvil.</p>
    <p class='banner-instalar__texto'>
      <button type='button' class='banner-instalar__accion' data-pwa-instalar>Instalar app</button>
    </p>
  </div>
</div>

<script>
  import { instalar, puedeInstalar } from '../../lib/pwa/instalacion';
  import { eventoPwa } from '../../lib/pwa/analytics';

  let promptMostrado = false;

  function init() {
    const banner = document.querySelector<HTMLElement>('[data-pwa-banner]');
    if (!banner) return;

    if (puedeInstalar()) {
      banner.classList.add('banner-instalar--visible');
      if (!promptMostrado) {
        promptMostrado = true;
        eventoPwa('pwa_prompt_shown', { ubicacion: banner.dataset.ubicacion });
      }
      const btn = banner.querySelector<HTMLElement>('[data-pwa-instalar]');
      if (btn && !btn.dataset.wired) {
        btn.dataset.wired = 'true';
        btn.addEventListener('click', () => {
          eventoPwa('pwa_home_banner_click', { ubicacion: banner.dataset.ubicacion });
          instalar();
        });
      }
    } else {
      banner.classList.remove('banner-instalar--visible');
    }
  }

  init();
  document.addEventListener('astro:page-load', init);
  window.addEventListener('ag:beforeinstallprompt', init);
  window.addEventListener('ag:pwa-estado', init);
</script>

<style>
  .banner-instalar {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: fit-content;
    max-width: 100%;
    margin: 0;
    padding: 14px 16px;
    background: var(--callout-bg);
    border: 2px solid var(--primary-color);
    border-radius: 0;
    color: var(--text-color);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .banner-instalar--visible {
    display: flex;
  }

  .banner-instalar__badge {
    flex: none;
    display: inline-block;
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
    font-family: 'Roboto Mono', monospace;
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 2px solid var(--primary-color);
    border-radius: 0;
  }

  .banner-instalar__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .banner-instalar__texto {
    margin: 0;
  }

  .banner-instalar__accion {
    background: none;
    border: none;
    padding: 0;
    color: var(--link-color);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .banner-instalar__accion:hover {
    color: var(--link-hover-color);
  }

  .banner-instalar__accion:focus-visible {
    outline: 3px solid var(--primary-contrast-color);
    outline-offset: 3px;
  }
</style>
