---
// src/components/pwa/TooltipInstalar.astro
//
// Aviso que señala el botón «Instalar app» de la cabecera. Solo se monta en la
// portada y se muestra una vez por navegador (localStorage). El diálogo de
// instalación que se abre al pulsar el botón es el nativo del navegador.
import { Icon } from 'astro-icon/components';
---

<div class='tooltip-instalar' data-tooltip-instalar hidden>
  <div class='tooltip-instalar__anillo' data-tooltip-anillo aria-hidden='true'></div>
  <div
    class='tooltip-instalar__carta'
    role='dialog'
    aria-labelledby='tooltip-instalar-titulo'
    aria-describedby='tooltip-instalar-texto'
    data-tooltip-carta>
    <span class='tooltip-instalar__flecha' data-tooltip-flecha aria-hidden='true'></span>
    <button type='button' class='tooltip-instalar__cerrar' data-tooltip-cerrar aria-label='Cerrar'>
      <Icon name='cruz' width={16} height={16} />
    </button>
    <h2 class='tooltip-instalar__titulo' id='tooltip-instalar-titulo'>Llévate las coplas</h2>
    <p class='tooltip-instalar__texto' id='tooltip-instalar-texto'>
      Instala Acordes Gaditanos y úsala sin conexión. Toca el botón de instalar de la cabecera.
    </p>
    <button type='button' class='tooltip-instalar__accion' data-tooltip-accion>Entendido</button>
  </div>
</div>

<script>
  import { puedeInstalar } from '../../lib/pwa/instalacion';

  const CLAVE = 'ag_instalar_tooltip_visto';
  let cerrado = false;

  function visto(): boolean {
    try {
      return localStorage.getItem(CLAVE) === '1';
    } catch {
      return false;
    }
  }

  function marcarVisto() {
    try {
      localStorage.setItem(CLAVE, '1');
    } catch {
      /* sin localStorage se muestra en cada visita */
    }
  }

  function contenedor(): HTMLElement | null {
    return document.querySelector<HTMLElement>('[data-tooltip-instalar]');
  }

  function cerrar(marcar = true) {
    const wrap = contenedor();
    if (!wrap || wrap.hidden) return;
    wrap.hidden = true;
    cerrado = true;
    if (marcar) marcarVisto();
  }

  function posicionar() {
    const wrap = contenedor();
    const btn = document.querySelector<HTMLElement>('[data-pwa-instalar-cabecera]');
    if (!wrap || !btn || wrap.hidden) return;

    const rect = btn.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) {
      wrap.hidden = true;
      return;
    }

    const anillo = wrap.querySelector<HTMLElement>('[data-tooltip-anillo]');
    const carta = wrap.querySelector<HTMLElement>('[data-tooltip-carta]');
    const flecha = wrap.querySelector<HTMLElement>('[data-tooltip-flecha]');
    if (!anillo || !carta || !flecha) return;

    anillo.style.cssText =
      `top:${rect.top - 5}px;left:${rect.left - 5}px;` +
      `width:${rect.width + 10}px;height:${rect.height + 10}px`;

    const ancho = Math.min(290, window.innerWidth - 32);
    let left = rect.right - ancho;
    if (left < 16) left = 16;
    if (left + ancho > window.innerWidth - 16) left = window.innerWidth - ancho - 16;
    carta.style.cssText = `top:${rect.bottom + 12}px;left:${left}px;width:${ancho}px`;

    const centro = rect.left + rect.width / 2;
    flecha.style.left = `${Math.min(Math.max(centro - left - 7, 14), ancho - 16)}px`;
  }

  function sincronizar() {
    const wrap = contenedor();
    const btn = document.querySelector<HTMLElement>('[data-pwa-instalar-cabecera]');
    if (!wrap || !btn) return;

    if (btn.hidden || !puedeInstalar() || cerrado) {
      wrap.hidden = true;
      return;
    }

    if (!wrap.hidden) {
      posicionar();
      return;
    }

    if (visto()) return;

    wrap.hidden = false;
    posicionar();
    marcarVisto();
  }

  function init() {
    const wrap = contenedor();
    if (!wrap || wrap.dataset.wired) return;
    wrap.dataset.wired = 'true';

    wrap.querySelector('[data-tooltip-cerrar]')?.addEventListener('click', () => cerrar());
    wrap.querySelector('[data-tooltip-accion]')?.addEventListener('click', () => cerrar());

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') cerrar();
    });

    window.addEventListener('ag:instalar-boton', sincronizar);
    window.addEventListener('ag:pwa-estado', sincronizar);
    window.addEventListener('ag:beforeinstallprompt', sincronizar);
    window.addEventListener('resize', posicionar, { passive: true });
    window.addEventListener(
      'scroll',
      () => {
        // La cabecera se esconde al bajar en móvil: ocultamos el aviso con ella.
        const header = document.querySelector('header');
        if (header?.classList.contains('header-hidden')) {
          const w = contenedor();
          if (w) w.hidden = true;
          return;
        }
        posicionar();
      },
      { passive: true },
    );

    sincronizar();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .tooltip-instalar[hidden] {
    display: none;
  }

  .tooltip-instalar__anillo {
    position: fixed;
    z-index: 10000;
    border: 2px solid var(--primary-contrast-color);
    box-shadow: 3px 3px 0 0 var(--primary-contrast-color);
    box-sizing: border-box;
    pointer-events: none;
  }

  .tooltip-instalar__carta {
    position: fixed;
    z-index: 10001;
    box-sizing: border-box;
    padding: 16px 18px;
    background: var(--surface-color);
    border: 2px solid var(--primary-color);
    box-shadow: 6px 6px 0 0 var(--primary-color);
  }

  .tooltip-instalar__flecha {
    position: absolute;
    top: -8px;
    width: 14px;
    height: 14px;
    background: var(--surface-color);
    border-top: 2px solid var(--primary-color);
    border-left: 2px solid var(--primary-color);
    transform: rotate(45deg);
  }

  .tooltip-instalar__cerrar {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 2px solid var(--primary-color);
    background: transparent;
    color: var(--primary-color);
    cursor: pointer;
  }

  .tooltip-instalar__cerrar:hover {
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  .tooltip-instalar__titulo {
    margin: 0 28px 6px 0;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--primary-color);
  }

  .tooltip-instalar__texto {
    margin: 0 0 14px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-color);
  }

  .tooltip-instalar__accion {
    display: block;
    width: 100%;
    padding: 9px 16px;
    border: 2px solid var(--primary-color);
    border-radius: 0;
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 3px 3px 0 0 var(--on-bright-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .tooltip-instalar__accion:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 0 var(--on-bright-color);
  }

  @media (max-width: 640px) {
    .tooltip-instalar__carta {
      padding: 14px 16px;
    }
  }
</style>
