---
import { Image } from 'astro:assets';

const { autor, musicaCount = 0, letraCount = 0 } = Astro.props;
const headingId = `autor-${autor.autorSlug}`;
const nombresCard: Record<string, string> = {
  'juan-carlos-aragon': 'Juan Carlos',
  'antonio-martinez-ares': 'Martínez Ares',
  'jesus-bienvenido': 'Bienvenido',
  'jonathan-perez-ginel': 'El Jona',
  'manolin-santander': 'Manolín',
};
const nombreCard = nombresCard[autor.autorSlug] ?? autor.nombre;
const esImagenLocal = autor.img.startsWith('/');
const base = `/autor`;

const tieneMusica = musicaCount > 0;
const tieneLetra = letraCount > 0;
const tipoPreferido = autor.type === 'letra' ? 'letra' : 'musica';

// Si la página preferida no tuviera coplas, la card lleva a la que sí existe.
const tipoPrincipal =
  tieneMusica || tieneLetra
    ? tipoPreferido === 'letra'
      ? tieneLetra
        ? 'letra'
        : 'musica'
      : tieneMusica
        ? 'musica'
        : 'letra'
    : tipoPreferido;

const tipoLabel = tipoPrincipal === 'letra' ? 'Letras' : 'Músicas';
const hrefPrincipal = `${base}/${tipoPrincipal}/${autor.autorSlug}`;
---

<article class='card' aria-labelledby={headingId}>
  <a
    href={hrefPrincipal}
    class='card-stretch'
    aria-label={`${autor.nombre} - ${tipoLabel}`}
  >
  </a>

  <figure class='card-media'>
    {
      esImagenLocal ? (
        <img
          src={autor.img}
          alt={`${autor.nombre} - Carnaval de Cádiz`}
          loading='lazy'
          decoding='async'
          width={480}
          height={640}
          class='card-image'
        />
      ) : (
        <Image
          src={autor.img}
          alt={`${autor.nombre} - Carnaval de Cádiz`}
          loading='lazy'
          decoding='async'
          width={480}
          height={640}
          class='card-image'
        />
      )
    }
  </figure>

  <section class='card-body'>
    <h3 id={headingId} class='card-title' transition:name={`autor-${autor.autorSlug}`}>
      <span class='nombre-completo'>{autor.nombre}</span>
      <span class='nombre-corto'>{nombreCard}</span>
    </h3>

    {
      (tieneMusica || tieneLetra) && (
        <div class='card-links'>
          {tieneMusica && (
            <a
              href={`${base}/musica/${autor.autorSlug}`}
              class='card-link'
              aria-label={`Músicas de ${autor.nombre}`}>
              <span>Músicas</span>
            </a>
          )}
          {tieneLetra && (
            <a
              href={`${base}/letra/${autor.autorSlug}`}
              class='card-link'
              aria-label={`Letras de ${autor.nombre}`}>
              <span>Letras</span>
            </a>
          )}
        </div>
      )
    }
  </section>
</article>

<style>
  .card {
    background-color: var(--primary-contrast-color);
    border: 2px solid var(--on-bright-color);
    border-radius: 0;
    box-shadow: 3px 3px 0 0 var(--on-bright-color);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 12px 12px 0;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
    content-visibility: auto;
    contain-intrinsic-size: 300px 320px;

    &:hover {
      transform: translateY(-3px);
      box-shadow: 3px 6px 0 0 var(--on-bright-color);
      z-index: 10;
    }
  }

  .card-stretch {
    position: absolute;
    inset: 0;
    z-index: 1;
    text-decoration: none;

    &:focus-visible {
      outline: 2px solid var(--on-bright-color);
      outline-offset: -6px;
    }
  }

  .card-media {
    position: relative;
    margin: 0 auto;
    width: 90%;
    flex: none;
    box-shadow: 4px 4px 0 var(--on-bright-color);
  }

  .card-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: top;
    display: block;
    border: 2px solid var(--on-bright-color);
    border-radius: 0;
  }

  .card-body {
    padding: 14px 4px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .card-title {
    font-family: 'Roboto Mono', monospace;
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
    padding: 0;
    color: var(--on-bright-color);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .card-title .nombre-corto {
    display: none;
  }

  .card-links {
    display: flex;
    gap: 8px;
    margin-top: auto;
    border-top: 2px solid var(--on-bright-color);
    padding-top: 8px;
    position: relative;
    z-index: 2;
  }

  .card-link {
    flex: 1 1 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 36px;
    padding: 6px 10px;
    border: 1px solid var(--on-bright-color);
    border-radius: 0;
    background-color: var(--on-bright-color);
    color: var(--primary-contrast-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;

    &:focus-visible {
      outline: 2px solid var(--on-bright-color);
      outline-offset: 3px;
    }
  }

  .card-link span {
    flex: 1;
    min-width: 0;
    text-align: center;
  }

  @media (max-width: 640px) {
    .card {
      padding: 8px 8px 0;

      &:hover {
        transform: none;
        box-shadow: 3px 3px 0 0 var(--on-bright-color);
      }
    }

    .card-body {
      padding: 10px 0;
    }

    .card-title {
      font-size: 0.9rem;
    }

    .card-title .nombre-completo {
      display: none;
    }

    .card-title .nombre-corto {
      display: inline;
    }

    .card-links {
      gap: 4px;
    }

    .card-link {
      min-width: 0;
      min-height: 34px;
      padding: 4px 2px;
      gap: 2px;
      font-size: clamp(0.7rem, 3.2vw, 0.85rem);
      letter-spacing: 0;
    }

  }
</style>
