---
import { Image } from 'astro:assets';

const { autor } = Astro.props;
const headingId = `autor-${autor.autorSlug}`;
const esImagenLocal = autor.img.startsWith('/');
const base = `/autor`;
const tipoLabel = autor.type === 'letra' ? 'Letras' : 'Músicas';
---

<article class='card' aria-labelledby={headingId}>
  <a
    href={`${base}/${autor.type}/${autor.autorSlug}`}
    class='card-stretch'
    aria-label={`${autor.nombre} - ${tipoLabel}`}
  >
  </a>

  <figure class='card-media'>
    {
      esImagenLocal ? (
        <img
          src={autor.img}
          alt={`${autor.nombre} - Carnaval de Cádiz`}
          loading='lazy'
          decoding='async'
          width={480}
          height={640}
          class='card-image'
        />
      ) : (
        <Image
          src={autor.img}
          alt={`${autor.nombre} - Carnaval de Cádiz`}
          loading='lazy'
          decoding='async'
          width={480}
          height={640}
          class='card-image'
          unoptimized
        />
      )
    }
  </figure>

  <section class='card-body'>
    <h3 id={headingId} class='card-title'>{autor.nombre}</h3>
  </section>
</article>

<style>
  .card {
    /* Variante editorial: fondo ámbar fijo y tinta negra en ambos temas */
    background-color: var(--primary-contrast-color);
    border: 2px solid var(--on-bright-color);
    border-radius: 0;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.15s ease;
    content-visibility: auto;
    contain-intrinsic-size: 300px 340px;
    will-change: transform;

    &:hover {
      transform: translate(-4px, -4px);
      z-index: 10;
    }
  }

  .card-stretch {
    position: absolute;
    inset: 0;
    z-index: 1;
    text-decoration: none;

    &:focus-visible {
      outline: 2px solid var(--on-bright-color);
      outline-offset: -6px;
    }
  }

  .card-media {
    position: relative;
    margin: 0;
  }

  .card-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: top;
    display: block;
    border-bottom: 2px solid var(--on-bright-color);
  }

  .card-body {
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }

  .card-title {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    margin: 0;
    padding: 0;
    color: var(--on-bright-color);
    line-height: 1.25;
  }

  @media (max-width: 640px) {
    .card {
      &:hover {
        transform: none;
      }
    }

    .card-image {
      height: 160px;
    }

    .card-body {
      padding: 6px 8px;
    }

    .card-title {
      font-size: 0.85rem;
    }
  }
</style>
