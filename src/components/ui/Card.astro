---
import { Image } from 'astro:assets';
import { prepararTarjeta } from '../../lib/tarjeta';

// Toda la lógica de presentación (pieza visible, color del badge, autores y
// nombre completo) vive en `prepararTarjeta()`, que también usa el catálogo de
// `/buscar`: así la card del build y la que se pinta en el navegador no se
// separan nunca.
const tarjeta = prepararTarjeta({
  slug: Astro.props.slug,
  agrupacion: Astro.props.agrupacion,
  pieza: Astro.props.pieza,
  year: Astro.props.year,
  img: Astro.props.img,
  letraTitulo: Astro.props.letraTitulo,
  musica: Astro.props.musica,
  letra: Astro.props.letra,
  musicaList: Astro.props.musicaList,
  letraList: Astro.props.letraList,
  musicaSlugs: Astro.props.musicaSlugs,
  letraSlugs: Astro.props.letraSlugs,
  musicaSlug: Astro.props.musicaSlug,
  letraSlug: Astro.props.letraSlug,
});

const { slug, agrupacion, year, img, letraTitulo, piezaDisplay, piezaTipo, nombreCompleto, autores } =
  tarjeta;

const headingId = `acordes-${slug}`;

// Los `data-campo` son los huecos que rellena `/buscar` al clonar la card.
---

<article class='card' aria-labelledby={headingId}>
  <a
    href={`/acordes/${slug}/`}
    class='card-stretch'
    aria-label={nombreCompleto}
    data-campo='ancla'></a>

  <figure class='card-media'>
    <Image
      class='card-image'
      src={img}
      alt={`${nombreCompleto} - Carnaval de Cádiz ${year}`}
      loading='lazy'
      decoding='async'
      width={480}
      height={640}
      transition:name={`img-${slug}`}
      data-campo='imagen'
    />
    <header class='card-header'>
      <span class='badge badge--pieza' data-pieza-type={piezaTipo} data-fit-text data-fit-parent data-fit-min='8' data-campo='pieza'>{piezaDisplay}</span>
      {letraTitulo && <span class='badge-letra' data-fit-text data-fit-parent data-fit-min='8' title={`Letra: ${letraTitulo}`} data-campo='letra'>{letraTitulo}</span>}
    </header>
    <span class='card-year' data-campo='year'>{year}</span>
  </figure>

  <section class='card-body'>
    <h3 id={headingId} class='card-title' transition:name={`titulo-${slug}`} data-campo='titulo'>{agrupacion}</h3>

    <div class='card-meta'>
      <div class='card-authors'>
        <span class='card-author-names' data-campo='autores'>
          {
            autores.map((autor) =>
              autor.href ? (
                <a href={autor.href} rel='noopener' title={autor.nombre}>{autor.nombre}</a>
              ) : (
                <span title={autor.nombre}>{autor.nombre}</span>
              ),
            )
          }
        </span>
      </div>
    </div>
  </section>
</article>

<style>
  .card {
    background-color: var(--card-background-color);
    border: 2px solid var(--primary-color);
    border-radius: 0;
    overflow: hidden;
    box-shadow: 6px 6px 0 0 var(--primary-color);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
    content-visibility: auto;
    contain-intrinsic-size: 300px 420px;
    will-change: transform;

    &:hover {
      transform: translate(-4px, -4px);
      box-shadow: 10px 10px 0 0 var(--primary-contrast-color);
      z-index: 10;
    }
  }

  .card-stretch {
    position: absolute;
    inset: 0;
    z-index: 1;
    text-decoration: none;

    &:focus-visible {
      outline: 2px solid var(--primary-contrast-color);
      outline-offset: -2px;
    }
  }

  .card-media {
    position: relative;
    margin: 0;
  }



  .card-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: center;
    display: block;
    border-bottom: 2px solid var(--primary-color);
  }

  .card-header {
    position: absolute;
    bottom: 10px;
    left: 4px;
    right: 4px;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  /* La etiqueta de la letra va encima y el tipo de pieza debajo. */
  .badge-letra {
    order: -1;
  }

  .badge {
    display: inline-block;
    font-family: 'Roboto Mono', monospace;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: none;
    border-radius: 0;
    border: 2px solid var(--primary-color);
    padding: 4px 6px;
    font-size: 0.7rem;
    line-height: 1.1;
    white-space: nowrap;
    max-width: 100%;
  }

  .badge--pieza {
    &[data-pieza-type='presentacion'] {
      color: var(--pieza-presentacion-color);
      background-color: var(--pieza-presentacion-bg);
    }
    &[data-pieza-type='pasodoble'] {
      color: var(--pieza-pasodoble-color);
      background-color: var(--pieza-pasodoble-bg);
    }
    &[data-pieza-type='tango'] {
      color: var(--pieza-tango-color);
      background-color: var(--pieza-tango-bg);
    }
    &[data-pieza-type='estribillo'] {
      color: var(--pieza-estribillo-color);
      background-color: var(--pieza-estribillo-bg);
    }
    &[data-pieza-type='default'] {
      color: var(--pieza-default-color);
      background-color: var(--pieza-default-bg);
    }
  }

  .card-year {
    position: absolute;
    top: 8px;
    left: 4px;
    z-index: 0;
    font-family: 'Roboto Mono', monospace;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 2px 8px;
    border: 2px solid var(--primary-color);
    border-radius: 0;
    background-color: var(--primary-contrast-color);
    color: var(--primary-color);
    line-height: 1;
  }

  .card-body {
    padding: 8px 10px 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background-color: var(--card-background-color);
    border-top: 0;
    margin-top: auto;
  }

  .card-title {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
    padding: 4px 0;
    margin-bottom: 0;
    color: var(--primary-color);
    line-height: 1.2;
    text-wrap: balance;
  }

  .card-meta {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    border-top: 2px solid var(--primary-color);
    padding-top: 8px;
    margin-top: 2px;
  }

  .card-authors {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--primary-color);
  }

  .card-author-names {
    flex: 1 1 0;
    min-width: 0;
    white-space: normal;
    overflow: visible;
    align-self: flex-start;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 4px;
  }

  .card-author-names a {
    color: var(--link-color);
    text-decoration: none;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 640px) {
    .card {
      box-shadow: 4px 4px 0 0 var(--primary-color);

      &:hover {
        transform: none;
        box-shadow: 4px 4px 0 0 var(--primary-color);
      }
    }

    .card-image {
      height: 180px;
    }

    .card-body {
      padding: 8px 5px 8px 5px;
    }

    .card-header,
    .card-year {
      left: 5px;
    }

    .card-title {
      font-size: 0.9rem;
    }

    .card-authors {
      font-size: 0.85rem;
    }
  }
</style>