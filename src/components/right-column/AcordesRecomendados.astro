---
import RightColumnCard from '../../layouts/RightColumnCard.astro';

const { class: className, recomendadas = [] } = Astro.props;
---

{
  recomendadas.length > 0 && (
    <RightColumnCard
      title='Coplas para el recuerdo'
      headingId='recomendados-heading'
      class={className}>
      <section class:list={['card', className]} aria-labelledby='recomendados-heading'>
        <ul>
          {recomendadas.map((acorde: any, i: number) => (
            <li>
              <a
                href={`/acordes/${acorde.slug}`}
                data-ga-event='coplas_recuerdo_click'
                data-ga-params={JSON.stringify({ link_label: acorde.slug, position: i })}>
                {acorde.data.pieza}&nbsp;{acorde.data.agrupacion}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </RightColumnCard>
  )
}

<style>
  /* Layout */
  section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;

    display: flex;
    flex-direction: column;
    gap: 6px;

    & li {
      font-size: 0.95em;

      & a {
        color: var(--acorde-color);
        text-decoration: none;

        &:hover,
        &:focus {
          /* text-decoration: underline; */
        }
      }
    }
  }
</style>

<script>
  declare const gtag: (...args: unknown[]) => void;

  function setupCoplasRecuerdoTracking() {
    const links = document.querySelectorAll('[data-ga-event="coplas_recuerdo_click"]');
    links.forEach((link) => {
      if (link.getAttribute('data-tracking-init')) return;
      link.setAttribute('data-tracking-init', 'true');

      link.addEventListener('click', () => {
        if (typeof gtag === 'function') {
          const eventName = link.getAttribute('data-ga-event');
          const eventParams = JSON.parse(link.getAttribute('data-ga-params') || '{}');
          gtag('event', eventName, {
            ...eventParams,
            page_location: window.location.href,
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCoplasRecuerdoTracking);
  } else {
    setupCoplasRecuerdoTracking();
  }
</script>
