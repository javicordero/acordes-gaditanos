---
import RightColumnCard from '../../layouts/RightColumnCard.astro';

const { class: className } = Astro.props;
---

<RightColumnCard title='Pedir una copla' headingId='pedir-copla-title' class={className}>
  <section class='card' aria-labelledby='pedir-copla-heading'>
    <p>
      ¿Echas en falta alguna copla? Deja un comentario en el formulario de abajo y la subiremos cuando podamos.
    </p>
    <a href='/pedir-copla' class='btn-pedir'>Pedir copla</a>
  </section>
</RightColumnCard>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-color);
  }

  .btn-pedir {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    background: var(--primary-contrast-color, #c2185b);
    color: var(--on-bright-color);
    text-align: center;
    padding: 10px 16px;
    border: 2px solid var(--on-bright-color);
    border-radius: 0;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 3px 3px 0 0 var(--on-bright-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .btn-pedir:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 0 var(--on-bright-color);
  }
</style>
