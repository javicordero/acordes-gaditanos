---
const { class: className, mndazid = '04772000-82d3-4bd1-aa64-6c2df4ab44fc' } = Astro.props;
---

<div
  class={`native-1x1${className ? ` ${className}` : ''}`}
  role='region'
  aria-label='Anuncio nativo Mondiad'>
  <div data-mndazid={mndazid}></div>
</div>

<style>
  .native-1x1 {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .native-1x1.w-75 {
    width: 75%;
  }

  .native-1x1 > div {
    width: 100%;
    margin: 0 auto;
  }
</style>
