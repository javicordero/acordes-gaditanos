---
const { class: className } = Astro.props;
---

<div
  class={`native-2x1${className ? ` ${className}` : ''}`}
  role='region'
  aria-label='Anuncio nativo Mondiad'>
  <div data-mndazid='04772000-82d3-4bd1-aa64-6c2df4ab44fc'></div>
</div>

<style>
  .native-2x1 {
    display: flex;
    justify-content: center;
    width: 75%;

    @media (max-width: 768px) {
      width: 100%;
    }
  }

  .native-2x1 > div {
    width: 100%;
    margin: 0 auto;
  }
</style>
