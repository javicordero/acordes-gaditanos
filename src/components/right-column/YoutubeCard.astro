---
import RightColumnCard from '../../layouts/RightColumnCard.astro';

const { link, title, headingId, iframeTitle, class: className, flush = false } = Astro.props;

const hasTitle = Boolean(title);
// Use an explicit, human-friendly id by default so other nodes can reference it.
const headingIdFinal =
  headingId ??
  (hasTitle
    ? `youtube-${String(title)
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '')}`
    : undefined);
const iframeTitleText = iframeTitle ?? 'Video de la agrupación del Carnaval de Cádiz';
---

<RightColumnCard title={title} headingId={headingIdFinal} class={className} flush={flush}>
  <section aria-labelledby={headingIdFinal}>
    <iframe
      class:list={[{ 'is-flush': flush }]}
      src={link}
      title={iframeTitleText}
      frameborder='0'
      allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
      referrerpolicy='strict-origin-when-cross-origin'
      allowfullscreen
      loading='lazy'></iframe>
  </section>
</RightColumnCard>

<style>
  iframe {
    border: 2px solid var(--primary-color);
    border-radius: 0;
    width: 100%;
    height: 180px;
    position: relative;
    top: 2px;
    display: block;
  }

  iframe.is-flush {
    border: none;
  }

  /* @media (--mq-sm) {
   */
  @media (max-width: 640px) {
    iframe {
      height: 200px;
    }
  }
</style>
