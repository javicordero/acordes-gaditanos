---
import { Icon } from 'astro-icon/components';
import RightColumnCard from '../../layouts/RightColumnCard.astro';

const {
  class: className,
  agrupacion,
  year,
  letraList = [],
  musicaList = [],
  letraSlugs = [],
  musicaSlugs = [],
  agrupacionSlug,
} = Astro.props;
---

<RightColumnCard title='Sigue Tocando' headingId='sigue-tocando-heading' class={className}>
  <section class:list={['card', className]} aria-labelledby='sigue-tocando-heading'>
    <ul>
      {
        musicaList.length > 0
          ? musicaList.map((nombre: string, i: number) => (
              <li>
                Más músicas de{' '}
                <a
                  href={`/autor/musica/${musicaSlugs[i] || ''}`}
                  data-ga-event='sigue_tocando_click'
                  data-ga-params='{"link_type":"autor_musica"}'>
                  {nombre}
                </a>
              </li>
            ))
          : null
      }
      {
        letraList.length > 0
          ? letraList.map((nombre: string, i: number) => (
              <li>
                Más letras de{' '}
                <a
                  href={`/autor/letra/${letraSlugs[i] || ''}`}
                  data-ga-event='sigue_tocando_click'
                  data-ga-params='{"link_type":"autor_letra"}'>
                  {nombre}
                </a>
              </li>
            ))
          : null
      }
      <li>
        Más de{' '}
        <a
          href={`/agrupacion/${agrupacionSlug}`}
          data-ga-event='sigue_tocando_click'
          data-ga-params='{"link_type":"agrupacion"}'>
          {agrupacion}
        </a>
      </li>
      <li>
        Más de{' '}
        <a
          href={`/carnaval/${year}`}
          data-ga-event='sigue_tocando_click'
          data-ga-params='{"link_type":"year"}'>
          {year}
        </a>
      </li>
    </ul>
  </section>
</RightColumnCard>

<style>
  /* Layout */
  section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;

    display: flex;
    flex-direction: column;
    gap: 6px;

    & li {
      font-size: 0.95em;

      & a {
        color: var(--acorde-color);
        text-decoration: none;

        &:hover,
        &:focus {
          /* text-decoration: underline; */
        }
      }
    }
  }
</style>

<script>
  declare const gtag: (...args: unknown[]) => void;

  function setupSigueTocandoTracking() {
    const links = document.querySelectorAll('[data-ga-event="sigue_tocando_click"]');
    links.forEach((link) => {
      if (link.getAttribute('data-tracking-init')) return;
      link.setAttribute('data-tracking-init', 'true');

      link.addEventListener('click', () => {
        if (typeof gtag === 'function') {
          const eventName = link.getAttribute('data-ga-event');
          const eventParams = JSON.parse(link.getAttribute('data-ga-params') || '{}');
          gtag('event', eventName, {
            ...eventParams,
            page_location: window.location.href,
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSigueTocandoTracking);
  } else {
    setupSigueTocandoTracking();
  }
</script>
