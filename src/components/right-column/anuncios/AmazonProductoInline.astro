---
import {
  etiquetaTipo,
  eventoAmazon,
  miniaturaAmazon,
  type ProductoAmazon,
} from '../../../data/afiliados-amazon';

interface Props {
  producto: ProductoAmazon;
  class?: string;
  mostrarPrecios?: boolean;
}

const { producto, class: className, mostrarPrecios = false } = Astro.props;
---

<aside
  class:list={['amazon-inline', className]}
  data-nosnippet
  data-amazon-inline
  data-producto-id={producto.id}
  data-producto-nombre={producto.nombre}
  aria-label='Producto recomendado'
>
  <a
    class='amazon-inline__principal'
    href={producto.url}
    target='_blank'
    rel='sponsored noopener noreferrer'
    data-ga-categoria='amazon'
    data-ga-event={eventoAmazon(producto.id, 'inline', 'click')}
    data-ga-params={JSON.stringify({ producto: producto.nombre })}
  >
    <img
      src={miniaturaAmazon(producto.imagen)}
      alt=''
      width='44'
      height='56'
      loading='lazy'
      decoding='async'
    />
    <span class='amazon-inline__texto'>
      <strong>{producto.nombre}</strong>
      <small>{producto.autor || etiquetaTipo(producto.tipo)}</small>
      {mostrarPrecios && (
        <span
          class='amazon-precio'
          data-amazon-precio
          data-producto-id={producto.id}
          hidden
        />
      )}
    </span>
  </a>
  <a
    class='amazon-inline__cta'
    href={producto.url}
    target='_blank'
    rel='sponsored noopener noreferrer'
    data-ga-categoria='amazon'
    data-ga-event={eventoAmazon(producto.id, 'inline', 'click')}
    data-ga-params={JSON.stringify({ producto: producto.nombre })}
    aria-label={`Ver ${producto.nombre} en Amazon (enlace de afiliado)`}
    title='Enlace de afiliado de Amazon'
  >
    Ver en Amazon
    <svg
      class='amazon-inline__flecha'
      viewBox='0 0 16 16'
      width='12'
      height='12'
      fill='none'
      aria-hidden='true'
      focusable='false'
    >
      <path
        d='M4 12L12 4M6 4h6v6'
        stroke='currentColor'
        stroke-width='2'
        stroke-linecap='square'
      />
    </svg>
  </a>
</aside>

<script>
  import { enviarEvento, seguirEnlaces } from '../../../lib/analitica';
  import { eventoAmazon } from '../../../data/afiliados-amazon';

  function iniciar() {
    seguirEnlaces('[data-ga-event^="click_amazon"]', 'amazon');

    const el = document.querySelector<HTMLElement>('[data-amazon-inline]');
    if (!el || el.dataset.visto === '1') return;

    const enviar = () => {
      if (el.dataset.visto === '1') return;
      const id = el.dataset.productoId;
      if (!id) return;
      el.dataset.visto = '1';
      const w = window as any;
      const parametros: Record<string, unknown> = {
        producto: el.dataset.productoNombre || '',
      };
      if (w.__agAmazonExperimento) {
        parametros.variante = w.__agAmazonVariante || 'a';
      }
      enviarEvento(
        eventoAmazon(id, 'inline', 'view'),
        parametros,
        'amazon',
      );
    };

    if ('IntersectionObserver' in window) {
      const observador = new IntersectionObserver(
        (entradas) => {
          if (!entradas.some((entrada) => entrada.isIntersecting)) return;
          enviar();
          observador.disconnect();
        },
        { threshold: 0.5 },
      );
      observador.observe(el);
    } else {
      enviar();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }
</script>

<style>
  .amazon-inline {
    width: 100%;
    max-width: 430px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 9px;
    border: 2px solid var(--primary-color);
    background-color: var(--card-background-color);
    box-shadow: 3px 3px 0 0 var(--primary-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .amazon-inline:hover,
  .amazon-inline:focus-within {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 0 var(--primary-contrast-color);
  }

  .amazon-inline__principal {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
    color: var(--primary-color);
    text-decoration: none;
  }

  .amazon-inline img {
    flex: none;
    width: 44px;
    height: 56px;
    object-fit: contain;
    background-color: #fff;
    border: 1px solid rgba(128, 128, 128, 0.35);
  }

  .amazon-inline__texto {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .amazon-inline__texto strong {
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .amazon-inline__texto small {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--text-secondary-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .amazon-precio {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.74rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--primary-color);
  }

  .amazon-inline__cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 6px;
    border: 2px solid var(--primary-color);
    background-color: var(--primary-contrast-color);
    color: var(--on-bright-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.4px;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .amazon-inline__flecha {
    flex: none;
    display: block;
    width: 12px;
    height: 12px;
  }
</style>
