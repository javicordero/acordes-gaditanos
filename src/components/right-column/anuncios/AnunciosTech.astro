    name: 'Sony WH-CH520',
    image: 'https://m.media-amazon.com/images/I/61rFE093esL._AC_SL1500_.jpg',
    url: 'https://amzn.to/4aLm4sV',
  },
];

// Seleccionar productos ordenados por order si existe, el resto aleatorios
function getRandomProducts(arr: Product[], n: number): Product[] {
  // Separar productos con order de los que no lo tienen
  const withOrder = arr
    .filter((p) => p.order !== undefined)
    .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
  const withoutOrder = arr.filter((p) => p.order === undefined);

  // Si tenemos suficientes productos con order, devolver esos
  if (withOrder.length >= n) {
    return withOrder.slice(0, n);
  }

  // Si no, mezclar los ordenados con aleatorios del resto
  const remaining = n - withOrder.length;
  const randomProducts = withoutOrder
    .map((item) => ({ item, sort: Math.random() }))
    .sort((a, b) => a.sort - b.sort)
    .slice(0, remaining)
    .map(({ item }) => item);

  return [...withOrder, ...randomProducts];
}

const randomProducts = getRandomProducts(products, 5);
---

<div data-nosnippet>
  <RightColumnCard title='Tecnología' headingId='para-tu-guitarra-title' class={className}>
    <ul>
      {
        randomProducts.map((product) => (
          <li>
            <a
              href={product.url}
              target='_blank'
              rel='noopener noreferrer'
              onClick={() => {
                if (typeof gtag === 'function') {
                  gtag('event', 'product_click', {
                    event_category: 'anuncios_tech',
                    event_label: product.name,
                    value: product.name,
                  });
                }
              }}>
              <figure>
                <Image
                  src={product.image}
                  alt={product.name}
                  loading='lazy'
                  decoding='async'
                  width={60}
                  height={60}
                />
              </figure>
              <span class='product-name'>{product.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </RightColumnCard>
</div>
<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  li {
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    transition: transform 0.3s ease;
    background-color: white;

    &:hover {
      transform: translateX(2px);
    }
  }

  li a {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.3s ease;

    &:hover {
      background-color: rgba(218, 165, 32, 0.08);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
  }

  figure {
    width: 60px;
    height: 60px;
    margin: 0;
    border-radius: 8px 0 0 8px;
    overflow: hidden;
    background-color: var(--card-background-color);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 0, 0, 0.08);

    & img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 4px;
    }
  }

  .product-name {
    flex: 1;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--primary-color);
    padding-right: 6px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 640px) {
    figure {
      width: 50px;
      height: 50px;
    }

    .product-name {
      font-size: 0.9rem;
    }
  }
</style>
