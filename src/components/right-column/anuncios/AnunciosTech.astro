---
import { Image } from 'astro:assets';
import RightColumnCard from '../../../layouts/RightColumnCard.astro';

const { class: className } = Astro.props;

interface Product {
  name: string;
  image: string;
  url: string;
  always?: boolean;
  order?: number;
}

// Productos de Amazon para guitarras
const products: Product[] = [
  {
    name: 'Amazon Fire TV Stick HD',
    image: 'https://m.media-amazon.com/images/I/51P-NqQI9EL._AC_SL1000_.jpg',
    url: 'https://amzn.to/4lburle',
    always: true,
    order: 1,
  },
  {
    name: 'Xiaomi Redmi Buds 5',
    image: 'https://m.media-amazon.com/images/I/51mnklPh2uL._AC_SL1200_.jpg',
    url: 'https://amzn.to/4rN1O09',
    always: true,
    order: 2,
  },
  {
    name: 'Xiaomi Redmi Note 15',
    image: 'https://m.media-amazon.com/images/I/61t6zUrMp4L._AC_SL1500_.jpg',
    url: 'https://amzn.to/3OJPwqB',
  },
  {
    name: 'INIU Power Bank 10.000mAh',
    image: 'https://m.media-amazon.com/images/I/61BeWTLQBmL._AC_SL1500_.jpg',
    url: 'https://amzn.to/4u6e3X5',
  },
  {
    name: 'Apple AirTag (Localizador)',
    image: 'https://m.media-amazon.com/images/I/61lBuevDnnL._AC_SX342_SY445_QL70_ML2_.jpg',
    url: 'https://amzn.to/4b2Z5Z4',
  },
  {
    name: 'JBL GO 3 (Portátil y resistente)',
    image: 'https://m.media-amazon.com/images/I/71HdLDJEEUL._AC_SL1500_.jpg',
    url: 'https://amzn.to/3MZkJ8A',
  },
  {
    name: 'Samsung Galaxy A55 5G',
    image: 'https://m.media-amazon.com/images/I/71GSpGj86vL._AC_SL1500_.jpg',
    url: 'https://amzn.to/4snY5G5',
  },
  {
    name: 'SanDisk Extreme 128GB',
    image: 'https://m.media-amazon.com/images/I/81Rivcu2p4L._AC_SL1500_.jpg',
    url: 'https://amzn.to/4aLPwPp',
  },
