---
const { adSlot, class: className } = Astro.props;
---

<div class='anuncio-wrapper'>
  <ins
    class:list={['adsbygoogle', className]}
    style='display:block'
    data-ad-client='ca-pub-3280015847198273'
    data-ad-slot={adSlot}
    data-ad-format='auto'
    data-full-width-responsive='true'></ins>
  <script>
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>

<style>
  .anuncio-wrapper:has(ins[data-ad-status='unfilled']) {
    display: none;
  }
</style>
