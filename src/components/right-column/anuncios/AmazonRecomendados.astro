---
import RightColumnCard from '../../../layouts/RightColumnCard.astro';
import {
  etiquetaTipo,
  eventoAmazon,
  miniaturaAmazon,
  type ProductoAmazon,
} from '../../../data/afiliados-amazon';

interface Props {
  productos: ProductoAmazon[];
  class?: string;
  titulo?: string;
  mostrarPrecios?: boolean;
}

const {
  productos,
  class: className,
  titulo = 'Carnaval y guitarra',
  mostrarPrecios = false,
} = Astro.props;
---

{
  productos.length > 0 && (
    <div class:list={['amazon-recomendados', className]} data-nosnippet>
      <RightColumnCard title={titulo} headingId='amazon-recomendados-title'>
        <ul class='amazon-lista'>
          {productos.map((producto) => (
            <li>
              <div
                class='amazon-card'
                data-amazon-item
                data-producto-id={producto.id}
                data-producto-nombre={producto.nombre}
              >
                <a
                  class='amazon-card__principal'
                  href={producto.url}
                  target='_blank'
                  rel='sponsored noopener noreferrer'
                  data-ga-categoria='amazon'
                  data-ga-event={eventoAmazon(producto.id, 'bloque', 'click')}
                  data-ga-params={JSON.stringify({ producto: producto.nombre })}
                >
                  <img
                    src={miniaturaAmazon(producto.imagen)}
                    alt=''
                    width='56'
                    height='72'
                    loading='lazy'
                    decoding='async'
                  />
                  <span class='amazon-info'>
                    <strong>{producto.nombre}</strong>
                    <small>{producto.autor || etiquetaTipo(producto.tipo)}</small>
                    {mostrarPrecios && (
                      <span
                        class='amazon-precio'
                        data-amazon-precio
                        data-producto-id={producto.id}
                        hidden
                      />
                    )}
                  </span>
                </a>
                <a
                  class='amazon-card__cta'
                  href={producto.url}
                  target='_blank'
                  rel='sponsored noopener noreferrer'
                  data-ga-categoria='amazon'
                  data-ga-event={eventoAmazon(producto.id, 'bloque', 'click')}
                  data-ga-params={JSON.stringify({ producto: producto.nombre })}
                  aria-label={`Ver ${producto.nombre} en Amazon`}
                >
                  Ver en Amazon
                  <svg
                    class='amazon-cta__flecha'
                    viewBox='0 0 16 16'
                    width='12'
                    height='12'
                    fill='none'
                    aria-hidden='true'
                    focusable='false'
                  >
                    <path
                      d='M4 12L12 4M6 4h6v6'
                      stroke='currentColor'
                      stroke-width='2'
                      stroke-linecap='square'
                    />
                  </svg>
                </a>
              </div>
            </li>
          ))}
        </ul>
      </RightColumnCard>
      <p class='amazon-aviso'>
        Otra forma de colaborar: si abres uno de estos enlaces de afiliado y
        compras en Amazon después, aunque sea otro producto, podemos recibir una
        pequeña comisión. Sin coste extra para ti.
      </p>
    </div>
  )
}

<script>
  import { enviarEvento, seguirEnlaces } from '../../../lib/analitica';
  import { eventoAmazon } from '../../../data/afiliados-amazon';

  function iniciar() {
    seguirEnlaces('[data-ga-event^="click_amazon"]', 'amazon');

    const items = document.querySelectorAll<HTMLElement>('[data-amazon-item]');
    if (!items.length) return;

    const enviar = (el: HTMLElement) => {
      if (el.dataset.visto === '1') return;
      const id = el.dataset.productoId;
      if (!id) return;
      el.dataset.visto = '1';
      const w = window as any;
      const parametros: Record<string, unknown> = {
        producto: el.dataset.productoNombre || '',
      };
      if (w.__agAmazonExperimento) {
        parametros.variante = w.__agAmazonVariante || 'a';
      }
      enviarEvento(
        eventoAmazon(id, 'bloque', 'view'),
        parametros,
        'amazon',
      );
    };

    if ('IntersectionObserver' in window) {
      const observador = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((entrada) => {
            if (!entrada.isIntersecting) return;
            enviar(entrada.target as HTMLElement);
            observador.unobserve(entrada.target);
          });
        },
        { threshold: 0.5 },
      );
      items.forEach((el) => observador.observe(el));
    } else {
      items.forEach(enviar);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }
</script>

<style>
  .amazon-recomendados {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .amazon-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .amazon-lista li {
    min-width: 0;
  }

  .amazon-card {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--primary-color);
    background-color: var(--card-background-color);
    box-shadow: 3px 3px 0 0 var(--primary-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .amazon-card:hover,
  .amazon-card:focus-within {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 0 var(--primary-contrast-color);
  }

  .amazon-card__principal {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    color: var(--primary-color);
    text-decoration: none;
  }

  .amazon-card__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 4px 8px;
    border-top: 2px solid var(--primary-color);
    background-color: var(--primary-contrast-color);
    color: var(--on-bright-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .amazon-cta__flecha {
    flex: none;
    display: block;
    width: 12px;
    height: 12px;
  }

  .amazon-lista img {
    flex: none;
    width: 56px;
    height: 72px;
    object-fit: contain;
    background-color: #fff;
    border: 1px solid rgba(128, 128, 128, 0.35);
  }

  .amazon-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .amazon-info strong {
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .amazon-info small {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.64rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--text-secondary-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .amazon-precio {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--primary-color);
  }

  .amazon-aviso {
    margin: 0;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--text-secondary-color);
  }
</style>
