---
import RightColumnCard from '../../layouts/RightColumnCard.astro';
import DonationIndicator from '../DonationIndicator.astro';

const { class: className } = Astro.props;
---

<RightColumnCard title='Apoyar' headingId='apoyar-title' class={className}>
  <section class:list={['card', className]} aria-labelledby='apoyar-heading'>
    <p>
      Si estos acordes te han servido para echar un ratito, puedes ayudarnos a seguir subiendo más coplas.
    </p>
    <DonationIndicator variant='compact' listStyle='pills' />
  </section>
</RightColumnCard>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>


