---
import Layout from '../layouts/Layout.astro';
import CommentsSection from '../components/comments/CommentsSection.astro';
import CommentForm from '../components/comments/CommentForm.astro';
import PeticionesStats from '../components/comments/PeticionesStats.astro';
import DonationIndicator from '../components/DonationIndicator.astro';
import CanalCallout from '../components/page/CanalCallout.astro';
---

<Layout
  title='Pedir una copla - Acordes Gaditanos'
  description='¿No encuentras los acordes de una copla del Carnaval de Cádiz? Pídelos aquí y te ayudamos a encontrarlos.'>
  <div class='main-container'>
    <article class='pedir-copla-page container-layout'>
      <header>
        <h1>Pedir una copla</h1>
      </header>

      <div class='pedir-copla-body'>
        <section class='intro'>
          <div class='intro-text'>
            <p>
              ¿Echas en falta alguna copla? Deja un comentario en el formulario de abajo y la subiremos cuando podamos.
            </p>
            <p>
              Si has sacado los acordes de alguna copla puedes enviarlos a
              <a href='mailto:acordesgaditanos@gmail.com'>acordesgaditanos@gmail.com</a>
              y los subiremos.
            </p>
          </div>
          <CanalCallout
            titulo='¿Te aviso cuando suba la copla que pides?'
            ubicacion='pedir-copla'
            variante='destacado'
          />

          <PeticionesStats />
          <div class='pedir-copla-donations'>
            <DonationIndicator variant='timeline' messageC='Ayuda a que siga subiendo más coplas' listStyle='pills' />
          </div>
        </section>

        <section class='top-peticiones' id='top-peticiones-section' hidden>
          <h2 class='top-peticiones__title'>Peticiones más votadas</h2>
          <div class='top-peticiones__list' id='top-peticiones'></div>
        </section>

        <section class='form-section'>
          <h2>Escribe tu petición</h2>
          <CommentForm placeholder='¿Qué copla buscas? Escribe el nombre de la agrupación y la pieza...' />
        </section>

        <section class='comments-section'>
          <CommentsSection path='/pedir-copla' title='Peticiones recientes' />
        </section>
      </div>
    </article>
  </div>
</Layout>

<style>
  .pedir-copla-page {
    position: relative;
    border-radius: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  header h1 {
    margin: 0;
    color: var(--primary-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    position: relative;
    max-width: fit-content;

    &::after {
      content: '';
      display: block;
      position: absolute;
      left: 0;
      bottom: -8px;
      width: 95%;
      height: 6px;
      background: var(--primary-contrast-color);
    }
  }

  .pedir-copla-body {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap);

    & p {
      text-wrap: balance;
    }
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap-sm);

    & p {
      margin: 0;
      line-height: 1.6;
      color: var(--text-color);
      font-size: 1rem;
    }

    & .intro-text {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    & a {
      color: var(--link-color);
      font-weight: 700;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 3px;
    }
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap-sm);

    & h2 {
      margin: 0;
      color: var(--primary-color);
      font-family: 'Roboto Mono', monospace;
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      position: relative;
      max-width: fit-content;

      &::after {
        content: '';
        display: block;
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 95%;
        height: 5px;
        background: var(--primary-contrast-color);
        border-radius: 0;
      }
    }
  }

  @media (max-width: 768px) {
    header h1 {
      font-size: 1.5rem;
    }

    .pedir-copla-body {
      gap: var(--main-container-gap-sm);
    }
  }

  :global(section.donation-indicator.timeline .donation-indicator__widget) {
    background: var(--card-background-color);
    border: 2px solid var(--primary-color);
    box-shadow: none;
  }

  :global(section.donation-indicator.timeline .donation-indicator__message-c) {
    color: var(--text-color, #333) !important;
  }

  :global(section.donation-indicator.timeline .donation-indicator__count) {
    color: var(--acorde-color) !important;
  }

  :global(section.donation-indicator.timeline .donation-indicator__count-label) {
    color: var(--text-color, #333) !important;
  }

  :global(section.donation-indicator.timeline .pill) {
    color: var(--acorde-color);
    border-color: rgba(0, 68, 204, 0.3);
  }

  :global(section.donation-indicator.timeline .pill--more) {
    color: var(--secondary-color, #888);
  }

  :global(section.donation-indicator.timeline .donation-indicator--empty p) {
    color: var(--text-color, #333) !important;
  }
</style>

<script>
  async function loadTopPeticiones() {
    const section = document.getElementById('top-peticiones-section');
    const list = document.getElementById('top-peticiones');
    if (!section || !list) return;

    try {
      const { COMMENTS_CONFIG } = await import('../lib/comments.ts');
      const res = await fetch(`${COMMENTS_CONFIG.workerUrl}/top?path=${encodeURIComponent('/pedir-copla')}&limit=3`);
      const data = await res.json();
      const top = data.top || [];

      if (top.length === 0) {
        section.hidden = true;
        return;
      }

      list.innerHTML = top.map((p) => `
        <div class='top-peticiones__item'>
          <span class='top-peticiones__content'>${escapeHtml(p.content)}</span>
          <span class='top-peticiones__votes'>
            <svg width='14' height='14' viewBox='0 0 24 24' fill='#e74c3c' stroke='none'><path d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'/></svg>
            ${p.votes ?? 0}
          </span>
        </div>
      `).join('');

      section.hidden = false;
    } catch {
      section.hidden = true;
    }
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  (window as any).__reloadTopPeticiones = loadTopPeticiones;

  loadTopPeticiones();
  document.addEventListener('astro:page-load', loadTopPeticiones);
</script>
