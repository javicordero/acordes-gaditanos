---
import Layout from '../layouts/Layout.astro';
import CommentsSection from '../components/comments/CommentsSection.astro';
import CommentForm from '../components/comments/CommentForm.astro';
import Anuncio from '../components/right-column/anuncios/Anuncio.astro';
---

<Layout
  title='Pedir una copla - Acordes Gaditanos'
  description='¿No encuentras los acordes de una copla del Carnaval de Cádiz? Pídelos aquí y te ayudamos a encontrarlos.'>
  <div class='main-container'>
    <article class='pedir-copla-page container-layout'>
      <header>
        <h1>Pedir una copla</h1>
      </header>

      <div class='pedir-copla-body'>
        <section class='intro'>
          <p>
            ¿No encuentras los acordes de alguna copla del Carnaval de Cádiz? Déjanos un comentario
            con el nombre de la agrupación y la pieza, e intentaremos subirla lo antes posible.
          </p>
        </section>

        <Anuncio adSlot='6941813836' />

        <section class='form-section'>
          <h2>Escribe tu petición</h2>
          <CommentForm placeholder='¿Qué copla buscas? Escribe el nombre de la agrupación y la pieza...' />
        </section>

        <section class='comments-section'>
          <CommentsSection path='/pedir-copla' title='Peticiones recientes' />
        </section>
      </div>
    </article>
  </div>
</Layout>

<style>
  .pedir-copla-page {
    position: relative;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  header h1 {
    margin: 0;
    color: var(--primary-color);
    font-size: 2rem;
    position: relative;
    max-width: fit-content;

    &::after {
      content: '';
      display: block;
      position: absolute;
      left: 0;
      bottom: -8px;
      width: 90%;
      height: 4px;
      background: var(--primary-contrast-color);
    }
  }

  .pedir-copla-body {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap-sm);

    & p {
      margin: 0;
      line-height: 1.6;
      color: var(--text-color);
      font-size: 1rem;
    }
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap-sm);

    & h2 {
      margin: 0;
      color: var(--primary-color);
      font-size: 1.25rem;
      position: relative;
      max-width: fit-content;

      &::after {
        content: '';
        display: block;
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 90%;
        height: 3px;
        background: var(--primary-contrast-color);
        border-radius: 2px;
      }
    }
  }

  @media (max-width: 768px) {
    header h1 {
      font-size: 1.5rem;
    }

    .pedir-copla-body {
      gap: 24px;
    }
  }
</style>
