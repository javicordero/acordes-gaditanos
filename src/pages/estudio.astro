---
// Panel privado de edición (solo el propietario, con login de GitHub).
//
// Vive en /estudio, no está enlazado desde la web, va con noindex y fuera del
// sitemap. Las funciones de /estudio/api/* son las que hablan con GitHub: la
// página solo manda el `.md` ya montado.

export const prerender = true;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Estudio · Acordes Gaditanos</title>
<style is:global>
  :root { --tinta:#1d1a16; --papel:#fbf8f1; --suave:#8a8175; --linea:#e2dacb; --acento:#b4552b; --ok:#3d7a4a; --nuevo:#b07d12; --mal:#b3261e; }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html, body { height: 100%; }
  body { margin:0; background:var(--papel); color:var(--tinta); font:14px/1.45 system-ui, -apple-system, Segoe UI, sans-serif; display:flex; flex-direction:column; }
  a { color:var(--acento); }
  header { flex:0 0 auto; border-bottom:1px solid var(--linea); padding:8px 14px; display:flex; gap:10px; align-items:baseline; flex-wrap:wrap; }
  h1 { font-size:15px; margin:0; font-weight:650; }
  h1 a { color:inherit; text-decoration:none; }
  h1 a:hover, h1 a:focus-visible { text-decoration:underline; }
  .meta { color:var(--suave); font-size:12.5px; }
  .barra { display:flex; gap:8px; align-items:center; margin-left:auto; flex-wrap:wrap; }
  button, .boton { font:inherit; font-size:12.5px; padding:5px 10px; border:1px solid var(--linea); background:#fff; color:var(--tinta); border-radius:6px; cursor:pointer; text-decoration:none; display:inline-block; }
  button:hover, .boton:hover { border-color:var(--acento); color:var(--acento); }
  button.principal { background:var(--acento); border-color:var(--acento); color:#fff; }
  button.principal:hover { color:#fff; filter:brightness(1.08); }
  button:disabled { opacity:.4; cursor:default; }
  .estado { font-size:12px; color:var(--suave); }
  .estado.ok { color:var(--ok); }
  .estado.mal { color:var(--mal); }
  main { flex:1 1 0; min-height:0; overflow:hidden; display:flex; }
  #login { flex:1; display:flex; align-items:center; justify-content:center; padding:24px; }
  #login[hidden] { display:none; }
  #login .caja { max-width:420px; text-align:center; }
  #login h2 { font-size:18px; margin:0 0 6px; }
  #login p { color:var(--suave); }
  /* lista */
  #vista-lista { flex:1; overflow:auto; background:var(--papel); }
  .lista-cab { position:sticky; top:0; z-index:4; display:grid; gap:9px; padding:12px 14px 10px; background:var(--papel); border-bottom:1px solid var(--linea); }
  .lista-cab > * { width:100%; max-width:840px; margin:0 auto; }
  .buscador { position:relative; display:flex; align-items:center; }
  .buscador .lupa { position:absolute; left:11px; width:15px; height:15px; fill:none; stroke:var(--suave); stroke-width:2; stroke-linecap:round; pointer-events:none; }
  .buscador input { flex:1; width:100%; font:inherit; font-size:15px; color:var(--tinta); background:#fff; border:1px solid var(--linea); border-radius:10px; padding:10px 38px 10px 34px; }
  .buscador input::placeholder { color:var(--suave); }
  .buscador input:focus { outline:none; border-color:var(--acento); box-shadow:0 0 0 3px rgba(180,85,43,.13); }
  .buscador input::-webkit-search-cancel-button { display:none; }
  .limpiar { position:absolute; right:5px; width:28px; height:28px; padding:0; border:0; border-radius:50%; background:transparent; color:var(--suave); font-size:13px; line-height:1; }
  .limpiar:hover { color:var(--acento); background:#f6efe3; }
  .filtros { display:flex; gap:6px; overflow-x:auto; scrollbar-width:none; }
  .filtros::-webkit-scrollbar { display:none; }
  .filtros button { flex:0 0 auto; display:inline-flex; align-items:center; gap:6px; padding:5px 11px; border-radius:999px; border:1px solid var(--linea); background:#fff; color:var(--suave); font-size:12.5px; }
  .filtros button.sel { background:var(--tinta); border-color:var(--tinta); color:#fff; }
  .filtros button.sel .cuenta { color:#fff; opacity:.65; }
  .filtros .cuenta { font-size:11px; font-variant-numeric:tabular-nums; opacity:.85; }
  .lista-cuerpo { max-width:840px; margin:0 auto; padding:4px 14px 28px; }
  .grupo { display:flex; align-items:center; gap:10px; padding:15px 2px 7px; }
  .grupo-tit { font-size:11px; font-weight:650; letter-spacing:.1em; text-transform:uppercase; color:var(--suave); }
  .grupo i { flex:1; height:1px; background:var(--linea); }
  .grupo-n { font-size:11px; color:var(--suave); font-variant-numeric:tabular-nums; }
  .grupo.pend .grupo-tit { color:var(--nuevo); }
  .filas { display:grid; gap:6px; }
  .fila { display:grid; grid-template-columns:minmax(0, 1fr) auto; align-items:center; gap:8px; padding:8px 10px; background:#fff; border:1px solid var(--linea); border-radius:10px; }
  .fila:hover { border-color:#d3c4ab; }
  .fila.pendiente { border-left:3px solid var(--nuevo); }
  .fila-info { display:grid; gap:3px; min-width:0; padding:2px 0; border:0; border-radius:6px; background:transparent; font:inherit; color:inherit; text-align:left; cursor:pointer; }
  .fila-info:hover .f-agr { color:var(--acento); }
  .f-agr { font-size:14px; font-weight:600; line-height:1.25; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .f-meta { display:flex; flex-wrap:wrap; align-items:center; gap:6px; font-size:11.5px; line-height:1.3; color:var(--suave); }
  .f-year { font-variant-numeric:tabular-nums; background:var(--papel); border:1px solid var(--linea); border-radius:999px; padding:0 6px; }
  .f-letra { font-style:italic; }
  .f-meta .marca { vertical-align:0; }
  .fila-acciones { display:flex; align-items:center; gap:5px; }
  .fila-acciones .acc { padding:4px 9px; font-size:12px; border-radius:7px; background:#fff; }
  .fila-acciones .acc.icono { padding:4px 8px; font-size:13px; }
  .fila-acciones .acc.principal { background:var(--acento); border-color:var(--acento); color:#fff; }
  .fila-acciones .acc.principal:hover { color:#fff; filter:brightness(1.08); }
  .lista-vacio { padding:44px 10px; text-align:center; color:var(--suave); font-size:13px; }
  .lista-vacio b { display:block; margin-bottom:4px; color:var(--tinta); font-size:14px; }
  .lista-tope { padding-top:14px; text-align:center; color:var(--suave); font-size:11.5px; }
  .marca { display:inline-block; font-size:10px; letter-spacing:.06em; color:#fff; background:var(--nuevo); border-radius:4px; padding:0 4px; vertical-align:1px; }
  .marca.pr { background:var(--acento); }
  .marca.local { background:var(--suave); }
  .nota { margin:0 0 10px; font-size:12px; color:var(--suave); line-height:1.4; }
  /* datos de la ficha */
  .datos { flex:0 0 auto; background:#fff; border-bottom:1px solid var(--linea); }
  .datos > summary { display:flex; align-items:center; gap:9px; padding:7px 12px; cursor:pointer; list-style:none; overflow:hidden; }
  .datos > summary::-webkit-details-marker { display:none; }
  .datos > summary::before { content:'▸'; color:var(--suave); font-size:11px; flex:0 0 auto; }
  .datos[open] > summary::before { content:'▾'; }
  .datos-tit { font-size:11px; font-weight:650; letter-spacing:.06em; text-transform:uppercase; color:var(--suave); flex:0 0 auto; }
  .datos-resumen { font-size:12px; color:var(--tinta); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0; }
  .datos-slug { margin-left:auto; min-width:0; font:10.5px ui-monospace, monospace; color:var(--suave); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .datos-slug.mal { color:var(--mal); }
  .datos-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(165px, 1fr)); gap:8px 10px; padding:0 12px 12px; max-height:40vh; overflow:auto; }
  .datos-grid .campo { margin:0; }
  .datos-grid .ancho { grid-column:1 / -1; }
  @media (max-width: 620px) {
    .datos-resumen { display:none; }
    .datos-grid { grid-template-columns:1fr; max-height:46vh; }
  }
  /* editor */
  #vista-editor { flex:1; display:flex; flex-direction:column; min-height:0; }
  #vista-editor[hidden] { display:none; }
  .cols { flex:1; display:grid; grid-template-columns: 1fr 1.35fr 1fr; min-height:0; }
  .cols.una { grid-template-columns: 1fr; }
  .cols.sin-base { grid-template-columns: 1.35fr 1fr; }
  .pane { min-width:0; min-height:0; display:flex; flex-direction:column; border-right:1px solid var(--linea); }
  .pane:last-child { border-right:0; }
  .cab { padding:5px 10px; font-size:10.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--suave); border-bottom:1px solid var(--linea); display:flex; gap:8px; align-items:center; }
  .cab b { color:var(--tinta); font-weight:600; letter-spacing:0; text-transform:none; font-size:12px; }
  #base-sel { flex:1; min-width:0; max-width:100%; font:11px system-ui, sans-serif; padding:1px 3px; border:1px solid var(--linea); border-radius:4px; background:#fff; color:var(--tinta); }
  .lienzo { position:relative; flex:1; min-height:0; overflow:hidden; }
  .pane pre, .lienzo textarea { margin:0; padding:12px 14px; border:0; width:100%; height:100%; font:13px/1.55 ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace; white-space:pre; overflow:auto; tab-size:4; }
  .pane pre { color:var(--tinta); }
  .lienzo textarea { position:absolute; inset:0; resize:none; background:transparent; color:transparent; caret-color:var(--acento); outline:none; }
  .lienzo textarea::selection { background:rgba(180,85,43,.22); }
  #capa { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .ac { color:var(--acento); }
  .nuevo { color:var(--nuevo); text-decoration:underline dotted; }
  .anot { color:var(--suave); }
  footer { flex:0 0 auto; border-top:1px solid var(--linea); padding:5px 12px; font-size:11.5px; color:var(--suave); display:flex; gap:12px; flex-wrap:wrap; }
  kbd { font:11px ui-monospace, monospace; border:1px solid var(--linea); border-bottom-width:2px; border-radius:4px; padding:0 4px; background:#fff; }
  #sug { position:fixed; z-index:30; background:#fff; border:1px solid var(--linea); border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,.15); padding:4px; display:none; max-height:200px; overflow:auto; }
  #sug button { display:block; width:100%; text-align:left; border:0; border-radius:5px; padding:3px 8px; font:12.5px ui-monospace, monospace; background:transparent; }
  #sug button.sel, #sug button:hover { background:#f2e3d8; color:var(--acento); }
  #aviso { position:fixed; left:12px; right:12px; bottom:12px; z-index:25; background:#fff; border:1px solid var(--linea); border-left:4px solid var(--acento); border-radius:8px; padding:10px 12px; font-size:12.5px; display:none; white-space:pre-wrap; box-shadow:0 8px 24px rgba(0,0,0,.12); max-height:45vh; overflow:auto; }
  #aviso .cerrar { float:right; margin-left:10px; }
  dialog { border:1px solid var(--linea); border-radius:10px; padding:0; width:min(560px, 94vw); }
  dialog::backdrop { background:rgba(29,26,22,.35); }
  dialog form, dialog .cuerpo { padding:16px; }
  dialog h2 { margin:0 0 10px; font-size:16px; }
  .campo { display:grid; gap:3px; margin-bottom:9px; }
  .campo label { font-size:11.5px; color:var(--suave); text-transform:uppercase; letter-spacing:.05em; }
  .campo input, .campo select, .campo textarea { font:inherit; padding:6px 8px; border:1px solid var(--linea); border-radius:6px; background:#fff; }
  .campo textarea { width:100%; height:auto; min-height:80px; color:var(--tinta); background:#fff; font-family:ui-monospace, monospace; font-size:12.5px; white-space:pre-wrap; resize:vertical; }
  .campo textarea:focus { outline:none; border-color:var(--acento); box-shadow:0 0 0 3px rgba(180,85,43,.13); }
  .dos { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .acciones { display:flex; gap:8px; justify-content:flex-end; margin-top:8px; }
  .tabs { display:none; }
  @media (max-width: 620px) {
    .lista-cab { padding:10px 10px 8px; }
    .lista-cuerpo { padding:2px 10px 24px; }
    .fila { grid-template-columns:1fr; gap:5px; }
    .fila-acciones { justify-content:flex-end; }
    .f-agr { white-space:normal; }
    .dos { grid-template-columns:1fr; }
  }
  @media (max-width: 900px) {
    .cols, .cols.sin-base { grid-template-columns: 1fr; }
    .pane { display:none; }
    .pane.activo { display:flex; }
    .tabs { display:flex; gap:6px; padding:6px 10px; border-bottom:1px solid var(--linea); }
    .tabs button { flex:1; }
    .tabs button.sel { background:var(--acento); border-color:var(--acento); color:#fff; }
    .mover { display:flex; }
  }
  .mover { display:none; gap:6px; padding:6px 10px; border-top:1px solid var(--linea); }
  .mover button { flex:1; padding:9px; font-size:15px; }
</style>
</head>
<body>
<header>
  <h1><a href="/estudio/" id="b-inicio" title="Volver al inicio del estudio">Estudio</a></h1>
  <span class="meta" id="cab-meta"></span>
  <span class="estado" id="cab-estado"></span>
  <div class="barra">
    <button id="b-lista" hidden>← Lista</button>
    <button id="b-nueva" hidden>Nueva ficha</button>
    <button id="b-letra" hidden>＋ Letra</button>
    <button id="b-publicar" hidden title="Pasa el borrador a acordes y abre la PR">Publicar</button>
    <button id="b-comprobar" hidden>Comprobar</button>
    <button id="b-pr" hidden>Ver PR</button>
    <button id="b-fusionar" hidden>Fusionar</button>
    <button id="b-avisos" hidden>Avisos</button>
    <button id="b-guardar" class="principal" hidden>Guardar</button>
    <span id="quien" class="meta"></span>
  </div>
</header>

<main>
  <div id="login">
    <div class="caja">
      <h2>Panel privado</h2>
      <p>Solo el propietario. Entra con tu cuenta de GitHub.</p>
      <a class="boton" href="/estudio/api/auth" style="background:var(--acento);color:#fff;border-color:var(--acento);padding:8px 14px">Entrar con GitHub</a>
    </div>
  </div>

  <div id="vista-lista" hidden>
    <div class="lista-cab">
      <div class="buscador">
        <svg class="lupa" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line></svg>
        <input id="q" type="search" placeholder="Buscar pieza, agrupación, año o título…" autocomplete="off">
        <button id="q-limpiar" class="limpiar" type="button" aria-label="Limpiar la búsqueda" hidden>✕</button>
      </div>
      <div class="filtros" id="filtros">
        <button type="button" data-filtro="todas" class="sel">Todas <span class="cuenta" data-cuenta="todas"></span></button>
        <button type="button" data-filtro="pendientes" title="Borradores de acordes3 y fichas con una PR abierta">Acordes3 <span class="cuenta" data-cuenta="pendientes"></span></button>
        <button type="button" data-filtro="publicadas" title="Fichas de acordes (publicadas)">Acordes <span class="cuenta" data-cuenta="publicadas"></span></button>
      </div>
    </div>
    <div class="lista-cuerpo">
      <div class="filas" id="filas"></div>
      <p class="lista-vacio" id="lista-vacio" hidden></p>
      <p class="lista-tope" id="lista-tope" hidden>Mostrando las 300 primeras. Afina la búsqueda para ver el resto.</p>
    </div>
  </div>

  <div id="vista-editor" hidden>
    <details class="datos" id="datos">
      <summary>
        <span class="datos-tit">Datos</span>
        <span class="datos-resumen" id="datos-resumen"></span>
        <span class="datos-slug" id="datos-slug"></span>
      </summary>
      <div class="datos-grid" id="f-datos">
        <div class="campo"><label>Pieza</label><input name="pieza" required></div>
        <div class="campo"><label>Agrupación</label><input name="agrupacion" required></div>
        <div class="campo"><label>Año</label><input name="year" inputmode="numeric" required></div>
        <div class="campo"><label>Cejilla</label><input name="cejilla" inputmode="numeric" placeholder="—"></div>
        <div class="campo"><label>Música</label><input name="musica" placeholder="autores separados por coma"></div>
        <div class="campo"><label>Letra</label><input name="letra" placeholder="autores separados por coma"></div>
        <div class="campo"><label>Título de la letra</label><input name="letraTitulo" placeholder="solo letras alternativas"></div>
        <div class="campo"><label>Frase clave</label><input name="fraseClave"></div>
        <div class="campo ancho"><label>Imagen</label><input name="img" required placeholder="https://…"></div>
        <div class="campo ancho"><label>Vídeo (embed)</label><input name="video" placeholder="https://www.youtube.com/embed/…"></div>
        <div class="campo"><label>Destacada</label><input name="destacada" inputmode="numeric" placeholder="orden en portada"></div>
        <div class="campo"><label>Recomendada</label><select name="recomendada"><option value="">—</option><option value="true">Sí</option><option value="false">No</option></select></div>
        <div class="campo"><label>Cover</label><input name="cover" placeholder="opcional"></div>
        <div class="campo"><label>Autor del cover</label><input name="autorCover" placeholder="opcional"></div>
      </div>
    </details>
    <div class="tabs">
      <button data-pane="der">Base</button>
      <button data-pane="cen" class="sel">Editor</button>
      <button data-pane="izq">Original</button>
    </div>
    <div class="cols" id="cols">
      <section class="pane" data-pane="der">
        <div class="cab"><b>Base</b><select id="base-sel" title="Elige la ficha con la que comparar"></select></div>
        <pre id="ref-der"></pre>
      </section>
      <section class="pane activo" data-pane="cen">
        <div class="cab"><b>Editor</b><span id="editor-meta"></span></div>
        <div class="lienzo">
          <pre id="capa"></pre>
          <textarea id="editor" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
          <div id="sug"></div>
        </div>
        <div class="mover">
          <button id="m-izq" title="Mover el acorde una columna a la izquierda">◀</button>
          <button id="m-der" title="Mover el acorde una columna a la derecha">▶</button>
        </div>
      </section>
      <section class="pane" data-pane="izq">
        <div class="cab"><b>Original</b></div>
        <pre id="ref-izq"></pre>
      </section>
    </div>
  </div>
</main>

<footer>
  <span><kbd>Alt</kbd>+<kbd>←</kbd><kbd>→</kbd> mover acorde</span>
  <span><kbd>Ctrl</kbd>+<kbd>S</kbd> guardar</span>
  <span><kbd>Ctrl</kbd>+<kbd>Z</kbd> deshacer</span>
  <span id="pie"></span>
</footer>

<div id="aviso"></div>

<dialog id="dlg-nueva">
  <form id="f-nueva">
    <h2 id="dlg-nueva-titulo">Nueva ficha</h2>
    <p class="nota" id="dlg-nueva-nota">Se crea como borrador con el bloque de la ficha base. Después cambias la letra y mueves los acordes.</p>
    <input type="hidden" name="clon" value="">
    <div class="dos">
      <div class="campo"><label>Pieza</label><input name="pieza" value="Pasodoble" required></div>
      <div class="campo"><label>Agrupación</label><input name="agrupacion" required></div>
      <div class="campo"><label>Año</label><input name="year" inputmode="numeric" required></div>
      <div class="campo"><label>Cejilla</label><input name="cejilla" inputmode="numeric" placeholder="opcional"></div>
      <div class="campo"><label>Música</label><input name="musica"></div>
      <div class="campo"><label>Letra</label><input name="letra"></div>
      <div class="campo"><label>Título de la letra</label><input name="letraTitulo"></div>
      <div class="campo"><label>Vídeo (embed)</label><input name="video"></div>
      <div class="campo"><label>Imagen</label><input name="img"></div>
      <div class="campo"><label>Ficha base (de la que copiar acordes)</label><input name="base" list="slugs" placeholder="slug"></div>
    </div>
    <div class="campo"><label>Frase clave</label><input name="fraseClave"></div>
    <datalist id="slugs"></datalist>
    <div class="acciones">
      <button type="button" id="n-cancelar">Cancelar</button>
      <button type="submit" class="principal">Crear</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-letra">
  <form id="f-letra">
    <h2>Nueva letra pendiente</h2>
    <p class="nota">Se apunta en <code>letras-pendientes.md</code> para buscarla y ponerle los acordes después.</p>
    <div class="dos">
      <div class="campo"><label>Frase que recuerdas</label><input name="frase" required placeholder="primera frase o la que te acuerdes"></div>
      <div class="campo"><label>Agrupación</label><input name="agrupacion" required></div>
      <div class="campo"><label>Fuente</label><input name="fuente" placeholder="opcional (URL)"></div>
      <div class="campo"><label>Notas</label><input name="notas" placeholder="opcional"></div>
    </div>
    <p class="nota" id="letra-base"></p>
    <div class="acciones">
      <button type="button" id="l-cancelar">Cancelar</button>
      <button type="submit" class="principal">Añadir a la cola</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-aviso">
  <div class="cuerpo">
    <h2>Avisos</h2>
