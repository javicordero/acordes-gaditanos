---
// El panel se movió a /admin. Esta página solo existe para que /estudio siga
// funcionando en `astro dev`; en producción lo resuelve el 301 de netlify.toml.
export const prerender = true;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow">
<meta http-equiv="refresh" content="0;url=/admin/">
<title>Admin · Acordes Gaditanos</title>
<script is:inline>location.replace('/admin/' + location.search + location.hash);</script>
</head>
<body>
  <p>El panel está en <a href="/admin/">/admin/</a>.</p>
</body>
</html>
