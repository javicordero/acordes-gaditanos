---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CardsGroup from '../components/page/CardsGroup.astro';
import YearsList from '../components/page/YearsList.astro';
import CanalCallout from '../components/page/CanalCallout.astro';
import AutorCardsGroup from '../components/page/AutorCardsGroup.astro';
import BannerCoac2026 from '../components/page/BannerCoac2026.astro';
import AnunciateAqui from '../components/right-column/AnunciateAqui.astro';
import AnunciateIndex from '../components/page/AnunciateIndex.astro';
import Anuncio from '../components/right-column/anuncios/Anuncio.astro';
import BannerCoplasComunidad from '../components/page/BannerCoplasComunidad.astro';
import FloatingButton from '../components/FloatingButton.astro';
import { parseSpanishDate, sortByYearDesc } from '../lib/index';
import { contarCreditosAutores } from '../lib/autores';

let acordes = await getCollection('acordes');

// Ordenar por fecha de creación descendente
acordes = acordes.sort((a, b) => parseSpanishDate(b.data.date).getTime() - parseSpanishDate(a.data.date).getTime());

// Los 4 más recientes
const ultimos = acordes.slice(0, 8);

// Destacadas: mostrar los acordes cuyo campo destacada sea distinto de null, ordenados por ese número ascendente
const destacadas = acordes
  .filter((acorde) => acorde.data.destacada !== null && acorde.data.destacada !== undefined)
  .sort((a, b) => {
    return Number(a.data.destacada) - Number(b.data.destacada);
  });

let autores = await getCollection('autores');

const creditos = contarCreditosAutores(acordes);
const autoresDestacados = [...autores]
  .sort((a, b) => (a.data.order ?? 9999) - (b.data.order ?? 9999))
  .slice(0, 6);
---

<Layout
  title='Acordes Gaditanos - Acordes del Carnaval de Cádiz'
  description='La mayor colección de acordes de guitarra del Carnaval de Cádiz. Encuentra acordes de chirigotas, comparsas, cuartetos y coros para tocar con tu guitarra.'>
  <!-- <BannerCoac2026 /> -->

  <BannerCoplasComunidad />
  <div class='main-container'>
    <!-- <AnunciateIndex /> -->

    <div class='section section--novedades'>
      <CardsGroup year={'Novedades'} acordes={ultimos} />
      <div class='container-layout ver-mas-wrapper'>
        <a
          href='/novedades'
          class='ver-mas'
          data-ga-event='ver_mas_novedades_click'
          data-ga-params='{"link_type":"novedades","location":"index_novedades"}'>
          Ver más novedades
        </a>
      </div>

      <div class='container-layout canal-wrapper'>
        <CanalCallout titulo='¿Te aviso cuando suba una copla nueva?' ubicacion='home' />
      </div>
    </div>
    <div class='section section--colored section--autores'>
      <AutorCardsGroup autores={autoresDestacados} creditos={creditos} />
      <div class='container-layout ver-mas-wrapper'>
        <a
          href='/autores'
          class='ver-mas ver-mas--autores'
          data-ga-event='ver_mas_autores_click'
          data-ga-params='{"link_type":"autores","location":"index_autores"}'>
          Ver más autores destacados
        </a>
      </div>
    </div>
    <div class='container-layout anuncio-autores'>
      <Anuncio adSlot='9620700067' />
    </div>
    <!-- <div class='section'><CardsGroup year={'Destacando'} acordes={destacadas} /></div> -->
    <div class='section'>
      <YearsList
        years={Array.from(new Set(acordes.map((acorde) => acorde.data.year))).sort(sortByYearDesc)}
      />
    </div>
  </div>
  <div class='container-layout'>
    <FloatingButton />
  </div>
</Layout>

<script>
  declare const gtag: (...args: unknown[]) => void;

  function setupVerMasTracking() {
    const links = document.querySelectorAll('[data-ga-event^="ver_mas_"]');
    links.forEach((link) => {
      if (link.getAttribute('data-tracking-init')) return;
      link.setAttribute('data-tracking-init', 'true');

      link.addEventListener('click', () => {
        if (typeof gtag === 'function') {
          const eventName = link.getAttribute('data-ga-event');
          const eventParams = JSON.parse(link.getAttribute('data-ga-params') || '{}');
          gtag('event', eventName, {
            ...eventParams,
            page_location: window.location.href,
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupVerMasTracking);
  } else {
    setupVerMasTracking();
  }
</script>

<style>
  .main-container {
    display: flex;
    flex-direction: column;
    margin-top: 0;
    padding-top: 0;
    padding-bottom: 0;
  }

  .section {
    padding-top: var(--main-container-gap);
    padding-bottom: calc(var(--main-container-gap) + 29px);
  }

  .section--novedades {
    padding-bottom: calc(var(--main-container-gap) + 8px);
  }

  .section--autores {
    --autores-heading-color: var(--on-surface-color);
    padding-bottom: calc(var(--main-container-gap) + 8px);
  }

  .section--colored {
    background-color: var(--brand-navy);
    border-top: 4px solid var(--primary-contrast-color);
    border-bottom: 4px solid var(--primary-contrast-color);
  }

  .anuncio-autores ins[data-ad-status='filled'] {
    margin-top: var(--main-container-gap);
    margin-bottom: var(--main-container-gap);
  }

  .ver-mas-wrapper {
    display: flex;
    justify-content: center;
    margin-top: var(--card-padding);
  }

  .canal-wrapper {
    margin-top: var(--main-container-gap-sm);
  }

  .ver-mas {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--surface-color);
    color: var(--primary-contrast-color);
    font-family: 'Roboto Mono', monospace;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 12px 24px;
    border: 2px solid var(--primary-color);
    border-radius: 0;
    text-decoration: none;
    box-shadow: 4px 4px 0 0 var(--primary-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .ver-mas:hover {
    background-color: var(--primary-contrast-color);
    color: var(--on-bright-color);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--primary-color);
  }

  .ver-mas:active {
    transform: translate(0, 0);
    box-shadow: 2px 2px 0 0 var(--primary-color);
  }

  .ver-mas:focus-visible {
    outline: 3px solid var(--primary-contrast-color);
    outline-offset: 3px;
  }

  :global(html[data-theme='dark']) .ver-mas {
    background-color: var(--surface-color);
    color: var(--primary-contrast-color);
  }

  :global(html[data-theme='dark']) .ver-mas:hover {
    background-color: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  /* El botón de autores arranca con los colores que antes eran el hover */
  .ver-mas--autores {
    background-color: var(--primary-contrast-color);
    color: var(--on-bright-color);
    border-color: var(--on-bright-color);
    box-shadow: 4px 4px 0 0 var(--on-bright-color);
  }

  .ver-mas--autores:hover {
    background-color: var(--primary-contrast-color);
    color: var(--on-bright-color);
    box-shadow: 6px 6px 0 0 var(--on-bright-color);
  }

  .ver-mas--autores:active {
    box-shadow: 2px 2px 0 0 var(--on-bright-color);
  }

  :global(html[data-theme='dark']) .ver-mas--autores {
    background-color: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  :global(html[data-theme='dark']) .ver-mas--autores:hover {
    background-color: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  @media (max-width: 1024px) {
    :global(.section--novedades .acordes-grid > *:nth-child(n + 7)) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .section {
      padding-top: var(--main-container-gap-sm);
      padding-bottom: calc(var(--main-container-gap-sm) + 29px);
    }

    .section--novedades {
      padding-bottom: calc(var(--main-container-gap-sm) + 8px);
    }

    .section--autores {
      padding-bottom: calc(var(--main-container-gap-sm) + 8px);
    }

    :global(.section--autores .acordes-grid > *:nth-child(n + 6)) {
      display: none;
    }

    .anuncio-autores ins[data-ad-status='filled'] {
      margin-top: var(--main-container-gap-sm);
      margin-bottom: var(--main-container-gap-sm);
    }
  }
</style>
