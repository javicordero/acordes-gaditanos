---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CardsGroup from '../../components/page/CardsGroup.astro';

import Breadcrumb from '../../components/page/Breadcrumb.astro';
import Banner320X50 from '../../components/ads/Banner320x50.astro';
import Banner468X60 from '../../components/ads/Banner468x60.astro';
import AnuncioSobrePagina from '../../components/ads/AnuncioSobrePagina.astro';
import { parseSpanishDate, sortByYearDesc } from '../../lib/index';

export async function getStaticPaths() {
  const acordes = await getCollection('acordes');
  // Recopilar todas las agrupaciones únicas
  const agrupacionesMap = new Map();
  acordes.forEach((acorde) => {
    if (acorde.data.agrupacion && acorde.data.agrupacionSlug) {
      if (!agrupacionesMap.has(acorde.data.agrupacionSlug)) {
        agrupacionesMap.set(acorde.data.agrupacionSlug, {
          nombre: acorde.data.agrupacion,
          acordes: [],
        });
      }
      agrupacionesMap.get(acorde.data.agrupacionSlug).acordes.push(acorde);
    }
  });
  return Array.from(agrupacionesMap.entries()).map(([slug, data]) => ({
    params: { agrupacionSlug: slug },
    props: {
      agrupacionName: data.nombre,
      acordes: data.acordes,
    },
  }));
}

const { agrupacionName, acordes } = Astro.props;

const acordesOrdenados = acordes.sort((a, b) => {
  const yearA = a.data.year;
  const yearB = b.data.year;
  if (yearA !== yearB) {
    return sortByYearDesc(yearA, yearB);
  }
  return parseSpanishDate(b.data.date).getTime() - parseSpanishDate(a.data.date).getTime();
});

const title = `${agrupacionName} - Acordes del Carnaval de Cádiz`;
const description = `Todos los acordes de guitarra de la agrupación ${agrupacionName} del Carnaval de Cádiz.`;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: acordesOrdenados.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${a.data.pieza} - ${a.data.agrupacion}`,
    item: `${Astro.site}acordes/${a.slug}`,
  })),
};
---

<Layout title={title} description={description}>
  <script type='application/ld+json' set:html={JSON.stringify(itemListSchema)} />
  <Breadcrumb
    year={acordesOrdenados[0]?.data.year}
    agrupacion={agrupacionName}
    agrupacionSlug={acordes[0]?.data.agrupacionSlug}
  />
  <div class='main-container'>
    <section>
      <Banner468X60 adKey='0a8164971e8c287ce3c84cea534f2266' />
      <Banner320X50 adKey='00168e813d28ccdbf699a41e61d3b2ab' />

      <CardsGroup year={agrupacionName} acordes={acordesOrdenados}>
        <AnuncioSobrePagina />
      </CardsGroup>
    </section>
  </div>
</Layout>

<style>
  .main-container {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap);
  }
  @media (max-width: 640px) {
    .main-container {
      gap: var(--main-container-gap-sm);
    }
  }
</style>
