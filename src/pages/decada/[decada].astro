---
import HubLista from '../../components/page/HubLista.astro';
import { cargarHubs } from '../../lib/hubs-contenido';
import { resumirHub } from '../../lib/hubs';

export async function getStaticPaths() {
  const { decada } = await cargarHubs();
  return decada.map((hub) => ({
    params: { decada: hub.slug },
    props: {
      hub,
      hermanos: decada.filter((otro) => otro.slug !== hub.slug).map(resumirHub),
    },
  }));
}

const { hub, hermanos } = Astro.props;
---

<HubLista hub={hub} hermanos={hermanos} eje='decada' />
