---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Banner320X50 from '../components/ads/Banner320x50.astro';
import Banner468X60 from '../components/ads/Banner468x60.astro';
import FiltrosLista from '../components/page/FiltrosLista.astro';
import { sortByYearDesc } from '../lib/index';
import { contarCoplas, textoRecuento } from '../lib/letras';
import { contarCoplasAutores } from '../lib/autores';
import { ordenarAcordesYear, prioridadDeAgrupaciones, prioridadDeAutores, prioridadPorCoplas } from '../lib/orden';
import {
  aFichaFiltrable,
  opcionesAnio,
  opcionesAutores,
  opcionesDecada,
  opcionesPieza,
} from '../lib/filtros-lista';

const acordes = await getCollection('acordes');

const capitalize = (text: string) => (text ? text.charAt(0).toUpperCase() + text.slice(1) : text);

const recuento = contarCoplas(acordes);

// Mismo orden que /carnaval/[year]: autores destacados → agrupaciones de los
// autores con más coplas → agrupación → tipo de pieza → fecha ↓.
const autores = await getCollection('autores');
const prioridad = prioridadDeAgrupaciones(acordes, prioridadDeAutores(autores));
const coplas = prioridadPorCoplas(acordes, contarCoplasAutores(acordes));

const years = [...new Set(acordes.map((acorde) => acorde.data.year))].sort((a, b) =>
  sortByYearDesc(a, b),
);
const acordesPorYear = years.map((year) => {
  const delYear = ordenarAcordesYear(
    acordes.filter((acorde) => acorde.data.year === year),
    prioridad,
    coplas,
  );
  return { year, acordes: delYear, recuento: contarCoplas(delYear) };
});
const acordesOrdenados = acordesPorYear.flatMap((grupo) => grupo.acordes);

// Datos de cada ficha y opciones de los filtros, calculados una sola vez.
const filtrables = new Map(acordes.map((acorde) => [acorde.slug, aFichaFiltrable(acorde)]));
const fichas = [...filtrables.values()];
const opciones = {
  pieza: opcionesPieza(fichas),
  decada: opcionesDecada(fichas),
  anio: opcionesAnio(fichas),
  musica: opcionesAutores(acordes, 'musica'),
  letra: opcionesAutores(acordes, 'letra'),
};

const title = 'Todas las coplas - Acordes del Carnaval de Cádiz';
const description =
  'Listado completo de todas las coplas con acordes de guitarra del Carnaval de Cádiz, agrupadas por año y ordenadas por autores destacados y tipo de pieza.';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: acordesOrdenados.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${capitalize(a.data.pieza)}${a.data.letraTitulo ? ` "${a.data.letraTitulo}"` : ''} - ${a.data.agrupacion}`,
    item: `${Astro.site}acordes/${a.slug}`,
  })),
};
---

<Layout title={title} description={description}>
  <script type='application/ld+json' set:html={JSON.stringify(itemListSchema)} />
  <div class='main-container'>
    <section>
      <Banner468X60 adKey='0a8164971e8c287ce3c84cea534f2266' />
      <Banner320X50 adKey='00168e813d28ccdbf699a41e61d3b2ab' />

      <article class='container-layout inner-content'>
        <header>
          <h1>Todas las coplas</h1>
          <p class='subtitle'>
            Aquí encontrarás, agrupadas por año, todas las coplas que hemos transcrito para tocarlas
            con la guitarra. Ahora mismo hay{' '}
            <strong class='subtitle-count'>{recuento.coplas}</strong> {recuento.coplas === 1 ? 'copla' : 'coplas'}{recuento.letras > 0 && <> y <strong class='subtitle-count'>{recuento.letras}</strong> {recuento.letras === 1 ? 'letra extra' : 'letras extras'}</>}, y seguimos sumando.
          </p>
        </header>

        <FiltrosLista opciones={opciones} recuento={recuento} />

        {
          acordesPorYear.map(({ year, acordes, recuento }) => (
            <section class='year-group' aria-labelledby={`year-${year}`} data-year-group>
              <h2 id={`year-${year}`}>
                <span class='year-label'>{year}</span>{' '}
                <span class='year-count' data-count>({textoRecuento(recuento)})</span>
              </h2>
              <ul class='copla-list'>
                {acordes.map((acorde) => {
                  const ficha = filtrables.get(acorde.slug);
                  return (
                    <li
                      data-copla
                      data-slug={acorde.slug}
                      data-p={acorde.data.pieza}
                      data-t={ficha?.tipo}
                      data-d={ficha?.decada}
                      data-y={acorde.data.year}
                      data-a={ficha?.agrupacion}
                      data-m={ficha?.musica.join(' ')}
                      data-l={ficha?.letra.join(' ')}
                      data-lt={acorde.data.letraTitulo ? '1' : undefined}
                    >
                      <a href={`/acordes/${acorde.slug}`}>
                        <span class='pieza'>{capitalize(acorde.data.pieza)}</span>{' '}
                        <span class='agrupacion'>{acorde.data.agrupacion}</span>
                        {acorde.data.letraTitulo ? ` "${acorde.data.letraTitulo}"` : ''}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </article>
    </section>
  </div>
</Layout>

<style>
  .main-container {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap);
  }

  section {
    display: flex;
    flex-direction: column;
  }

  .inner-content {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: var(--card-padding);

    & h1 {
      position: relative;
      color: var(--primary-color);
      font-size: 2rem;
      font-family: 'Roboto Mono', monospace;
      letter-spacing: 1px;
      font-weight: 800;
      text-transform: uppercase;
      max-width: fit-content;
      margin: 0;

      &::after {
        content: '';
        display: block;
        position: absolute;
        left: 0;
        bottom: -6px;
        width: 95%;
        height: 6px;
        background: var(--primary-contrast-color);
      }
    }

    & .subtitle {
      color: var(--text-secondary-color, var(--text-color));
      font-size: 1.05rem;
      line-height: 1.6;
      margin: 0;
      max-width: 780px;
      text-wrap: balance;
    }

    & .subtitle-count {
      color: var(--on-bright-color);
      background: var(--primary-contrast-color);
      border: 2px solid var(--on-bright-color);
      font-family: 'Roboto Mono', monospace;
      font-weight: 700;
      padding: 1px 8px;
      border-radius: 0;
    }
  }

  .year-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 20px;
    border-top: 2px solid var(--primary-color);

    /* El filtro esconde años enteros y coplas sueltas desde el navegador. */
    &[hidden] {
      display: none;
    }

    & h2 {
      color: var(--primary-color);
      font-size: 1.5rem;
      font-family: 'Roboto Mono', monospace;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      max-width: fit-content;
      margin: 0;

      & .year-label {
        position: relative;

        &::after {
          content: '';
          display: block;
          position: absolute;
          left: 0;
          bottom: -6px;
          width: 95%;
          height: 6px;
          background: var(--primary-contrast-color);
        }
      }

      & .year-count {
        color: var(--text-secondary-color, var(--text-color));
        font-size: 0.65em;
        font-weight: 400;
        text-transform: none;
      }
    }
  }

  .copla-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;

    & li {
      position: relative;
      padding-left: 18px;
      line-height: 1.5;

      &[hidden] {
        display: none;
      }

      &::before {
        content: '';
        position: absolute;
        left: 2px;
        top: 0.55em;
        width: 6px;
        height: 6px;
        border-radius: 0;
        background: var(--primary-contrast-color);
        border: 1px solid var(--primary-color);
      }
    }

    & a {
      color: var(--link-color);
      text-decoration: none;
    }
  }

  @media (max-width: 640px) {
    .main-container {
      gap: var(--main-container-gap-sm);
    }

    .inner-content {
      gap: var(--main-container-gap-sm);
    }

    header {
      gap: var(--card-padding-sm);
    }

    header h1 {
      font-size: 1.6rem;
    }

    header .subtitle {
      font-size: 1rem;
    }

    .year-group h2 {
      font-size: 1.4rem;

      & .year-label::after {
        height: 4px;
        bottom: -2px;
      }
    }
  }
</style>
