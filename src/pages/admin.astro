---
// Panel privado de edición (solo el propietario, con login de GitHub).
//
// Vive en /admin, no está enlazado desde la web, va con noindex y fuera del
// sitemap. Las funciones de /admin/api/* son las que hablan con GitHub: la
// página solo manda el `.md` ya montado.

export const prerender = true;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Admin · Acordes Gaditanos</title>
<link rel="preload" href="/fonts/bodoni-72-oldstyle-book.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/roboto-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
<style is:global>
  /* Tipografías de la web (el panel es una página suelta: las carga aquí). */
  @font-face { font-family:'Bodoni'; src:url('/fonts/bodoni-72-oldstyle-book.woff2') format('woff2'); font-weight:normal; font-style:normal; font-display:swap; }
  @font-face { font-family:'Roboto Mono'; src:url('/fonts/roboto-mono-latin.woff2') format('woff2'); font-weight:400; font-style:normal; font-display:swap; }
  @font-face { font-family:'Roboto Mono'; src:url('/fonts/roboto-mono-latin.woff2') format('woff2'); font-weight:700; font-style:normal; font-display:swap; }

  :root {
    --fondo:#e5e5e5;
    --papel:#ffffff;
    --tinta:#222222;
    --suave:#555555;
    --linea:#000000;
    --acento:#fca311;
    --navy:#14213d;
    --azul:#0044cc;
    --ok:#1a7f37;
    --nuevo:#b45309;
    --mal:#d32f2f;
    --sombra:4px 4px 0 0 #000;
    --sombra-sm:3px 3px 0 0 #000;
    --mono:'Roboto Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
    --serif:'Bodoni', Georgia, 'Times New Roman', serif;
  }
  * { box-sizing:border-box; }
  [hidden] { display:none !important; }
  html { height:100%; }
  /* `--alto-vv` lo pone el JS con visualViewport: en iOS el teclado no encoge
     el layout y, sin esto, la barra de flechas y el pie quedan debajo. */
  body { margin:0; height:100vh; height:var(--alto-vv, 100dvh); background:var(--fondo); color:var(--tinta); font:400 14px/1.5 var(--mono); display:flex; flex-direction:column; }
  a { color:var(--azul); }
  :focus-visible { outline:3px solid var(--acento); outline-offset:2px; }

  /* Cabecera: como la de la web (negra con filo ámbar y logo Bodoni). */
  body > header { flex:0 0 auto; position:relative; z-index:5; background:#000; color:#fff; border-bottom:4px solid var(--acento); padding:0 14px; min-height:56px; display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  h1 { margin:0; font:normal 1.45rem/1 var(--serif); letter-spacing:.4px; }
  h1 a { color:var(--acento); text-decoration:none; }
  h1 a:hover, h1 a:focus-visible { text-decoration:underline; }
  .meta { color:#d0d0d0; font-size:11.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:34vw; }
  .estado { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:#d0d0d0; }
  .estado.ok { color:var(--acento); }
  .estado.mal { color:#ff8a8a; }
  .barra { display:flex; align-items:center; gap:6px; margin-left:auto; flex-wrap:wrap; }
  body > header button { border-color:var(--acento); background:transparent; color:var(--acento); box-shadow:none; }
  body > header button:hover { background:var(--acento); color:#000; border-color:var(--acento); }
  body > header button.principal { background:var(--acento); color:#000; border-color:var(--acento); }
  body > header button.principal:hover { filter:brightness(1.06); }
  body > header button.revisado { background:var(--ok); border-color:var(--ok); color:#fff; }
  body > header button.revisado:hover { filter:brightness(1.08); }

  /* Botones: rectos, con borde negro y sombra dura. */
  button, .boton { font:700 11px/1 var(--mono); letter-spacing:.06em; text-transform:uppercase; padding:8px 11px; border:2px solid var(--linea); border-radius:0; background:var(--papel); color:var(--tinta); cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:6px; box-shadow:var(--sombra-sm); transition:transform .12s ease, box-shadow .12s ease, background .12s ease, color .12s ease; }
  button:hover, .boton:hover { background:var(--acento); color:#000; transform:translate(-1px,-1px); box-shadow:4px 4px 0 0 #000; }
  button:active, .boton:active { transform:translate(1px,1px); box-shadow:1px 1px 0 0 #000; }
  button.principal, .boton.principal { background:var(--acento); color:#000; }
  button.principal:hover, .boton.principal:hover { background:#ffb733; }
  button.revisado { background:var(--ok); border-color:var(--ok); color:#fff; }
  button:disabled { opacity:.45; cursor:default; transform:none; box-shadow:none; }

  main { flex:1 1 0; min-height:0; overflow:hidden; display:flex; }

  /* Login */
  #login { flex:1; display:flex; align-items:center; justify-content:center; padding:24px; background:var(--fondo); }
  #login .caja { width:100%; max-width:420px; text-align:center; background:var(--papel); border:2px solid #000; box-shadow:6px 6px 0 #000; padding:28px 24px; }
  #login h2 { font:normal 1.7rem/1.1 var(--serif); margin:0 0 8px; }
  #login p { color:var(--suave); font-size:12px; margin:0 0 18px; }

  /* Lista */
  #vista-lista { flex:1; overflow:auto; background:var(--fondo); }
  .lista-cab { position:sticky; top:0; z-index:4; display:grid; gap:10px; padding:14px; background:var(--papel); border-bottom:2px solid #000; }
  .lista-cab > * { width:100%; max-width:1000px; margin:0 auto; }
  .buscador { position:relative; display:flex; align-items:center; }
  .buscador .lupa { position:absolute; left:12px; width:16px; height:16px; fill:none; stroke:#000; stroke-width:2; stroke-linecap:round; pointer-events:none; }
  .buscador input { flex:1; width:100%; font:400 16px/1.2 var(--mono); color:var(--tinta); background:var(--papel); border:2px solid #000; border-radius:0; padding:11px 40px 11px 36px; }
  .buscador input::placeholder { color:var(--suave); }
  .buscador input:focus { outline:3px solid var(--acento); outline-offset:1px; }
  .buscador input::-webkit-search-cancel-button { display:none; }
  .limpiar { position:absolute; right:6px; width:30px; height:30px; padding:0; border:0; box-shadow:none; background:transparent; color:var(--suave); font-size:13px; }
  .limpiar:hover { color:#000; background:var(--acento); transform:none; box-shadow:none; }
  .filtros { display:flex; gap:6px; overflow-x:auto; scrollbar-width:none; }
  .filtros::-webkit-scrollbar { display:none; }
  .filtros button { flex:0 0 auto; padding:7px 10px; font-size:10px; background:var(--papel); color:var(--tinta); box-shadow:none; }
  .filtros button.sel { background:#000; border-color:#000; color:var(--acento); }
  .filtros button.sel .cuenta { color:var(--acento); opacity:.85; }
  .filtros .cuenta { font-size:10px; opacity:.7; }
  .lista-cuerpo { max-width:1000px; margin:0 auto; padding:8px 14px 40px; }
  .grupo { display:flex; align-items:center; gap:10px; padding:20px 2px 8px; }
  .grupo-tit { font-size:10px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:#000; }
  .grupo i { flex:1; height:2px; background:#000; }
  .grupo-n { font-size:10px; color:var(--suave); }
  .grupo.pend .grupo-tit { color:var(--nuevo); }
  .filas { display:grid; gap:9px; }
  .fila { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:10px; padding:10px 12px; background:var(--papel); border:2px solid #000; border-radius:0; box-shadow:2px 2px 0 rgba(0,0,0,.18); }
  .fila:hover { box-shadow:4px 4px 0 #000; }
  .fila.pendiente { border-left:6px solid var(--acento); }
  .fila-info { display:grid; gap:4px; width:100%; min-width:0; padding:0; border:0; background:transparent; font:inherit; color:inherit; text-align:left; cursor:pointer; box-shadow:none; text-transform:none; letter-spacing:0; justify-content:stretch; justify-items:stretch; align-items:stretch; }
  .fila-info:hover { background:transparent; color:inherit; transform:none; box-shadow:none; }
  .fila-info:hover .f-agr { color:var(--azul); }
  .f-agr { font-size:13.5px; font-weight:700; line-height:1.3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .f-meta { display:flex; flex-wrap:wrap; align-items:center; gap:6px; font-size:10.5px; line-height:1.3; color:var(--suave); }
  .f-year { background:var(--papel); border:1.5px solid #000; padding:0 5px; font-weight:700; color:#000; }
  .f-letra { font-style:italic; }
  .fila-acciones { display:flex; align-items:center; gap:6px; }
  .fila-acciones .acc { padding:7px 9px; font-size:9.5px; box-shadow:none; }
  .fila-acciones .acc.icono { padding:7px 9px; font-size:12px; }
  .fila-acciones .acc.principal { background:var(--acento); border-color:#000; color:#000; }
  .fila-acciones .acc.principal:hover { background:#ffb733; color:#000; }
  .lista-vacio { padding:48px 12px; text-align:center; color:var(--suave); font-size:12px; }
  .lista-vacio b { display:block; margin-bottom:4px; color:#000; font-size:14px; }
  .lista-tope { padding-top:16px; text-align:center; color:var(--suave); font-size:10px; }
  .marca { display:inline-block; font-size:9px; font-weight:700; letter-spacing:.08em; color:#000; background:var(--acento); padding:1px 4px; vertical-align:1px; }
  .marca.pr { background:#9cc4ff; }
  .marca.local { background:#d4d4d4; }
  .marca.remoto { background:#c9b8ff; }
  .marca.revisar { background:#a8d5ff; }
  .nota { margin:0 0 12px; font-size:11.5px; color:var(--suave); line-height:1.5; }

  /* Datos de la ficha */
  .datos { flex:0 0 auto; background:var(--papel); border-bottom:2px solid #000; }
  .datos > summary { display:flex; align-items:center; gap:10px; padding:8px 14px; cursor:pointer; list-style:none; overflow:hidden; }
  .datos > summary::-webkit-details-marker { display:none; }
  .datos > summary::before { content:'▸'; color:#000; font-size:11px; flex:0 0 auto; }
  .datos[open] > summary::before { content:'▾'; }
  .datos-tit { font-size:10px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#000; flex:0 0 auto; }
  .datos-resumen { font-size:11.5px; color:var(--suave); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0; }
  .datos-slug { margin-left:auto; min-width:0; font:10px var(--mono); color:var(--suave); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .datos-slug.mal { color:var(--mal); }
  .datos-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(170px,1fr)); gap:10px 12px; padding:2px 14px 14px; max-height:42vh; overflow:auto; }
  .datos-grid .campo { margin:0; }
  .datos-grid .ancho { grid-column:1/-1; }

  /* Editor */
  #vista-editor { flex:1; display:flex; flex-direction:column; min-height:0; background:var(--fondo); }
  .cols { flex:1; display:grid; grid-template-columns:1fr 1.35fr 1fr; min-height:0; background:var(--fondo); }
  .cols.una { grid-template-columns:1fr; }
  .cols.sin-base { grid-template-columns:1.35fr 1fr; }
  .pane { min-width:0; min-height:0; display:flex; flex-direction:column; background:var(--papel); border-right:2px solid #000; }
  .pane:last-child { border-right:0; }
  .cab { padding:7px 10px; min-height:38px; font-size:10px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#000; background:var(--papel); border-bottom:2px solid #000; display:flex; gap:8px; align-items:center; }
  .cab b { color:#000; font-weight:700; letter-spacing:0; text-transform:none; font-size:12px; }
  .cab .mal { color:var(--mal); }
  #editor-meta { color:var(--suave); font-size:10px; }
  #base-sel { flex:1; min-width:0; max-width:100%; font:400 11px var(--mono); padding:3px 4px; border:1.5px solid #000; background:var(--papel); color:var(--tinta); }
  #b-zoom { margin-left:auto; flex:0 0 auto; padding:5px 8px; font-size:9.5px; letter-spacing:.04em; text-transform:uppercase; box-shadow:none; }
  /* Un solo scroller: la hoja mide lo que el texto y el textarea la cubre entera. */
  .lienzo { position:relative; flex:1; min-height:0; overflow:auto; overscroll-behavior:contain; scrollbar-width:thin; background:var(--papel); }
  .hoja { position:relative; width:max-content; min-width:100%; min-height:100%; --pre-size:13px; font:var(--pre-size)/1.55 var(--mono); }
  .pane pre { margin:0; padding:12px 14px; border:0; width:100%; height:100%; font:13px/1.55 var(--mono); white-space:pre; overflow:auto; tab-size:4; color:var(--tinta); }
  #capa { width:max-content; height:auto; overflow:visible; font:inherit; pointer-events:none; }
  .lienzo textarea { position:absolute; inset:0; margin:0; padding:12px 14px; border:0; width:100%; height:100%; resize:none; background:transparent; color:transparent; caret-color:var(--azul); outline:none; font:inherit; white-space:pre; overflow:hidden; tab-size:4; }
  .lienzo textarea::selection { background:rgba(252,163,17,.35); }
  /* Guía del ancho previsto: la columna 56 empieza justo aquí. */
  .regla { position:absolute; top:0; bottom:0; left:calc(14px + 55ch); width:0; border-left:1px dashed rgba(0,0,0,.3); pointer-events:none; }
  .ac { color:var(--azul); }
  .nuevo { color:var(--nuevo); text-decoration:underline dotted; }
  .anot { color:var(--suave); }
  .pasado { color:var(--mal); text-decoration:underline; text-underline-offset:2px; }

  /* Estado de ficha local: banda en el flujo, no un aviso flotante. */
  #nota-local { flex:0 0 auto; display:flex; align-items:flex-start; gap:8px; padding:7px 12px; font-size:11px; line-height:1.4; color:var(--tinta); background:#fff8ec; border-bottom:2px solid #000; border-left:6px solid var(--acento); }
  #nota-local .cerrar { margin-left:auto; flex:0 0 auto; padding:0 5px; border:0; background:transparent; color:#000; font-size:12px; box-shadow:none; }
  #nota-local .cerrar:hover { background:var(--acento); color:#000; transform:none; box-shadow:none; }

  /* Pie */
  footer { flex:0 0 auto; background:#000; color:#d0d0d0; border-top:4px solid var(--acento); padding:6px 12px; font-size:10.5px; display:flex; gap:14px; flex-wrap:wrap; align-items:center; }
  footer a { color:var(--acento); }
  kbd { font:10px var(--mono); border:1.5px solid #777; border-bottom-width:2px; padding:0 4px; background:#222; color:#fff; }

  /* Sugerencias */
  #sug { position:fixed; z-index:30; background:var(--papel); border:2px solid #000; box-shadow:6px 6px 0 #000; padding:4px; display:none; max-height:220px; overflow:auto; }
  #sug button { display:block; width:100%; text-align:left; border:0; box-shadow:none; padding:6px 8px; font:400 12.5px var(--mono); background:transparent; text-transform:none; letter-spacing:0; }
  #sug button.sel, #sug button:hover { background:var(--acento); color:#000; transform:none; box-shadow:none; }

  /* Aviso flotante (solo mensajes pasajeros) */
  #aviso { position:fixed; left:14px; right:14px; bottom:14px; z-index:25; background:var(--papel); border:2px solid #000; border-left:8px solid var(--acento); padding:12px 14px; font-size:12px; display:none; white-space:pre-wrap; box-shadow:6px 6px 0 #000; max-height:50vh; overflow:auto; }
  #aviso .cerrar { float:right; margin-left:10px; box-shadow:none; padding:2px 6px; }

  /* Diálogos */
  dialog { border:2px solid #000; padding:0; width:min(620px, 94vw); max-height:92dvh; background:var(--papel); color:var(--tinta); box-shadow:8px 8px 0 #000; }
  dialog::backdrop { background:rgba(0,0,0,.55); }
  dialog form, dialog .cuerpo { padding:20px; overflow:auto; max-height:92dvh; }
  dialog h2 { margin:0 0 10px; font:normal 1.5rem/1.1 var(--serif); }
  .campo { display:grid; gap:4px; margin-bottom:10px; }
  .campo label { font-size:9.5px; font-weight:700; color:#000; text-transform:uppercase; letter-spacing:.08em; }
  .campo input, .campo select, .campo textarea { font:400 14px var(--mono); padding:9px 10px; border:2px solid #000; border-radius:0; background:var(--papel); color:var(--tinta); width:100%; min-width:0; }
  .campo textarea { width:100%; height:auto; min-height:100px; font-size:12.5px; white-space:pre-wrap; resize:vertical; }
  .campo input:focus, .campo select:focus, .campo textarea:focus { outline:3px solid var(--acento); outline-offset:1px; }
  .dos { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .acciones { display:flex; gap:8px; justify-content:flex-end; margin-top:14px; flex-wrap:wrap; }
  .log { max-height:44vh; overflow:auto; margin:0; padding:10px 12px; background:#fff; border:2px solid #000; font:11px/1.5 var(--mono); white-space:pre-wrap; word-break:break-word; }

  /* Navegación superior: Editor / Estadísticas / Comentarios */
  .vistas { flex:0 0 auto; display:flex; gap:0; background:var(--papel); border-bottom:2px solid #000; padding:0 10px; overflow-x:auto; scrollbar-width:none; }
  .vistas::-webkit-scrollbar { display:none; }
  .vistas button { flex:0 0 auto; border:0; border-bottom:3px solid transparent; background:transparent; box-shadow:none; padding:11px 14px; font-size:10px; letter-spacing:.08em; color:#000; }
  .vistas button.sel { border-bottom-color:var(--acento); background:#000; color:var(--acento); }
  .vistas button:hover { background:var(--acento); color:#000; transform:none; box-shadow:none; }

  /* Estadísticas y comentarios */
  #vista-stats, #vista-comentarios { flex:1; overflow:auto; background:var(--fondo); }
  .stats-panel, .comentarios-panel { width:100%; max-width:1000px; margin:0 auto; padding:18px 14px 40px; }
  .stats-cab, .comentarios-cab { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:18px; }
  .stats-cab h2, .comentarios-cab h2 { margin:0 0 4px; font:normal 1.7rem/1.1 var(--serif); }
  .stats-cab .meta, .comentarios-cab .meta { margin:0; color:var(--suave); font-size:10.5px; }
  .stats-cab .meta code, .comentarios-cab .meta code { background:#fff; border:1px solid #000; padding:0 3px; font-size:10px; }
  .comentarios-acciones { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
  #orden-peticiones { font:400 12px var(--mono); padding:8px 10px; border:2px solid #000; background:var(--papel); color:var(--tinta); }
  .stats-contenido { display:grid; gap:16px; }
  .stats-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(150px,1fr)); gap:10px; }
  .stat-card { background:var(--papel); border:2px solid #000; box-shadow:var(--sombra-sm); padding:14px; }
  .stat-card--total { background:var(--navy); color:#fff; }
  .stat-label { display:block; font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--suave); }
  .stat-card--total .stat-label { color:#c9d4e8; }
  .stat-valor { margin-top:8px; font:700 1.8rem/1 var(--mono); }
  .stats-bloque { background:var(--papel); border:2px solid #000; box-shadow:var(--sombra-sm); }
  .stats-bloque h3 { margin:0; padding:10px 12px; font-size:9.5px; text-transform:uppercase; letter-spacing:.1em; border-bottom:2px solid #000; background:var(--papel); }
  .stats-bloque h3 .tabla-nota { float:right; font-size:9px; font-weight:400; letter-spacing:0; text-transform:none; color:var(--suave); }
  .tabla-scroll { overflow-x:auto; }
  .stats-tabla { width:100%; border-collapse:collapse; font-size:11.5px; }
  .stats-tabla th { background:#000; color:var(--acento); padding:7px 10px; text-align:left; font-size:9px; text-transform:uppercase; letter-spacing:.08em; }
  .stats-tabla td { padding:7px 10px; border-bottom:1px solid #ddd; }
  .stats-tabla tr:last-child td { border-bottom:0; }
  .stats-tabla .num { text-align:right; font-variant-numeric:tabular-nums; font-weight:700; }
  .stats-tabla .ruta { word-break:break-word; }
  .stats-tabla .progress { height:8px; min-width:70px; background:#ddd; border:1px solid #000; }
  .stats-tabla .progress span { display:block; height:100%; background:var(--acento); }
  .cargando, .error { margin:0; padding:24px 12px; text-align:center; font-size:12px; color:var(--suave); }
  .error { color:var(--mal); }
  .peticiones { display:grid; gap:10px; }
  .peticion { background:var(--papel); border:2px solid #000; box-shadow:var(--sombra-sm); padding:12px 14px; }
  .peticion.completada { opacity:.62; }
  .peticion-cab { display:flex; flex-wrap:wrap; align-items:center; gap:8px; font-size:10px; color:var(--suave); }
  .peticion-rank { font-weight:700; color:#000; }
  .peticion-autor { font-weight:700; color:#000; }
  .peticion-votos { color:var(--mal); font-weight:700; }
  .peticion-texto { margin:8px 0 10px; font-size:12.5px; line-height:1.55; white-space:pre-wrap; word-break:break-word; }
  .peticion-pie { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
  .peticion-respuestas { font-size:9.5px; color:var(--suave); }
  .peticion-acciones { display:flex; gap:6px; flex-wrap:wrap; }
  .peticion-acciones button { padding:7px 9px; font-size:9px; box-shadow:none; }
  .peticion-acciones .completar { background:var(--ok); border-color:#000; color:#fff; }
  .peticion-acciones .peligro { background:var(--mal); border-color:#000; color:#fff; }
  .peticion-respuesta .respuesta-form { display:grid; gap:8px; margin-top:10px; }
  .respuesta-form textarea { width:100%; min-height:70px; padding:9px 10px; border:2px solid #000; font:400 12px var(--mono); resize:vertical; }
  .respuesta-form .acciones { margin-top:0; }

  /* Pestañas (solo pantallas estrechas) */
  .tabs { display:none; }

  @media (max-width:1000px) {
    .cols, .cols.sin-base { grid-template-columns:1fr; }
    .pane { display:none; border-right:0; }
    .pane.activo { display:flex; }
    .tabs { display:flex; gap:6px; padding:8px 10px; background:var(--papel); border-bottom:2px solid #000; }
    .tabs button { flex:1; padding:10px 6px; font-size:10px; box-shadow:none; }
    .tabs button.sel { background:#000; border-color:#000; color:var(--acento); }
    .datos-resumen { display:none; }
    .barra { flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none; }
    .barra::-webkit-scrollbar { display:none; }
    #quien { display:none; }
    /* Datos a pantalla completa: si no, en tablet deja el editor muy corto. */
    .datos[open] { position:fixed; inset:0; z-index:20; overflow:auto; background:var(--papel); border-bottom:0; }
    .datos[open] > summary { position:sticky; top:0; z-index:1; background:var(--papel); border-bottom:2px solid #000; }
    .datos[open] > summary::after { content:'Cerrar ✕'; margin-left:auto; font-size:10px; font-weight:700; letter-spacing:.06em; }
    .datos[open] .datos-grid { max-height:none; overflow:visible; padding-bottom:24px; }
  }

  @media (max-width:640px) {
    body { font-size:13px; }
    body > header { padding:8px 10px; gap:6px 8px; min-height:0; }
    h1 { font-size:1.25rem; }
    .meta { display:none; }
    .estado { font-size:9.5px; }
    .barra { width:100%; margin-left:0; flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none; gap:6px; }
    .barra::-webkit-scrollbar { display:none; }
    #quien, .pie-teclas { display:none; }
    body > header button { flex:0 0 auto; padding:8px 9px; font-size:9.5px; }
    #b-lista { order:-2; }
    #b-guardar { order:-1; }
    .lista-cab { padding:10px; gap:8px; }
    .lista-cuerpo { padding:6px 10px 32px; }
    .fila { grid-template-columns:1fr; gap:8px; padding:10px; }
    .fila-acciones { justify-content:flex-end; }
    .f-agr { white-space:normal; }
    .datos-grid { grid-template-columns:1fr; max-height:46vh; padding:2px 10px 12px; }
    .datos > summary { padding:8px 10px; }
    .datos-slug { display:none; }
    .cab { padding:6px 8px; gap:6px; min-height:34px; }
    #editor-meta { font-size:9.5px; }
    .tabs { padding:6px 8px; }
    .tabs button { padding:11px 4px; }
    /* En el móvil la banda de estado quita altura al editor: el estado ya se
       ve en la lista (LOCAL / EN GITHUB) y en el pie. */
    #nota-local { display:none !important; }
    /* En local el pie solo dice «Modo local · sin sesión»; en el móvil estorba. */
    body.modo-local footer { display:none; }
    footer { padding:6px 10px; font-size:10px; }
    #aviso { left:8px; right:8px; bottom:8px; padding:10px 12px; font-size:11.5px; }
    dialog { width:96vw; max-height:94dvh; box-shadow:5px 5px 0 #000; }
    dialog form, dialog .cuerpo { padding:14px; max-height:94dvh; }
    .dos { grid-template-columns:1fr; gap:0; }
    .acciones { justify-content:stretch; }
    .acciones button { flex:1; }
    #login { padding:16px; }
    #login .caja { padding:22px 18px; }
    .vistas { padding:0 8px; }
    .vistas button { padding:10px 11px; font-size:9.5px; }
    .stats-panel, .comentarios-panel { padding:12px 10px 32px; }
    .stats-grid { grid-template-columns:1fr 1fr; }
    .stat-valor { font-size:1.45rem; }
    .stats-cab h2, .comentarios-cab h2 { font-size:1.4rem; }
    .stats-tabla .progreso { display:none; }
    .stats-tabla th, .stats-tabla td { padding:7px 8px; font-size:10.5px; }
    .peticion-acciones button { padding:8px 9px; }
  }
</style>
</head>
<body>
<header>
  <h1><a href="/admin/" id="b-inicio" title="Volver al inicio del panel">Admin</a></h1>
  <span class="meta" id="cab-meta"></span>
  <span class="estado" id="cab-estado"></span>
  <div class="barra">
    <button id="b-lista" hidden>← Lista</button>
    <button id="b-nueva" hidden>Nueva ficha</button>
    <button id="b-letra" hidden>＋ Letra</button>
    <button id="b-publicar" hidden title="Pasa el borrador a acordes y abre la PR">Publicar</button>
    <button id="b-comprobar" hidden>Comprobar</button>
    <button id="b-pr" hidden>Ver PR</button>
    <button id="b-fusionar" hidden>Fusionar</button>
    <button id="b-avisos" hidden>Avisos</button>
    <button id="b-revisado" class="revisado" hidden>Revisado ✓</button>
    <button id="b-guardar" class="principal" hidden>Guardar</button>
    <span id="quien" class="meta"></span>
  </div>
</header>

<nav class="vistas" id="nav-vistas" hidden>
  <button type="button" data-vista="editor" class="sel">Editor</button>
  <button type="button" data-vista="stats">Estadísticas</button>
  <button type="button" data-vista="comentarios">Comentarios</button>
</nav>

<main>
  <div id="login" hidden>
    <div class="caja">
      <h2>Panel privado</h2>
      <p>Solo el propietario. Entra con tu cuenta de GitHub.</p>
      <a class="boton principal" href="/admin/api/auth">Entrar con GitHub</a>
    </div>
  </div>

  <div id="vista-lista" hidden>
    <div class="lista-cab">
      <div class="buscador">
        <svg class="lupa" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line></svg>
        <input id="q" type="search" placeholder="Buscar pieza, agrupación, año o título…" autocomplete="off">
        <button id="q-limpiar" class="limpiar" type="button" aria-label="Limpiar la búsqueda" hidden>✕</button>
      </div>
      <div class="filtros" id="filtros">
        <button type="button" data-filtro="todas" class="sel">Todas <span class="cuenta" data-cuenta="todas"></span></button>
        <button type="button" data-filtro="pendientes" title="Borradores de acordes3 y fichas con una PR abierta">Acordes3 <span class="cuenta" data-cuenta="pendientes"></span></button>
        <button type="button" data-filtro="publicadas" title="Fichas de acordes (publicadas)">Acordes <span class="cuenta" data-cuenta="publicadas"></span></button>
        <button type="button" data-filtro="porPublicar" id="f-por-publicar" hidden title="Fichas de acordes que están en el proyecto pero aún no en git (solo en local)">Por publicar <span class="cuenta" data-cuenta="porPublicar"></span></button>
        <button type="button" data-filtro="revisar" title="Coplas que aún no se han revisado a mano">Por revisar <span class="cuenta" data-cuenta="revisar"></span></button>
      </div>
    </div>
    <div class="lista-cuerpo">
      <div class="filas" id="filas"></div>
      <p class="lista-vacio" id="lista-vacio" hidden></p>
      <p class="lista-tope" id="lista-tope" hidden>Mostrando las 300 primeras. Afina la búsqueda para ver el resto.</p>
    </div>
  </div>

  <div id="vista-editor" hidden>
    <details class="datos" id="datos">
      <summary>
        <span class="datos-tit">Datos</span>
        <span class="datos-resumen" id="datos-resumen"></span>
        <span class="datos-slug" id="datos-slug"></span>
      </summary>
      <div class="datos-grid" id="f-datos">
        <div class="campo"><label>Pieza</label><input name="pieza" required></div>
        <div class="campo"><label>Agrupación</label><input name="agrupacion" required></div>
        <div class="campo"><label>Año</label><input name="year" inputmode="numeric" required></div>
        <div class="campo"><label>Cejilla</label><input name="cejilla" inputmode="numeric" placeholder="—"></div>
        <div class="campo"><label>Música</label><input name="musica" placeholder="autores separados por coma"></div>
        <div class="campo"><label>Letra</label><input name="letra" placeholder="autores separados por coma"></div>
        <div class="campo"><label>Título de la letra</label><input name="letraTitulo" placeholder="solo letras alternativas"></div>
        <div class="campo"><label>Frase clave</label><input name="fraseClave"></div>
        <div class="campo ancho"><label>Imagen</label><input name="img" required placeholder="https://…"></div>
        <div class="campo ancho"><label>Vídeo (embed)</label><input name="video" placeholder="https://www.youtube.com/embed/…"></div>
        <div class="campo"><label>Destacada</label><input name="destacada" inputmode="numeric" placeholder="orden en portada"></div>
        <div class="campo"><label>Recomendada</label><select name="recomendada"><option value="">—</option><option value="true">Sí</option><option value="false">No</option></select></div>
        <div class="campo"><label>Cover</label><input name="cover" placeholder="opcional"></div>
        <div class="campo"><label>Autor del cover</label><input name="autorCover" placeholder="opcional"></div>
      </div>
    </details>
    <div id="nota-local" hidden>
      <span id="nota-local-texto"></span>
      <button type="button" id="nota-local-cerrar" class="cerrar" aria-label="Cerrar el aviso">✕</button>
    </div>
    <div class="tabs">
      <button data-pane="der">Base</button>
      <button data-pane="cen" class="sel">Editor</button>
      <button data-pane="izq">Original</button>
    </div>
    <div class="cols" id="cols">
      <section class="pane" data-pane="der">
        <div class="cab"><b>Base</b><select id="base-sel" title="Elige la ficha con la que comparar"></select></div>
        <pre id="ref-der"></pre>
      </section>
      <section class="pane activo" data-pane="cen">
        <div class="cab"><b>Editor</b><span id="editor-meta"></span><button type="button" id="b-zoom" hidden>Ajustar</button></div>
        <div class="lienzo" id="lienzo">
          <div class="hoja" id="hoja">
            <pre id="capa"></pre>
            <textarea id="editor" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
            <div class="regla" id="regla" aria-hidden="true"></div>
          </div>
          <div id="sug"></div>
        </div>
      </section>
      <section class="pane" data-pane="izq">
        <div class="cab"><b>Original</b></div>
        <pre id="ref-izq"></pre>
      </section>
    </div>
  </div>

  <div id="vista-stats" hidden>
    <div class="stats-panel">
      <header class="stats-cab">
        <div>
          <h2>Estadísticas</h2>
          <p class="meta">Contando desde 19/01/2025 · Datos en tiempo real desde Cloudflare D1</p>
        </div>
        <button type="button" id="b-stats-refrescar">Actualizar</button>
      </header>
      <div id="stats-contenido" class="stats-contenido"><p class="cargando">Cargando…</p></div>
    </div>
  </div>

  <div id="vista-comentarios" hidden>
    <div class="comentarios-panel">
      <header class="comentarios-cab">
        <div>
          <h2>Comentarios</h2>
          <p class="meta">Peticiones de <code>/pedir-copla</code></p>
        </div>
        <div class="comentarios-acciones">
          <select id="orden-peticiones" title="Ordenar las peticiones">
            <option value="pendientes">Pendientes y votos</option>
            <option value="votos">Más votadas</option>
            <option value="fecha">Más recientes</option>
            <option value="autor">Autor A-Z</option>
          </select>
          <button type="button" id="b-comentarios-refrescar">Actualizar</button>
        </div>
      </header>
      <div id="peticiones" class="peticiones"><p class="cargando">Cargando…</p></div>
    </div>
  </div>
</main>

<footer>
  <span class="pie-teclas"><kbd>Alt</kbd>+<kbd>←</kbd><kbd>→</kbd> mover acorde</span>
  <span class="pie-teclas"><kbd>Ctrl</kbd>+<kbd>S</kbd> guardar</span>
  <span class="pie-teclas"><kbd>Ctrl</kbd>+<kbd>Z</kbd> deshacer</span>
  <span id="pie"></span>
</footer>

<div id="aviso"></div>

<dialog id="dlg-nueva">
  <form id="f-nueva">
    <h2 id="dlg-nueva-titulo">Nueva ficha</h2>
    <p class="nota" id="dlg-nueva-nota">Se crea como borrador con el bloque de la ficha base. Después cambias la letra y mueves los acordes.</p>
    <input type="hidden" name="clon" value="">
    <div class="dos">
      <div class="campo"><label>Pieza</label><input name="pieza" value="Pasodoble" required></div>
      <div class="campo"><label>Agrupación</label><input name="agrupacion" required></div>
      <div class="campo"><label>Año</label><input name="year" inputmode="numeric" required></div>
      <div class="campo"><label>Cejilla</label><input name="cejilla" inputmode="numeric" placeholder="opcional"></div>
      <div class="campo"><label>Música</label><input name="musica"></div>
      <div class="campo"><label>Letra</label><input name="letra"></div>
      <div class="campo"><label>Título de la letra</label><input name="letraTitulo"></div>
      <div class="campo"><label>Vídeo (embed)</label><input name="video"></div>
      <div class="campo"><label>Imagen</label><input name="img"></div>
      <div class="campo"><label>Ficha base (de la que copiar acordes)</label><input name="base" list="slugs" placeholder="slug"></div>
    </div>
    <div class="campo"><label>Frase clave</label><input name="fraseClave"></div>
    <datalist id="slugs"></datalist>
    <div class="acciones">
      <button type="button" id="n-cancelar">Cancelar</button>
      <button type="submit" class="principal">Crear</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-letra">
  <form id="f-letra">
    <h2>Nueva letra pendiente</h2>
    <p class="nota">Se apunta en <code>letras-pendientes.md</code> para buscarla y ponerle los acordes después.</p>
    <div class="dos">
      <div class="campo"><label>Frase que recuerdas</label><input name="frase" required placeholder="primera frase o la que te acuerdes"></div>
      <div class="campo"><label>Agrupación</label><input name="agrupacion" required></div>
      <div class="campo"><label>Fuente</label><input name="fuente" placeholder="opcional (URL)"></div>
      <div class="campo"><label>Notas</label><input name="notas" placeholder="opcional"></div>
    </div>
    <p class="nota" id="letra-base"></p>
    <div class="acciones">
      <button type="button" id="l-cancelar">Cancelar</button>
      <button type="submit" class="principal">Añadir a la cola</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-aviso">
  <div class="cuerpo">
    <h2>Avisos</h2>
    <p class="meta" id="aviso-meta"></p>
    <div class="campo"><textarea id="aviso-texto" readonly></textarea></div>
    <div class="acciones">
      <button type="button" id="av-copiar">Copiar</button>
      <button type="button" id="av-tuit">Abrir en X</button>
      <button type="button" id="av-cerrar" class="principal">Cerrar</button>
    </div>
  </div>
</dialog>

<dialog id="dlg-publicar">
  <div class="cuerpo">
    <h2>Publicar</h2>
    <p class="nota" id="publicar-plan"></p>
    <pre class="log" id="publicar-log"></pre>
    <div class="acciones">
      <button type="button" id="publicar-avisos" hidden>Copiar aviso</button>
      <button type="button" id="publicar-cerrar" class="principal">Cerrar</button>
    </div>
  </div>
</dialog>

<script>
import '../scripts/estudio.js';
</script>
</body>
</html>
