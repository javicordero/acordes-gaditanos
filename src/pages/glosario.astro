---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/page/Breadcrumb.astro';
import glosarioJson from '../data/glosario-acordes.json';
import { slugAcorde, type EntradaGlosario, type Glosario } from '../lib/acordes';
import {
  ORDEN_RAICES,
  ORDEN_SUFIJOS,
  TIPO_NOMBRE,
  notacionInglesa,
} from '../lib/glosario-acordes';
import { LISTA_AGRUPACIONES } from '../lib/agrupaciones-acordes';

const glosario = (glosarioJson as unknown as { acordes: Glosario }).acordes;

const rankSufijo = (entrada: EntradaGlosario) => {
  const i = ORDEN_SUFIJOS.indexOf(entrada.sufijo);
  return i === -1 ? ORDEN_SUFIJOS.length : i;
};

const grupos = ORDEN_RAICES.map((raiz) => {
  const acordes = Object.entries(glosario)
    .filter(([, entrada]) => entrada.raiz === raiz && entrada.posiciones.length > 0)
    .sort((a, b) => {
      const porTipo = rankSufijo(a[1]) - rankSufijo(b[1]);
      if (porTipo !== 0) return porTipo;
      return a[1].sufijo.localeCompare(b[1].sufijo, 'es');
    })
    .map(([etiqueta, entrada]) => {
      const tipo = TIPO_NOMBRE[entrada.sufijo] ?? entrada.sufijo;
      const ingles = notacionInglesa(entrada);
      return { etiqueta, entrada, tipo, ingles };
    });

  return {
    raiz,
    id: `raiz-${slugAcorde({ raiz, sufijo: '', bajo: null })}`,
    acordes,
  };
}).filter((grupo) => grupo.acordes.length > 0);

const totalAcordes = grupos.reduce((total, grupo) => total + grupo.acordes.length, 0);

const title = 'Glosario de acordes de guitarra - Acordes Gaditanos';
const description =
  'Diccionario de acordes de guitarra con diagramas: elige una fundamental o busca el acorde y accede a todas sus posiciones, con cuerdas mudas, al aire y cejillas. Notación española (Do, Re, Mi…) e inglesa (C, D, E…).';
const keywords =
  'glosario de acordes, diccionario de acordes, acordes de guitarra, diagramas de acordes, cómo se tocan los acordes, acordes de Carnaval, Do Re Mi, cejillas';

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Glosario de acordes de guitarra',
  description,
  url: canonicalURL,
  inLanguage: 'es-ES',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Acordes Gaditanos',
    url: Astro.site,
  },
};
---

<Layout title={title} description={description} keywords={keywords}>
  <script type='application/ld+json' set:html={JSON.stringify(webPageSchema)} />

  <Breadcrumb current='Glosario de acordes' />

  <div class='main-container'>
    <section>
      <article class='container-layout inner-content glosario'>
        <header class='glosario__header'>
          <h1>Glosario de acordes de guitarra</h1>
          <p class='glosario__intro'>
            Elige una fundamental o busca el acorde por su nombre (en notación española o inglesa) y
            entra en su página: allí tienes todas las posiciones con diagrama, la digitación de cada
            cuerda y las coplas del Carnaval de Cádiz que lo usan.
          </p>
          <p class='glosario__nota'>
            Los diagramas están en la página de cada acorde, en afinación estándar
            (Mi-La-Re-Sol-Si-Mi). Las cuerdas marcadas con <strong>×</strong> no se tocan y las
            marcadas con <strong>○</strong> suenan al aire.
          </p>
        </header>

        <div class='glosario__buscador'>
          <label class='glosario__label' for='glosario-buscar'>Buscar acorde</label>
          <input
            id='glosario-buscar'
            class='glosario__input'
            type='search'
            placeholder='Ej.: Mi7, C7, Sib, semidisminuido…'
            autocomplete='off'
            spellcheck='false'
          />
          <p class='glosario__resultados' id='glosario-resultados' aria-live='polite'>
            {totalAcordes} acordes
          </p>
        </div>

        <p class='glosario__reconocer'>
          <span class='glosario__reconocer-texto'>¿No sabes qué acorde estás tocando?</span>
          <a
            href='/reconocer-acorde'
            data-ga-event='click_reconocer_acorde_glosario'
          >
            Dibújalo en el mástil y te decimos cómo se llama →
          </a>
        </p>

        <p class='glosario__herramientas'>
          También te pueden servir el
          <a href='/afinador-guitarra' data-ga-event='click_afinador_glosario'>
            afinador de guitarra</a
          >, el
          <a href='/transportar-acordes' data-ga-event='click_transportador_glosario'>
            transportador de acordes</a
          >
          y el resto de <a href='/herramientas'>herramientas</a>.
        </p>

        <nav class='glosario__indice' aria-label='Fundamentales'>
          {
            grupos.map((grupo) => (
              <a href={`#${grupo.id}`} data-chip={grupo.id}>
                {grupo.raiz}
                <span class='glosario__indice-cuenta'>{grupo.acordes.length}</span>
              </a>
            ))
          }
        </nav>

        <div class='glosario__lista'>
          {
            grupos.map((grupo) => (
              <details class='glosario-grupo' id={grupo.id}>
                <summary class='glosario-grupo__resumen'>
                  <span class='glosario-grupo__raiz'>{grupo.raiz}</span>
                  <span class='glosario-grupo__cuenta'>{grupo.acordes.length} acordes</span>
                </summary>

                <ul class='glosario-acordes'>
                  {grupo.acordes.map(({ etiqueta, entrada, tipo, ingles }) => (
                    <li class='glosario-acorde-item' id={entrada.slug}>
                      <a
                        class='glosario-acorde'
                        href={`/glosario/${entrada.slug}`}
                        data-acorde={etiqueta}
                        data-ga-event='click_glosario_ver_acorde'
                      >
                        <span class='glosario-acorde__nombre'>{etiqueta}</span>
                        <span class='glosario-acorde__ingles'>{ingles}</span>
                        <span class='glosario-acorde__tipo'>
                          {tipo} · {entrada.posiciones.length} pos.
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
        </div>

        <p class='glosario__vacio' id='glosario-vacio' hidden>
          No hay acordes que coincidan con esa búsqueda. Prueba con otra grafía (por ejemplo,
          <em>Sib</em>, <em>Bb</em>, <em>La#</em> o <em>m7</em>).
        </p>

        <nav class='glosario__selecciones' aria-labelledby='selecciones-titulo'>
          <h2 id='selecciones-titulo'>Selecciones</h2>
          <p class='glosario__selecciones-intro'>
            Si no buscas un acorde concreto sino aprender o resolver una duda, empieza por una de
            estas selecciones: son pocas, están explicadas y enlazan a cada ficha.
          </p>
          <ul>
            {
              LISTA_AGRUPACIONES.map((grupo) => (
                <li>
                  <a
                    href={`/${grupo.slug}`}
                    data-ga-event='click_seleccion_glosario'
                    data-ga-params={JSON.stringify({ destino: grupo.clave })}
                  >
                    {grupo.h1}
                  </a>
                  <span>{grupo.resumen}</span>
                </li>
              ))
            }
          </ul>
        </nav>
      </article>
    </section>
  </div>
</Layout>

<style is:global>
  .glosario__header {
    margin: 8px 0 20px;

    & h1 {
      margin: 0 0 16px;
      font-size: 1.6rem;
      font-weight: 700;
      line-height: normal;
      letter-spacing: 0.5px;
      color: var(--primary-color);
      text-transform: uppercase;
      max-width: fit-content;
      position: relative;

      &::after {
        content: '';
        display: block;
        position: absolute;
        left: 0;
        bottom: -6px;
        width: 95%;
        height: 6px;
        background: var(--primary-contrast-color);
      }
    }
  }

  .glosario__intro {
    margin: 0;
    max-width: 70ch;
    color: var(--text-color);
    line-height: 1.6;
  }

  .glosario__buscador {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding: 12px 14px;
    border: 2px solid var(--primary-color);
    background: var(--card-background-color);
    box-shadow: 4px 4px 0 0 var(--primary-color);
  }

  .glosario__label {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--primary-color);
  }

  .glosario__input {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 10px;
    border: 2px solid var(--primary-color);
    border-radius: 0;
    background: var(--card-background-color);
    color: var(--text-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 0.9rem;
  }

  .glosario__input:focus-visible {
    outline: 3px solid var(--primary-contrast-color);
    outline-offset: 1px;
  }

  .glosario__resultados {
    margin: 0;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-secondary-color);
    white-space: nowrap;
  }

  .glosario__reconocer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0 0 16px;
    padding: 10px 12px;
    border: 2px dashed var(--primary-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-color);
  }

  .glosario__reconocer-texto {
    font-weight: 800;
    color: var(--primary-color);
  }

  .glosario__reconocer a {
    color: var(--link-color);
    font-weight: 700;
    text-decoration: none;
  }

  .glosario__reconocer a:hover {
    color: var(--link-hover-color);
  }

  .glosario__reconocer a:focus-visible {
    outline: 3px solid var(--primary-contrast-color);
    outline-offset: 2px;
  }

  .glosario__herramientas {
    margin: -6px 0 16px;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-secondary-color);
  }

  .glosario__herramientas a {
    color: var(--link-color);
    font-weight: 700;
    text-decoration: none;
  }

  .glosario__herramientas a:hover {
    color: var(--link-hover-color);
  }

  .glosario__indice {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;

    & a {
      display: inline-flex;
      align-items: baseline;
      gap: 5px;
      padding: 3px 9px;
      border: 2px solid var(--primary-color);
      background: var(--card-background-color);
      color: var(--primary-color);
      font-family: 'Roboto Mono', monospace;
      font-size: 0.75rem;
      font-weight: 700;
      text-decoration: none;
    }

    & a:hover {
      background: var(--primary-contrast-color);
      color: var(--on-bright-color);
    }

    & a[hidden] {
      display: none;
    }
  }

  .glosario__indice-cuenta {
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--text-secondary-color);
  }

  .glosario__indice a:hover .glosario__indice-cuenta {
    color: var(--on-bright-color);
  }

  .glosario__lista {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .glosario-grupo {
    border: 2px solid var(--primary-color);
    background: var(--card-background-color);
    scroll-margin-top: calc(var(--nav-height) + 16px);

    &[hidden] {
      display: none;
    }
  }

  .glosario-grupo__resumen {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 10px 12px;
    cursor: pointer;
    list-style: none;
    font-family: 'Roboto Mono', monospace;
    color: var(--primary-color);
  }

  .glosario-grupo__resumen::-webkit-details-marker {
    display: none;
  }

  .glosario-grupo__resumen::after {
    content: '+';
    margin-left: auto;
    font-size: 1rem;
    font-weight: 700;
    color: var(--primary-contrast-color);
  }

  .glosario-grupo[open] > .glosario-grupo__resumen::after {
    content: '−';
  }

  .glosario-grupo__resumen:hover {
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  .glosario-grupo__resumen:hover .glosario-grupo__cuenta {
    color: var(--on-bright-color);
  }

  .glosario-grupo__resumen:focus-visible {
    outline: 3px solid var(--primary-contrast-color);
    outline-offset: -3px;
  }

  .glosario-grupo__raiz {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .glosario-grupo__cuenta {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--text-secondary-color);
  }

  .glosario-acordes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 6px;
    margin: 0;
    padding: 10px 12px 12px;
    list-style: none;
    border-top: 2px solid var(--primary-color);
  }

  .glosario-acorde-item[hidden] {
    display: none;
  }

  .glosario-acorde-item:target .glosario-acorde {
    border-color: var(--primary-contrast-color);
    box-shadow: 4px 4px 0 0 var(--primary-contrast-color);
  }

  .glosario-acorde-item {
    scroll-margin-top: calc(var(--nav-height) + 16px);
  }

  .glosario-acorde {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0 8px;
    height: 100%;
    box-sizing: border-box;
    padding: 6px 8px;
    border: 2px solid var(--primary-color);
    background: var(--card-background-color);
    color: var(--primary-color);
    font-family: 'Roboto Mono', monospace;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .glosario-acorde:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 0 var(--primary-color);
  }

  .glosario-acorde:focus-visible {
    outline: 3px solid var(--primary-contrast-color);
    outline-offset: 2px;
  }

  .glosario-acorde__nombre {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.4px;
    color: var(--acorde-color);
  }

  .glosario-acorde__ingles {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-secondary-color);
  }

  .glosario-acorde__tipo {
    grid-column: 1 / -1;
    font-size: 0.62rem;
    color: var(--text-secondary-color);
  }

  .glosario__vacio {
    margin-top: 10px;
    padding: 14px;
    border: 2px dashed var(--primary-color);
    color: var(--text-color);
  }

  .glosario__vacio[hidden] {
    display: none;
  }

  .glosario__selecciones {
    margin-top: 34px;
    padding-top: 12px;
    border-top: 2px solid var(--primary-color);

    & h2 {
      margin: 0 0 10px;
      font-size: 1.1rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--primary-color);
    }

    & ul {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 10px;
      margin: 12px 0 0;
      padding: 0;
      list-style: none;
    }

    & li {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 10px 12px;
      border: 2px solid var(--primary-color);
      background: var(--card-background-color);
    }

    & a {
      font-weight: 700;
      color: var(--link-color);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    & a:hover {
      color: var(--link-hover-color);
    }

    & span {
      font-size: 0.78rem;
      line-height: 1.5;
      color: var(--text-secondary-color);
    }
  }

  .glosario__nota {
    margin: 12px 0 0;
    max-width: 70ch;
    color: var(--text-color);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .glosario__header h1 {
      font-size: 1.25rem;

      &::after {
        height: 4px;
        bottom: -2px;
      }
    }

    .glosario__buscador {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .glosario-acordes {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { enviarEvento, seguirEnlaces } from '../lib/analitica';

  const entrada = document.getElementById('glosario-buscar') as HTMLInputElement | null;
  const secciones = Array.from(document.querySelectorAll<HTMLDetailsElement>('.glosario-grupo'));
  const chips = Array.from(document.querySelectorAll<HTMLAnchorElement>('.glosario__indice a'));
  const contador = document.getElementById('glosario-resultados');
  const vacio = document.getElementById('glosario-vacio');

  if (entrada) {
    const normalizar = (texto: string) =>
      texto
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();

    // El texto visible (nombre, notación inglesa y tipo) es el índice de
    // búsqueda: no hace falta guardarlo en cada enlace.
    const tarjetas = Array.from(
      document.querySelectorAll<HTMLElement>('.glosario-acorde-item'),
    ).map((el) => ({ el, texto: normalizar(el.textContent ?? '') }));

    let temporizador: ReturnType<typeof setTimeout> | undefined;

    const registrarBusqueda = (consulta: string) => {
      const w = window as any;
      if (typeof w.gtag !== 'function' || !consulta) return;
      clearTimeout(temporizador);
      temporizador = setTimeout(() => {
        w.gtag('event', 'glosario_buscar', {
          event_category: 'glosario',
          event_label: consulta,
        });
      }, 600);
    };

    /** Abre la fundamental del hash (o del clic en un chip) y lleva el foco. */
    const abrirDelHash = () => {
      if (!window.location.hash) return;
      const objetivo = document.getElementById(window.location.hash.slice(1));
      if (!objetivo) return;

      const grupo =
        objetivo instanceof HTMLDetailsElement
          ? objetivo
          : objetivo.closest<HTMLDetailsElement>('.glosario-grupo');
      if (grupo) grupo.open = true;
      objetivo.scrollIntoView({ block: 'start' });
    };

    const filtrar = () => {
      const consulta = normalizar(entrada.value);
      let visibles = 0;

      for (const { el, texto } of tarjetas) {
        const coincide = !consulta || texto.includes(consulta);
        el.hidden = !coincide;
        if (coincide) visibles += 1;
      }

      for (const seccion of secciones) {
        const tiene = !!seccion.querySelector('.glosario-acorde-item:not([hidden])');
        seccion.hidden = !tiene;
        // Al buscar, se despliegan las fundamentales con resultados; al
        // borrar, vuelven a quedar plegadas (el índice arranca "vacío").
        seccion.open = consulta ? tiene : false;
      }

      for (const chip of chips) {
        const destino = chip.dataset.chip;
        chip.hidden = !!destino && !!document.getElementById(destino)?.hidden;
      }

      if (contador) contador.textContent = `${visibles} acordes`;
      if (vacio) vacio.hidden = visibles > 0;

      registrarBusqueda(consulta);
    };

    entrada.addEventListener('input', filtrar);

    document.addEventListener('click', (e) => {
      const objetivo = e.target as HTMLElement | null;
      if (!objetivo) return;

      const acorde = objetivo.closest<HTMLAnchorElement>('a.glosario-acorde');
      if (acorde) {
        enviarEvento(
          'click_glosario_ver_acorde',
          {
            acorde: acorde.dataset.acorde ?? '',
            ubicacion: 'indice',
            transport_type: 'beacon',
          },
          'glosario',
        );
        return;
      }

      const chip = objetivo.closest<HTMLAnchorElement>('.glosario__indice a');
      if (!chip) return;
      const destino = chip.dataset.chip;
      const grupo = destino ? document.getElementById(destino) : null;
      if (grupo instanceof HTMLDetailsElement) grupo.open = true;
    });

    window.addEventListener('hashchange', abrirDelHash);
    if (window.location.hash) {
      setTimeout(abrirDelHash, 50);
    }
  }

  seguirEnlaces('a[data-ga-event]:not(.glosario-acorde)', 'glosario');
</script>
