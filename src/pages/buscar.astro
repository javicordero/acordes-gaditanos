---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CardsGroup from '../components/page/CardsGroup.astro';
import Banner468X60 from '../components/ads/Banner468x60.astro';
import Banner320X50 from '../components/ads/Banner320x50.astro';

// La página no trae las cards: las pide a `/indice-tarjetas.json` y las pinta en
// el navegador (antes eran 3,8 MB de HTML). Aquí solo se renderiza **una** card
// dentro de un `<template>`: es el prototipo que el script clona para rellenar
// cada resultado. Al ir en un `<template>` no se pinta ni descarga su imagen,
// pero sí aporta el HTML, las clases y los estilos *scoped* de la card.
const [prototipo] = await getCollection('acordes');
---

<Layout
  title='Acordes Gaditanos - Acordes del Carnaval de Cádiz'
  description='La mayor colección de acordes de guitarra del Carnaval de Cádiz. Encuentra acordes de chirigotas, comparsas, cuartetos y coros para tocar con tu guitarra.'
  noindex>
  <div class='main-container'>
    <Banner468X60 adKey='0a8164971e8c287ce3c84cea534f2266' />
    <Banner320X50 adKey='00168e813d28ccdbf699a41e61d3b2ab' />
    <div class='container-layout'>
      <h1 class='search-title'>Buscar acordes</h1>
    </div>
    <!-- Mensaje de sin resultados (oculto por defecto): texto suelto, sin caja -->
    <article class='no-results' role='region' aria-labelledby='no-results-heading' style='display: none'>
      <div class='container-layout no-results-texto'>
        <h2 id='no-results-heading'>No se encontraron resultados para <strong class='search-query'></strong></h2>
        <p>Prueba con otra palabra, con el nombre de la agrupación o con el año.</p>
        <p class='no-results-suggestion'>¿Buscas otra copla? <a href='/pedir-copla'>Pídela aquí</a>.</p>
      </div>
    </article>

    <!-- Aviso si el catálogo no se puede descargar (oculto por defecto) -->
    <article class='no-results results-error' role='alert' style='display: none'>
      <div class='container-layout no-results-texto'>
        <h2>No se han podido cargar los resultados</h2>
        <p>Ha fallado la descarga del listado de coplas. Recarga la página para volver a intentarlo.</p>
      </div>
    </article>

    <!-- Aquí se pintan los resultados -->
    <div class='results-container'></div>

    <!-- Prototipo que clona el script: una card de verdad, dentro de un
         `<template>` para que no se pinte ni descargue su imagen. -->
    <template id='plantilla-resultados'>
      {prototipo && <CardsGroup year={prototipo.data.year} acordes={[prototipo]} />}
    </template>
  </div>
</Layout>

<style>
  .main-container {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap);
  }

  /* `.container-layout` lleva `margin: auto` (para centrarse en horizontal) y,
     dentro de una columna flex, ese `auto` también se come el alto sobrante: en
     una página corta el H1 y el aviso se iban al centro de la pantalla. Aquí se
     quedan arriba, alineados con las cards. */
  .main-container :global(.container-layout) {
    margin-top: 0;
    margin-bottom: 0;
  }

  .search-title {
    position: relative;
    color: var(--primary-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    max-width: fit-content;
    margin: 0 0 14px;

    &::after {
      content: '';
      display: block;
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 95%;
      height: 6px;
      background: var(--primary-contrast-color);
    }
  }

  /* El título de resultados no es el de la página: va más pequeño, sin la raya
     naranja y con el término buscado en un chip. Se toca con `:global` porque
     el bloque se clona desde el `<template>` (no lleva el cid de esta página). */
  .results-container :global(.resultados-titulo) {
    color: var(--text-color);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-transform: none;
    max-width: none;

    &::after {
      display: none;
    }
  }

  /* El término buscado, entre comillas y en negrita: sin fondo ni caja, que el
     título de resultados no compita con el de la página. */  .results-container :global(.resultados-consulta) {
    color: var(--primary-color);
    font-weight: 700;
  }

  .results-container {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap);

    &:empty {
      display: none;
    }
  }

  /* Sin resultados: texto suelto, en el mismo tono que la línea de resultados,
     sin caja (con el H1 de la página ya hay jerarquía de sobra). */
  .no-results {
    display: none;
    overflow-wrap: break-word;
    word-wrap: break-word;

    & .no-results-texto {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    & h2 {
      color: var(--text-color);
      font-size: 1rem;
      font-family: 'Roboto Mono', monospace;
      font-weight: 700;
      letter-spacing: 0.3px;
      line-height: 1.4;
      text-transform: none;
      margin: 0;

      & strong {
        color: var(--primary-color);
        font-weight: 700;
      }
    }

    & p {
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--text-secondary-color, var(--text-color));
      margin: 0;
    }

    & .no-results-suggestion {
      margin-top: 6px;

      & a {
        color: var(--link-color, #0070f3);
        font-weight: 700;
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;

        &:hover {
          color: var(--on-bright-color);
          background: var(--primary-contrast-color);
          text-decoration: none;
        }
      }
    }
  }

  @media (max-width: 640px) {
    .main-container {
      gap: calc(var(--main-container-gap-sm) - 16px);
    }

    .search-title {
      font-size: 1.6rem;
      margin-bottom: 12px;

      &::after {
        height: 4px;
        bottom: -4px;
      }
    }

    .results-container {
      gap: calc(var(--main-container-gap-sm) - 16px);
    }

    .no-results {
      & h2 {
        font-size: 0.95rem;
      }

      & p {
        font-size: 0.9rem;
      }
    }
  }
</style>

<script>
  // Catálogo de las cards (`/indice-tarjetas.json`), cargado una sola vez.
  type Tarjeta = {
    slug: string;
    year: string;
    img: string;
    agrupacion: string;
    pieza: string;
    piezaDisplay: string;
    piezaTipo: string;
    letraTitulo: string;
    nombreCompleto: string;
    autores: { nombre: string; href: string | null }[];
    musica: string;
    letra: string;
    /** Texto normalizado donde se busca (se calcula al cargar). */
    texto?: string;
  };

  const URL_CATALOGO = '/indice-tarjetas.json';

  function normalizarTexto(texto: string): string {
    return texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  function initSearch() {
    const searchInput = document.querySelector<HTMLInputElement>('#header-search');
    const searchForm = document.querySelector<HTMLFormElement>('.search-form');
    const resultsContainer = document.querySelector<HTMLElement>('.results-container');
    const plantilla = document.querySelector<HTMLTemplateElement>('#plantilla-resultados');
    if (!resultsContainer || !plantilla) return;

    const noResults = document.querySelector<HTMLElement>('.no-results:not(.results-error)');
    const searchQueryElement = noResults?.querySelector('.search-query');
    const resultsError = document.querySelector<HTMLElement>('.results-error');

    const grupoPlantilla = plantilla.content.querySelector<HTMLElement>('.year-group');
    const cardPlantilla = plantilla.content.querySelector<HTMLElement>('.card');
    if (!grupoPlantilla || !cardPlantilla) return;

    // Astro marca los elementos de cada componente con `data-astro-cid-…`: los
    // estilos de la card son *scoped* y un nodo creado en JS sin esas marcas
    // saldría sin estilo. Se copian del prototipo a lo que haga falta crear.
    const marcas = Array.from(cardPlantilla.attributes)
      .map((atributo) => atributo.name)
      .filter((nombre) => nombre.startsWith('data-astro-cid-'));

    function crearEtiqueta<T extends keyof HTMLElementTagNameMap>(
      etiqueta: T,
      clase: string,
      campo: string,
    ): HTMLElementTagNameMap[T] {
      const nodo = document.createElement(etiqueta);
      marcas.forEach((nombre) => nodo.setAttribute(nombre, ''));
      nodo.className = clase;
      nodo.dataset.campo = campo;
      return nodo;
    }

    let catalogo: Tarjeta[] | null = null;
    let peticion: Promise<void> | null = null;

    function cargarCatalogo(): Promise<void> {
      if (peticion) return peticion;
      peticion = fetch(URL_CATALOGO)
        .then((respuesta) => {
          if (!respuesta.ok) throw new Error(`HTTP ${respuesta.status}`);
          return respuesta.json() as Promise<Tarjeta[]>;
        })
        .then((datos) => {
          catalogo = datos.map((tarjeta) => ({
            ...tarjeta,
            texto: normalizarTexto(
              `${tarjeta.pieza} ${tarjeta.agrupacion} ${tarjeta.musica} ${tarjeta.letra} ${tarjeta.letraTitulo}`,
            ),
          }));
          if (resultsError) resultsError.style.display = 'none';
        })
        .catch((error) => {
          peticion = null;
          catalogo = null;
          console.error('No se pudo cargar el catálogo de la búsqueda', error);
          if (resultsError) resultsError.style.display = 'block';
        });
      return peticion;
    }

    /** Rellena en la card clonada los huecos que deja `Card.astro` (`data-campo`). */
    function pintarTarjeta(tarjeta: Tarjeta): HTMLElement {
      const card = cardPlantilla!.cloneNode(true) as HTMLElement;
      const campo = (nombre: string) => card.querySelector<HTMLElement>(`[data-campo="${nombre}"]`);

      const enlace = campo('ancla') as HTMLAnchorElement | null;
      if (enlace) {
        enlace.href = `/acordes/${tarjeta.slug}/`;
        enlace.setAttribute('aria-label', tarjeta.nombreCompleto);
      }

      const imagen = card.querySelector<HTMLImageElement>('.card-image');
      if (imagen) {
        imagen.src = tarjeta.img;
        imagen.alt = `${tarjeta.nombreCompleto} - Carnaval de Cádiz ${tarjeta.year}`;
        // El prototipo trae el nombre de transición de su instancia; el clon
        // lleva el suyo para que el morph card → ficha siga funcionando.
        imagen.removeAttribute('data-astro-transition-scope');
        imagen.style.setProperty('view-transition-name', `img-${tarjeta.slug}`);
      }

      const pieza = campo('pieza');
      if (pieza) {
        pieza.textContent = tarjeta.piezaDisplay;
        pieza.dataset.piezaType = tarjeta.piezaTipo;
      }

      const letra = campo('letra');
      if (tarjeta.letraTitulo) {
        const insignia = letra ?? crearEtiqueta('span', 'badge-letra', 'letra');
        insignia.setAttribute('data-fit-text', '');
        insignia.setAttribute('data-fit-parent', '');
        insignia.setAttribute('data-fit-min', '8');
        insignia.textContent = tarjeta.letraTitulo;
        insignia.title = `Letra: ${tarjeta.letraTitulo}`;
        if (!letra) campo('pieza')?.after(insignia);
      } else if (letra) {
        letra.remove();
      }

      const year = campo('year');
      if (year) year.textContent = tarjeta.year;

      const titulo = campo('titulo');
      if (titulo) {
        titulo.textContent = tarjeta.agrupacion;
        titulo.id = `acordes-${tarjeta.slug}`;
        titulo.removeAttribute('data-astro-transition-scope');
        titulo.style.setProperty('view-transition-name', `titulo-${tarjeta.slug}`);
      }

      const contenedorAutores = campo('autores');
      const autorPlantilla = contenedorAutores?.querySelector('a, span');
      if (contenedorAutores && autorPlantilla) {
        contenedorAutores.replaceChildren(
          ...tarjeta.autores.map((autor) => {
            const nodo = autorPlantilla.cloneNode(true) as HTMLElement;
            nodo.textContent = autor.nombre;
            nodo.title = autor.nombre;
            if (autor.href) {
              nodo.setAttribute('href', autor.href);
              nodo.setAttribute('rel', 'noopener');
            } else {
              nodo.removeAttribute('href');
            }
            return nodo;
          }),
        );
      }

      card.setAttribute('aria-labelledby', `acordes-${tarjeta.slug}`);
      return card;
    }

    /** Pinta el bloque «N resultados para [término]» con las cards que casen. */
    function pintarResultados(tarjetas: Tarjeta[], consulta: string) {
      const grupo = grupoPlantilla!.cloneNode(true) as HTMLElement;
      const titulo = grupo.querySelector('h2');
      const rejilla = grupo.querySelector('.acordes-grid');

      if (titulo) {
        titulo.classList.remove('is-title-minus');
        titulo.classList.add('resultados-titulo');
        // «3 resultados para "término"», sin caja: el término va entre comillas y
        // en negrita.
        const cita = document.createElement('strong');
        cita.className = 'resultados-consulta';
        cita.textContent = `"${consulta}"`;
        titulo.replaceChildren(
          `${tarjetas.length} ${tarjetas.length === 1 ? 'resultado' : 'resultados'} para `,
          cita,
        );
        titulo.id = 'search-results-heading';
      }
      grupo.setAttribute('aria-labelledby', 'search-results-heading');
      if (rejilla) {
        rejilla.setAttribute('aria-labelledby', 'search-results-heading');
        rejilla.replaceChildren(...tarjetas.map(pintarTarjeta));
      }

      resultsContainer!.replaceChildren(grupo);

      // `FitTextInit` solo mide al cargar y al redimensionar: se le avisa.
      window.dispatchEvent(new Event('resize'));
    }

    function limpiarResultados() {
      resultsContainer!.replaceChildren();
      if (noResults) noResults.style.display = 'none';
    }

    // Cada búsqueda lleva un número: si mientras se descarga el catálogo llega
    // otra, la anterior se descarta.
    let turno = 0;

    async function performSearch(query: string) {
      const consulta = query.trim();
      if (!consulta) {
        turno++;
        limpiarResultados();
        return;
      }

      const actual = ++turno;
      await cargarCatalogo();
      if (actual !== turno) return;
      // Sin catálogo, `cargarCatalogo()` ya ha enseñado el aviso de error.
      if (!catalogo) {
        resultsContainer!.replaceChildren();
        return;
      }

      const buscado = normalizarTexto(consulta);
      const encontradas = catalogo.filter((tarjeta) => tarjeta.texto!.includes(buscado));

      if (encontradas.length > 0) {
        pintarResultados(encontradas, consulta);
        if (noResults) noResults.style.display = 'none';
      } else {
        resultsContainer!.replaceChildren();
        if (searchQueryElement) searchQueryElement.textContent = `"${consulta}"`;
        if (noResults) noResults.style.display = 'block';
      }
    }

    // Devuelve el término de búsqueda actual de la URL
    function getQueryFromUrl() {
      return new URLSearchParams(window.location.search).get('q') || '';
    }

    // Último término renderizado (evita re-renderizar al volver con bfcache)
    let renderedQuery: string | null = null;

    function renderQuery(query: string) {
      renderedQuery = query;
      void performSearch(query);
    }

    /**
     * Deja la página arriba del todo y la cabecera a la vista. En móvil la
     * cabecera se esconde al bajar y, como aquí la búsqueda no navega (los
     * resultados se pintan en la misma página), podía quedarse escondida o a
     * medio bajar al buscar. De paso cierra el teclado, que al plegarse mueve el
     * viewport.
     */
    function mostrarCabeceraYArriba() {
      document.querySelector('header[role="banner"]')?.classList.remove('header-hidden');
      window.scrollTo({ top: 0, behavior: 'instant' });
      if (window.matchMedia('(max-width: 640px)').matches) searchInput?.blur();
    }

    // Aplica la búsqueda indicada por la URL (al cargar o al ir atrás/adelante)
    function applySearchFromUrl() {
      const query = getQueryFromUrl();
      if (searchInput && searchInput.value !== query) {
        searchInput.value = query;
      }
      if (query === renderedQuery) return;
      renderQuery(query);
    }

    // Buscar sin recargar (en otras páginas el formulario navega de forma nativa)
    if (searchForm && searchInput) {
      searchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const query = searchInput.value.trim();
        if (!query) return;

        const url = `/buscar/?q=${encodeURIComponent(query)}`;
        if (url !== `${window.location.pathname}${window.location.search}`) {
          history.pushState({ q: query }, '', url);
        }
        renderQuery(query);

        // Al buscar se vuelve arriba y se asegura de que la cabecera esté a la
        // vista: en móvil se esconde al bajar y, al no navegar (los resultados se
        // pintan aquí mismo), podía quedarse escondida o a medio bajar. De paso se
        // cierra el teclado, que al plegarse movía el viewport.
        mostrarCabeceraYArriba();
      });
    }

    // Botón X del header: limpiar resultados y el ?q= de la URL
    document.addEventListener('searchCleared', () => {
      if (searchInput) searchInput.value = '';
      renderQuery('');
      if (window.location.search) {
        history.pushState({}, '', '/buscar/');
      }
    });

    // Atrás/adelante dentro de la página de búsqueda
    window.addEventListener('popstate', () => {
      applySearchFromUrl();
    });

    // Estado inicial a partir de la URL (?q=...) + catálogo adelantado, para que
    // la primera pulsación no espere a la descarga.
    applySearchFromUrl();
    void cargarCatalogo();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }
</script>
