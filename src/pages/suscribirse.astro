---
// src/pages/suscribirse.astro
//
// Página de suscripción a los canales de avisos (WhatsApp y Telegram).
// No hay formulario ni base de datos: suscribirse es unirse al canal y darse
// de baja es salir de él.
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import canales from '../data/canales.json';
---

<Layout
  title='Avisos de coplas nuevas - Acordes Gaditanos'
  description='Recibe un aviso cada vez que subimos una copla nueva al cancionero. Canales gratuitos de WhatsApp y Telegram, sin spam y con baja en un toque.'>
  <div class='main-container'>
    <article class='suscribirse container-layout' aria-labelledby='suscribirse-title'>
      <header class='suscribirse__cabecera'>
        <h1 id='suscribirse-title'>Avisos de coplas nuevas</h1>
        <p class='suscribirse__entradilla'>
          Cuando subo una copla nueva al cancionero, lo aviso en dos canales y en la propia app.
          Solo eso: el aviso con el enlace directo al cifrado. Sin resúmenes semanales, sin
          publicidad y sin tener que darme tu teléfono.
        </p>
      </header>

      <section class='canales' aria-labelledby='canales-title'>
        <h2 class='suscribirse__subtitulo' id='canales-title'>Elige el canal</h2>

        <div class='canales__grid'>
          <div class='canal'>
            <div class='canal__cabecera'>
              <span class='canal__icono' aria-hidden='true'>
                <Icon name='whatsapp' width={26} height={26} />
              </span>
              <h3>WhatsApp</h3>
            </div>
            <p>
              El que más se usa por aquí. Es un <strong>canal</strong>, no un grupo: nadie ve tu
              número y tú no ves el de los demás.
            </p>
            <div class='canal__pie'>
              <a
                class='canal__btn'
                href={canales.whatsapp}
                target='_blank'
                rel='noopener noreferrer'
                data-ga-event='click_canal_suscribirse'
                data-ga-params='{"canal":"whatsapp","ubicacion":"suscribirse"}'>
                Seguir el canal
              </a>
              <figure class='canal__qr'>
                <img
                  src='/qr-whatsapp.svg'
                  alt='Código QR para seguir el canal de WhatsApp de Acordes Gaditanos'
                  width='150'
                  height='150'
                  loading='lazy'
                  decoding='async'
                />
                <figcaption>O escanea el QR con el móvil</figcaption>
              </figure>
            </div>
          </div>

          <div class='canal'>
            <div class='canal__cabecera'>
              <span class='canal__icono' aria-hidden='true'>
                <Icon name='telegram' width={26} height={26} />
              </span>
              <h3>Telegram</h3>
            </div>
            <p>
              No hace falta número de teléfono para entrar desde el ordenador y el canal tiene
              buscador propio.
            </p>
            <div class='canal__pie'>
              <a
                class='canal__btn'
                href={canales.telegram}
                target='_blank'
                rel='noopener noreferrer'
                data-ga-event='click_canal_suscribirse'
                data-ga-params='{"canal":"telegram","ubicacion":"suscribirse"}'>
                Unirme al canal
              </a>
              <figure class='canal__qr'>
                <img
                  src='/qr-telegram.svg'
                  alt='Código QR para unirse al canal de Telegram de Acordes Gaditanos'
                  width='150'
                  height='150'
                  loading='lazy'
                  decoding='async'
                />
                <figcaption>O escanea el QR con el móvil</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>

      <section class='avisos-app' aria-labelledby='avisos-app-title'>
        <h2 class='suscribirse__subtitulo' id='avisos-app-title'>Avisos en la app</h2>

        <div class='avisos-app__caja' data-avisos-caja>
          <div class='avisos-app__cabecera'>
            <span class='avisos-app__icono' aria-hidden='true'>
              <Icon name='campana' width={24} height={24} />
            </span>
            <div class='avisos-app__texto'>
              <h3>Notificaciones en el móvil</h3>
              <p data-avisos-texto>
                Los avisos se activan desde la app instalada en el móvil.
              </p>
            </div>
          </div>

          <div class='avisos-app__acciones'>
            <button type='button' class='canal__btn' data-avisos-activar hidden>
              Activar notificaciones
            </button>
            <button type='button' class='avisos-app__baja' data-avisos-desactivar hidden>
              Desactivar notificaciones
            </button>
          </div>

          <div class='avisos-app__ayuda' data-avisos-ayuda hidden>
            <p data-avisos-ayuda-android hidden>
              Bloqueados en Chrome: toca el candado de la barra → <strong>Permisos</strong> →
              <strong>Notificaciones</strong> → <strong>Permitir</strong>.
            </p>
            <p data-avisos-ayuda-ios hidden>
              Bloqueados: <strong>Ajustes</strong> → <strong>Notificaciones</strong> → Acordes
              Gaditanos → activa <strong>Permitir notificaciones</strong>.
            </p>
          </div>

          <p class='avisos-app__nota'>
            Se guarda solo la dirección de tu móvil y el navegador desde el que activas los avisos:
            ni nombre, ni correo, ni IP. Para dejarlo, desactívalo aquí o desde los ajustes de
            notificaciones del móvil; si lo desinstalas, el aviso deja de llegar solo.
          </p>
        </div>
      </section>

      <section aria-labelledby='recibes-title'>
        <h2 class='suscribirse__subtitulo' id='recibes-title'>Qué te va a llegar</h2>
        <ul class='lista'>
          <li>
            Un aviso por cada copla nueva: <strong>pieza</strong>, <strong>agrupación</strong>,
            <strong>año</strong>, autor de la música y de la letra, y el enlace directo al cifrado.
          </li>
          <li>Ni boletines, ni promociones, ni cosas que no sean coplas del Carnaval.</li>
        </ul>
      </section>

      <section aria-labelledby='baja-title'>
        <h2 class='suscribirse__subtitulo' id='baja-title'>Cómo darte de baja</h2>
        <p>
          Dentro del canal, toca el nombre del canal y elige <strong>Salir</strong>. Al ser un canal,
          no guardamos tu número ni ningún dato tuyo: no hay formulario, no hay lista de correo y no
          hay nada que borrar.
        </p>
      </section>
    </article>
  </div>
</Layout>

<script>
  import { detectarOs, eventoPwa } from '../lib/pwa/analytics';
  import { activarAvisos, desactivarAvisos, estadoAvisos } from '../lib/pwa/avisos';

  declare const gtag: (...args: unknown[]) => void;

  document.querySelectorAll<HTMLElement>('[data-ga-event^="click_canal"]').forEach((enlace) => {
    enlace.addEventListener('click', () => {
      if (typeof gtag !== 'function') return;
      gtag('event', enlace.getAttribute('data-ga-event') || 'click_canal', {
        ...JSON.parse(enlace.getAttribute('data-ga-params') || '{}'),
        page_location: window.location.href,
      });
    });
  });

  // -------------------------------------------------------------------------
  // Avisos push: interruptor de la app instalada
  // -------------------------------------------------------------------------

  const TEXTOS: Record<string, string> = {
    'no-soportado':
      'Tu navegador no admite notificaciones. En iPhone o iPad necesitas iOS 16.4 o superior.',
    'solo-app': 'Abre la app instalada desde la pantalla de inicio y activa los avisos desde aquí.',
    'sin-decidir':
      'Activa las notificaciones y te llegará un aviso cada vez que suba una copla nueva.',
    activado: 'Notificaciones activadas en este móvil.',
    denegado: 'Están bloqueados en los ajustes del móvil.',
    error: 'No se han podido comprobar los avisos. Recarga la página e inténtalo otra vez.',
  };

  function initAvisos() {
    const caja = document.querySelector<HTMLElement>('[data-avisos-caja]');
    if (!caja) return;
    const cajaEl: HTMLElement = caja;

    const texto = cajaEl.querySelector<HTMLElement>('[data-avisos-texto]');
    const btnActivar = cajaEl.querySelector<HTMLButtonElement>('[data-avisos-activar]');
    const btnBaja = cajaEl.querySelector<HTMLButtonElement>('[data-avisos-desactivar]');
    const ayuda = cajaEl.querySelector<HTMLElement>('[data-avisos-ayuda]');

    function pintar(estado: string) {
      if (texto) texto.textContent = TEXTOS[estado] ?? TEXTOS.error;
      if (btnActivar) btnActivar.hidden = estado !== 'sin-decidir';
      if (btnBaja) btnBaja.hidden = estado !== 'activado';

      if (ayuda) {
        ayuda.hidden = estado !== 'denegado';
        if (estado === 'denegado') {
          const android = cajaEl.querySelector<HTMLElement>('[data-avisos-ayuda-android]');
          const ios = cajaEl.querySelector<HTMLElement>('[data-avisos-ayuda-ios]');
          if (android) android.hidden = detectarOs() !== 'android';
          if (ios) ios.hidden = detectarOs() !== 'ios';
        }
      }

      cajaEl.dataset.estado = estado;
    }

    if (cajaEl.dataset.cableado !== '1') {
      cajaEl.dataset.cableado = '1';

      btnActivar?.addEventListener('click', async () => {
        const original = btnActivar.textContent;
        btnActivar.disabled = true;
        btnActivar.textContent = 'Activando…';
        eventoPwa('pwa_push_activar', { ubicacion: 'suscribirse' });

        const estado = await activarAvisos();

        btnActivar.disabled = false;
        btnActivar.textContent = original;
        pintar(estado);
      });

      btnBaja?.addEventListener('click', async () => {
        btnBaja.disabled = true;
        await desactivarAvisos();
        btnBaja.disabled = false;
        pintar('sin-decidir');
      });
    }

    estadoAvisos().then(pintar);
  }

  initAvisos();
  document.addEventListener('astro:page-load', initAvisos);
</script>

<style>
  .suscribirse {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap);
  }

  .suscribirse__cabecera {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h1 {
    margin: 0;
    color: var(--primary-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    position: relative;
    max-width: fit-content;

    &::after {
      content: '';
      display: block;
      position: absolute;
      left: 0;
      bottom: -8px;
      width: 95%;
      height: 6px;
      background: var(--primary-contrast-color);
    }
  }

  .suscribirse__entradilla {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    max-width: 68ch;
    text-wrap: pretty;
  }

  .suscribirse__subtitulo {
    margin: 0 0 12px;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .canales__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--main-container-gap-sm);
  }

  .canal {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
    background: var(--card-background-color);
    border: 2px solid var(--primary-color);
    color: var(--text-color);

    & p {
      margin: 0;
      font-size: 0.9rem;
      line-height: 1.55;
      color: var(--text-secondary-color);
      flex: 1;
    }
  }

  .canal__cabecera {
    display: flex;
    align-items: center;
    gap: 10px;

    & h3 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 800;
    }
  }

  .canal__icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  .canal__pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
  }

  .canal__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 11px 20px;
    background-color: var(--surface-color);
    color: var(--primary-contrast-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid var(--primary-color);
    border-radius: 0;
    box-shadow: 4px 4px 0 0 var(--primary-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.2s ease,
      color 0.2s ease;

    &:hover {
      background-color: var(--primary-contrast-color);
      color: var(--on-bright-color);
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 0 var(--primary-color);
    }

    &:active {
      transform: translate(0, 0);
      box-shadow: 2px 2px 0 0 var(--primary-color);
    }

    &:focus-visible {
      outline: 3px solid var(--primary-contrast-color);
      outline-offset: 3px;
    }
  }

  .canal__qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin: 0;

    & img {
      display: block;
      width: 120px;
      height: 120px;
      background: #fff;
      padding: 6px;
      border: 2px solid var(--primary-color);
    }

    & figcaption {
      font-size: 0.7rem;
      line-height: 1.3;
      color: var(--text-secondary-color);
      text-align: center;
      max-width: 120px;
    }
  }

  .lista {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Avisos push (app instalada) */
  .avisos-app {
    display: block;
  }

  /* Los botones con clase traen su propio `display`: `hidden` no basta. */
  .avisos-app [hidden] {
    display: none !important;
  }

  .avisos-app__caja {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
    background: var(--card-background-color);
    border: 2px solid var(--primary-color);
    color: var(--text-color);
  }

  .avisos-app__cabecera {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .avisos-app__icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 42px;
    height: 42px;
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  .avisos-app__texto {
    display: flex;
    flex-direction: column;
    gap: 4px;

    & h3 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 800;
    }

    & p {
      margin: 0;
      font-size: 0.9rem;
      line-height: 1.55;
      color: var(--text-secondary-color);
    }
  }

  .avisos-app__acciones {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .avisos-app__acciones .canal__btn {
    flex: 0 1 auto;
    min-width: 200px;
    white-space: nowrap;
  }

  .avisos-app__baja {
    min-height: 44px;
    padding: 10px 14px;
    border: 2px solid var(--primary-color);
    background: transparent;
    color: var(--primary-contrast-color);
    font-family: 'Roboto Mono', monospace;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
  }

  .avisos-app__baja:hover {
    background: var(--primary-contrast-color);
    color: var(--on-bright-color);
  }

  .avisos-app__baja:focus-visible {
    outline: 3px solid var(--primary-contrast-color);
    outline-offset: 3px;
  }

  .avisos-app__nota {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-secondary-color);
  }

  .avisos-app__ayuda {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 12px;
    border-left: 4px solid var(--primary-contrast-color);
    background: var(--callout-bg);

    & p {
      margin: 0;
      font-size: 0.85rem;
      line-height: 1.5;
    }
  }

  :global(html[data-theme='dark']) .canal__btn {
    background-color: var(--card-background-color);
    color: var(--text-color);
  }

  @media (max-width: 860px) {
    .canales__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 1.5rem;
    }

    /* En el móvil el QR no sirve: el botón ya abre la app. */
    .canal__qr {
      display: none;
    }

    .canal__btn {
      width: 100%;
    }
  }
</style>
