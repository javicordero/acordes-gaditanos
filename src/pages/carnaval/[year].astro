---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CardsGroup from '../../components/page/CardsGroup.astro';
import Breadcrumb from '../../components/page/Breadcrumb.astro';
import Banner320X50 from '../../components/ads/Banner320x50.astro';
import Banner468X60 from '../../components/ads/Banner468x60.astro';
import AnuncioSobrePagina from '../../components/ads/AnuncioSobrePagina.astro';
import { parseSpanishDate } from '../../lib/index';

export async function getStaticPaths() {
  const acordes = await getCollection('acordes');

  // Obtener todos los años únicos
  const years = [...new Set(acordes.map((acorde) => acorde.data.year))];

  return years.map((year) => {
    // Filtrar acordes de este año
    const acordesDelYear = acordes.filter((acorde) => acorde.data.year === year);

    return {
      params: { year },
      props: { year, acordes: acordesDelYear },
    };
  });
}

const { year, acordes } = Astro.props;

const acordesOrdenados = acordes.sort((a, b) => {
  return parseSpanishDate(b.data.date).getTime() - parseSpanishDate(a.data.date).getTime();
});

const title = `Carnaval de Cádiz ${year} - Acordes de guitarra`;
const description = `Todos los acordes de guitarra del Carnaval de Cádiz ${year}. Encuentra acordes de chirigotas, comparsas, cuartetos y coros del año ${year}.`;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: acordesOrdenados.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${a.data.pieza} - ${a.data.agrupacion}`,
    item: `${Astro.site}acordes/${a.slug}`,
  })),
};
---

<Layout title={title} description={description}>
  <script type='application/ld+json' set:html={JSON.stringify(itemListSchema)} />
  <Breadcrumb year={year} />
  <AnuncioSobrePagina />
  <div class='main-container'>
    <section>
      <Banner468X60 adKey='0a8164971e8c287ce3c84cea534f2266' />
      <Banner320X50 adKey='00168e813d28ccdbf699a41e61d3b2ab' />
      <CardsGroup year={year} acordes={acordesOrdenados} />
      <div class='mt-8'>
        <Banner468X60 adKey='be6be37dbe0209cf5eefbd113646e161' />
      </div>
      <Banner320X50 adKey='dfd3df20af74dd22bc5fae2ddf874fa4' />
    </section>
  </div>
</Layout>

<style>
  .main-container {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap);
  }

  section {
    display: flex;
    flex-direction: column;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h1 {
    color: var(--primary-color);
    font-size: 2rem;
    font-family: 'Montserrat', sans-serif;
    letter-spacing: 1.4px;
    font-weight: 700;
    margin: 0;
  }

  .subtitle {
    color: var(--text-secondary-color);
    font-size: 1.1rem;
    margin: 0;
  }

  @media (max-width: 640px) {
    .main-container {
      gap: var(--main-container-gap-sm);
    }

    h1 {
      font-size: 1.6rem;
    }

    .subtitle {
      font-size: 1rem;
    }
  }
</style>
