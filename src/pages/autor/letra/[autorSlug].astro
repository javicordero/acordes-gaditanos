---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import CardsGroup from '../../../components/page/CardsGroup.astro';

import Breadcrumb from '../../../components/page/Breadcrumb.astro';
import Banner320X50 from '../../../components/ads/Banner320x50.astro';
import Banner468X60 from '../../../components/ads/Banner468x60.astro';
import { parseSpanishDate, sortByYearDesc } from '../../../lib/index';

export async function getStaticPaths() {
  const acordes = await getCollection('acordes');

  // Recopilar solo autores de letra (ahora con múltiples autores)
  const autoresMap = new Map<string, { nombre: string; acordes: any[] }>();

  acordes.forEach((acorde) => {
    const lista = acorde.data.letraList ?? [];
    const slugs = acorde.data.letraSlugs ?? [];
    lista.forEach((nombre: string, i: number) => {
      const slug = slugs[i];
      if (slug) {
        if (!autoresMap.has(slug)) {
          autoresMap.set(slug, { nombre, acordes: [] });
        }
        autoresMap.get(slug)!.acordes.push(acorde);
      }
    });
  });

  return Array.from(autoresMap.entries()).map(([slug, data]) => ({
    params: { autorSlug: slug },
    props: {
      authorName: data.nombre,
      acordes: data.acordes,
    },
  }));
}

const { authorName, acordes } = Astro.props;

const acordesOrdenados = acordes.sort((a, b) => {
  const yearA = a.data.year;
  const yearB = b.data.year;

  if (yearA !== yearB) {
    return sortByYearDesc(yearA, yearB);
  }

  return parseSpanishDate(b.data.date).getTime() - parseSpanishDate(a.data.date).getTime();
});

const title = `${authorName} (Letra) - Acordes del Carnaval de Cádiz`;
const description = `Todos los acordes con letra de ${authorName} del Carnaval de Cádiz. Explora todas las agrupaciones y piezas de este autor.`;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: acordesOrdenados.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${a.data.pieza} - ${a.data.agrupacion}`,
    item: `${Astro.site}acordes/${a.slug}`,
  })),
};
---

<Layout title={title} description={description}>
  <script type='application/ld+json' set:html={JSON.stringify(itemListSchema)} />
  <Breadcrumb autor={authorName} autorSlug={Astro.params.autorSlug} tipoAutor='letra' />
  <div class='main-container'>
    <section>
      <Banner468X60 adKey='0a8164971e8c287ce3c84cea534f2266' />
      <Banner320X50 adKey='00168e813d28ccdbf699a41e61d3b2ab' />
      <CardsGroup year={`${authorName}`} acordes={acordesOrdenados} subtitle='Letra' />
      <Banner320X50 adKey='dfd3df20af74dd22bc5fae2ddf874fa4' />
    </section>
  </div>
</Layout>

<style>
  .main-container {
    display: flex;
    flex-direction: column;
    gap: var(--main-container-gap);
  }

  @media (max-width: 640px) {
    .main-container {
      gap: var(--main-container-gap-sm);
    }
  }
</style>
