---
import Layout from '../layouts/Layout.astro';
---

<Layout title='404 - Página no encontrada'>
  <div class='error-page'>
    <div class='error-content'>
      <h1 class='error-code'>404</h1>
      <h2 class='error-message'>Página no encontrada</h2>
      <a href='/' class='btn-home'>Volver al inicio</a>
    </div>
  </div>
</Layout>

<style>
  .error-page {
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-color);
  }

  .error-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
    padding: 32px;
    border: 2px solid var(--primary-contrast-color);
    box-shadow: 10px 10px 0 0 var(--primary-contrast-color);
    width: calc(100% - 32px);
    max-width: 640px;
    box-sizing: border-box;
  }

  .error-code {
    font-family: 'Roboto Mono', monospace;
    font-size: 10rem;
    font-weight: 800;
    color: var(--primary-contrast-color);
    margin: 0;
    letter-spacing: 4px;
    line-height: 1;
  }

  .error-message {
    font-family: 'Roboto Mono', monospace;
    font-size: 2.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #ffffff;
    margin: 0;
  }

  .error-description {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    max-width: 500px;
    line-height: 1.6;
  }

  .btn-home {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2.5rem;
    margin-top: 1rem;
    background-color: var(--primary-contrast-color);
    color: var(--on-bright-color);
    text-decoration: none;
    border: 2px solid var(--on-bright-color);
    border-radius: 0;
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 0 var(--on-bright-color);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;

    &:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 0 var(--on-bright-color);
    }

    &:active {
      transform: translateY(0);
      box-shadow: 2px 2px 0 0 var(--on-bright-color);
    }
  }

  @media (max-width: 768px) {
    .error-code {
      font-size: 7rem;
    }

    .error-message {
      font-size: 2rem;
    }

    .error-description {
      font-size: 1.125rem;
    }
  }

  @media (max-width: 480px) {
    .error-code {
      font-size: 5rem;
      letter-spacing: 2px;
    }

    .error-message {
      font-size: 1.5rem;
    }

    .error-description {
      font-size: 1rem;
    }

    .btn-home {
      padding: 0.875rem 2rem;
      font-size: 1rem;
    }
  }
</style>
