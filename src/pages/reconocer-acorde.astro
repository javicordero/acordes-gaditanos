---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/page/Breadcrumb.astro';
import DiagramaAcorde from '../components/page/DiagramaAcorde.astro';
import glosarioJson from '../data/glosario-acordes.json';
import { slugAcorde, type EntradaGlosario, type Glosario } from '../lib/acordes';
import { mapaPosturas } from '../lib/reconocer-glosario';

const glosario = (glosarioJson as unknown as { acordes: Glosario }).acordes;
const slugs = [...new Set(Object.values(glosario).map((entrada) => slugAcorde(entrada)))];

// Posturas exactas del glosario: sirven para poner el nombre que usa la web y
// enlazar a su página, no para reconocer (eso lo hace `reconocerAcorde` con las
// notas de cualquier postura, esté o no en el glosario).
const posturas = Object.fromEntries(mapaPosturas(glosario));

const EJEMPLOS = [
  'Do',
  'Lam',
  'Sol',
  'Mi',
  'Rem',
  'Fa',
  'Si7',
  'Do7',
  'Re',
  'La',
  'Mim',
  'Sol7',
];
const ejemplos = EJEMPLOS.map((etiqueta) => ({
  etiqueta,
  entrada: glosario[etiqueta] as EntradaGlosario,
})).filter((ejemplo) => ejemplo.entrada);

// Enlaces de refuerzo: no todos los acordes del glosario caben como tarjeta,
// pero sí como enlaces de texto agrupados por familia.
const GRUPOS_ACORDES: Array<{ titulo: string; etiquetas: string[] }> = [
  { titulo: 'Mayores', etiquetas: ['Do', 'Re', 'Mi', 'Fa', 'Sol', 'La', 'Si'] },
  { titulo: 'Menores', etiquetas: ['Lam', 'Rem', 'Mim', 'Solm', 'Dom', 'Fam', 'Sim'] },
  { titulo: 'Séptimas', etiquetas: ['Do7', 'Re7', 'Mi7', 'Fa7', 'Sol7', 'La7', 'Si7'] },
  {
    titulo: 'Otras lecturas',
    etiquetas: ['Do6', 'Lam7', 'Do/Mi', 'Sim7b5', 'Do#dim7', 'Sibdim7', 'Do9', 'Lam9'],
  },
];

const gruposAcordes = GRUPOS_ACORDES.map(({ titulo, etiquetas }) => ({
  titulo,
  acordes: etiquetas
    .map((etiqueta) => {
      const entrada = glosario[etiqueta] as EntradaGlosario | undefined;
      return entrada ? { etiqueta, entrada } : null;
    })
    .filter(
      (acorde): acorde is { etiqueta: string; entrada: EntradaGlosario } => Boolean(acorde),
    ),
})).filter((grupo) => grupo.acordes.length > 0);

const ejemploDo = glosario['Do'] as EntradaGlosario;

const CUERDAS = [6, 5, 4, 3, 2, 1];
const NOTAS_CUERDA = ['Mi', 'La', 'Re', 'Sol', 'Si', 'Mi'];
const TRASTES = Array.from({ length: 12 }, (_, i) => i + 1);

const title = '¿Qué acorde estoy tocando? Reconocer acordes de guitarra';
const description =
  '¿Qué acorde estás tocando? Dibuja la postura en el mástil y descubre su nombre, notas y alternativas. Reconoce acordes de guitarra gratis y sin instalar.';
const keywords =
  'reconocer acordes de guitarra, identificar acordes de guitarra, qué acorde estoy tocando, qué acorde es, nombre del acorde por postura, acordes invertidos, Do/Mi, acordes con cejilla, tipos de acordes, mástil interactivo, acordes de Carnaval';

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Reconocer acordes de guitarra',
  description,
  url: canonicalURL,
  applicationCategory: 'MusicApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'es-ES',
  isAccessibleForFree: true,
  dateModified: '2026-11-09',
  featureList: [
    'Reconocer un acorde por la postura en el mástil',
    'Calcular las notas de cada cuerda en afinación estándar',
    'Mostrar la fundamental, la inversión y las lecturas alternativas',
    'Enlazar con todas las posiciones del glosario de acordes',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
  },
  isPartOf: {
    '@type': 'WebSite',
    name: 'Acordes Gaditanos',
    url: Astro.site,
  },
};

const faqs = [
  {
    pregunta: '¿Cómo saber qué acorde estoy tocando?',
    respuesta:
      'Cada traste de cada cuerda produce una nota. El reconocedor calcula las notas que suenan en las seis cuerdas (con la afinación estándar Mi-La-Re-Sol-Si-Mi), busca qué fundamental y qué tipo de acorde las contienen y te dice el nombre. También señala las notas que faltan y las otras lecturas posibles.',
  },
  {
    pregunta: '¿Reconoce acordes de una canción por el audio?',
    respuesta:
      'No. Este reconocedor funciona por la postura: tú dibujas en el mástil qué cuerdas pisas, cuáles suenan al aire y cuáles no se tocan. Para sacar los acordes de una canción hace falta analizar el audio, que es otra herramienta. En el cancionero tienes las coplas del Carnaval ya cifradas.',
  },
  {
    pregunta: '¿Y si uso cejilla?',
    respuesta:
      'El mástil está en afinación estándar y no corrige la cejilla. El nombre que te damos es el del acorde que forman esas posiciones sin cejilla; con la cejilla puesta sonará más agudo. Las páginas de cada acorde sí indican la cejilla cuando la copla la necesita.',
  },
  {
    pregunta: '¿Por qué me da dos nombres para la misma postura?',
    respuesta:
      'Una misma combinación de notas puede leerse como acordes distintos: por ejemplo, Do6 y Lam7 comparten las mismas notas. Mostramos como principal la lectura más probable según la nota del bajo y, debajo, las alternativas. Si la postura está en el glosario, aparece además el nombre con el que la tiene la web.',
  },
  {
    pregunta: '¿Funciona con posturas que no están en el glosario?',
    respuesta:
      'Sí. No consulta una lista de posturas: analiza las notas de cualquier combinación de trastes. Si no encaja en ningún acorde conocido, te muestra las notas que suenan y te avisa de que no se reconoce.',
  },
  {
    pregunta: '¿Necesito instalar algo?',
    respuesta:
      'No. El mástil funciona en el navegador, también en el móvil. Solo necesita JavaScript; sin él puedes seguir consultando el glosario de acordes.',
  },
  {
    pregunta: '¿Cómo se llama el acorde que estoy haciendo con estos dedos?',
    respuesta:
      'Dibuja en el mástil las cuerdas que pisas, marca con ○ las que suenan al aire y con × las que no se tocan. El reconocedor calcula las notas y te da el nombre más probable. Si no lo reconoce, revisa las cuerdas mudas: una cuerda de más o de menos cambia el acorde.',
  },
  {
    pregunta: '¿Qué significa Do/Mi?',
    respuesta:
      'Que el acorde es Do mayor pero la nota más grave que suena es Mi. La barra indica la inversión: las notas siguen siendo Do, Mi y Sol, pero cambia el bajo y, con él, el color del acorde.',
  },
  {
    pregunta: '¿Sirve para guitarra española, clásica o eléctrica?',
    respuesta:
      'Sí. Todas usan la misma afinación estándar (Mi-La-Re-Sol-Si-Mi) y las mismas notas. Si tu guitarra tiene otra afinación o más cuerdas, el resultado no será exacto: el mástil está pensado para seis cuerdas en afinación estándar.',
  },
  {
    pregunta: '¿Puedo reconocer un acorde con cuerdas al aire?',
    respuesta:
      'Sí. Pulsa el botón de la izquierda de cada cuerda para marcarla como ○ (al aire) o × (muda). Las cuerdas sin punto y sin ○ no suenan. Así puedes dibujar posturas abiertas como Do, Lam o Mi.',
  },
  {
    pregunta: '¿Cómo se escriben los sostenidos y bemoles?',
    respuesta:
      'Usamos notación española: Do#, Re#, Fa#, Sol#, La# y Sib, Mib, Reb, Solb. En el buscador del glosario también puedes escribir la notación inglesa (C#, Bb…), pero el reconocedor muestra siempre los nombres en español.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ pregunta, respuesta }) => ({
    '@type': 'Question',
    name: pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: respuesta,
    },
  })),
};
---

<Layout title={title} description={description} keywords={keywords}>
  <script type='application/ld+json' set:html={JSON.stringify(webAppSchema)} />
  <script type='application/ld+json' set:html={JSON.stringify(faqSchema)} />

  <Breadcrumb
    parent={{ name: 'Glosario de acordes', href: '/glosario/' }}
    current='Reconocer acordes de guitarra'
  />

  <div class='main-container'>
    <section>
      <article class='container-layout inner-content reconocer'>
        <header class='reconocer__header'>
          <h1>Reconocer acordes de guitarra</h1>
          <p class='reconocer__intro'>
            ¿Qué acorde estás tocando? Dibuja la postura en el mástil —qué cuerdas pisas, cuáles
            suenan al aire y cuáles no se tocan— y te decimos su nombre. No hace falta que la postura
            esté en el glosario: se analizan las notas que suenan.
          </p>
        </header>

        <p class='reconocer__aviso'>
          <strong>Esta herramienta reconoce por la postura, no por audio.</strong>
          Si buscas los acordes de una canción, están en
          <a href='/lista/'>el cancionero del Carnaval</a>.
        </p>

        <noscript>
          <p class='reconocer__noscript'>
            El reconocedor necesita JavaScript para analizar la postura. Mientras tanto, puedes
            buscar el acorde en el <a href='/glosario'>glosario de acordes</a> o mirar los ejemplos de
            abajo.
          </p>
        </noscript>

        <div class='reconocer__layout'>
          <div class='reconocer__tablero'>
            <div class='reconocer__cabecera'>
              <span class='reconocer__esquina' aria-hidden='true'></span>
              {
                TRASTES.map((traste) => (
                  <span class='reconocer__traste-num' aria-hidden='true'>
                    {traste}
                  </span>
                ))
              }
            </div>

            <div class='reconocer__mastil' role='group' aria-label='Mástil de guitarra'>
              {
                CUERDAS.map((cuerda, i) => (
                  <div class='reconocer__cuerda-fila'>
                    <div class='reconocer__cuerda-info'>
                      <button
                        type='button'
                        class='reconocer__estado'
                        data-estado={i}
                        aria-label={`Cuerda ${cuerda} (${NOTAS_CUERDA[i]}): muda`}
                      >
                        ×
                      </button>
                      <span class='reconocer__nota' aria-hidden='true'>
                        {NOTAS_CUERDA[i]}
                      </span>
                    </div>
                    {TRASTES.map((traste) => (
                      <button
                        type='button'
                        class='reconocer__celda'
                        data-cuerda={i}
                        data-traste={traste}
                        aria-label={`Cuerda ${cuerda}, traste ${traste}`}
                        aria-pressed='false'
                        tabindex={traste === 1 && i === 0 ? 0 : -1}
                      />
                    ))}
                  </div>
                ))
              }
            </div>

            <p class='reconocer__pista'>
              Pulsa un traste para poner un punto. Marca con <strong>○</strong> las cuerdas que
              suenan al aire y con <strong>×</strong> las que no se tocan. Las cuerdas sin punto y
              sin ○ no suenan.
            </p>
            <p class='reconocer__lectura' data-lectura aria-live='polite'></p>
          </div>

          <aside class='reconocer__panel' aria-live='polite'>
            <p class='reconocer__etiqueta'>Acorde</p>
            <p class='reconocer__nombre' data-nombre>—</p>
            <p class='reconocer__notas' data-notas></p>
            <p class='reconocer__omitidas' data-omitidas></p>
            <p class='reconocer__ayuda' data-ayuda>
              Coloca puntos en el mástil o marca cuerdas al aire.
            </p>

            <div class='reconocer__alternativas' data-alternativas hidden>
              <p class='reconocer__etiqueta'>También podría ser</p>
              <ul class='reconocer__lista' data-lista></ul>
            </div>

            <p class='reconocer__glosario' data-glosario hidden>
              En el glosario: <a data-glosario-enlace></a>
            </p>

            <a class='reconocer__enlace' data-enlace href='/glosario' hidden>
              Ver todas sus posiciones
            </a>

            <button type='button' class='reconocer__limpiar' data-limpiar>Limpiar mástil</button>
          </aside>
        </div>

        <nav class='reconocer__indice' aria-label='En esta página'>
          <p class='reconocer__indice-titulo'>En esta página</p>
          <ul class='reconocer__indice-lista'>
            <li><a href='#como-usarlo'>Cómo usarlo en 4 pasos</a></li>
            <li><a href='#que-acorde-estoy-tocando'>¿Qué acorde estoy tocando?</a></li>
            <li><a href='#ejemplo-do-mayor'>Ejemplo resuelto</a></li>
            <li><a href='#como-se-nombra-un-acorde'>Cómo se nombra un acorde</a></li>
            <li><a href='#cejilla-y-transporte'>Cejilla y transporte</a></li>
            <li><a href='#si-no-reconoce'>Si no lo reconoce</a></li>
            <li><a href='#tipos-de-acorde'>Tipos de acorde</a></li>
            <li><a href='#ejemplos-titulo'>Ejemplos por postura</a></li>
            <li><a href='#del-mastil-a-la-copla'>Del mástil a la copla</a></li>
            <li><a href='#preguntas-frecuentes'>Preguntas frecuentes</a></li>
          </ul>
        </nav>

        <section class='reconocer__seccion'>
          <h2 id='como-usarlo'>Cómo usarlo en 4 pasos</h2>
          <ol class='reconocer__pasos'>
            <li>
              Afina la guitarra en afinación estándar: <strong>Mi-La-Re-Sol-Si-Mi</strong>, de la 6ª
              cuerda a la 1ª.
            </li>
            <li>
              Marca con un punto el traste que pisa cada dedo. La cuerda que no suena va con
              <strong>×</strong>.
            </li>
            <li>
              Marca con <strong>○</strong> las cuerdas que suenan al aire. Las cuerdas sin punto y
              sin ○ tampoco suenan.
            </li>
            <li>
              Lee el nombre del acorde, sus notas y las alternativas. Si la postura está en el
              glosario, tendrás el enlace a todas sus posiciones.
            </li>
          </ol>
          <p>
            También puedes moverte por el mástil con las flechas del teclado. Para empezar, prueba
            con el ejemplo resuelto de <a href='#ejemplo-do-mayor'>Do mayor</a>.
          </p>
        </section>

        <section class='reconocer__seccion'>
          <h2 id='que-acorde-estoy-tocando'>¿Qué acorde estoy tocando?</h2>
          <p>
            Para saber qué acorde estás tocando, identifica las notas que suenan en las seis cuerdas.
            Si son <strong>Do, Mi y Sol</strong>, el acorde es <strong>Do mayor</strong>; si son
            <strong>La, Do y Mi</strong>, es <strong>La menor</strong>. La nota más grave que suena
            decide la inversión: <em>Do/Mi</em> es un Do con Mi en el bajo.
          </p>
          <p>
            Cada traste de cada cuerda produce una nota. En afinación estándar
            (Mi-La-Re-Sol-Si-Mi), un punto en el traste 3 de la 5ª cuerda es un Do, y en el traste 2
            de la 4ª es un Mi. El reconocedor calcula esas notas, busca qué fundamental y qué tipo de
            acorde las contienen y descarta las que no encajan.
          </p>
        </section>

        <section class='reconocer__seccion'>
          <h2 id='ejemplo-do-mayor'>Ejemplo resuelto: Do mayor</h2>
          <div class='reconocer__resuelto'>
            <div class='reconocer__resuelto-diagrama'>
              <DiagramaAcorde
                nombre='Do'
                posicion={ejemploDo.posiciones[0]!}
                ancho={132}
                alto={168}
              />
            </div>
            <div class='reconocer__resuelto-texto'>
              <p>Esta es la postura abierta de <strong>Do mayor</strong>:</p>
              <ul>
                <li>6ª cuerda: no se toca (×).</li>
                <li>5ª cuerda: traste 3, suena <strong>Do</strong>.</li>
                <li>4ª cuerda: traste 2, suena <strong>Mi</strong>.</li>
                <li>3ª cuerda: al aire, suena <strong>Sol</strong>.</li>
                <li>2ª cuerda: traste 1, suena <strong>Do</strong>.</li>
                <li>1ª cuerda: al aire, suena <strong>Mi</strong>.</li>
              </ul>
              <p>
                Las notas son Do, Mi y Sol: fundamental, tercera mayor y quinta. Por eso el
                reconocedor la llama <strong>Do</strong>. Si dibujas esa misma postura en el mástil,
                verás el resultado y el enlace a
                <a href='/glosario/do/'>todas las posiciones de Do</a>.
              </p>
            </div>
          </div>
        </section>

        <section class='reconocer__seccion'>
          <h2 id='como-se-nombra-un-acorde'>Cómo se nombra un acorde</h2>
          <p>
            Un acorde es un conjunto de notas que suenan a la vez. En la guitarra, la postura o
            digitación indica qué traste pisa cada dedo y qué cuerdas quedan al aire o mudas. Para
            nombrarlo importan la <strong>fundamental</strong> (la nota que le da nombre), la
            <strong>tercera</strong> —mayor o menor— y, cuando toca, la séptima, la sexta o las
            extensiones. La quinta a veces se omite: muchas posturas de guitarra no la tocan y el
            acorde sigue siendo el mismo.
          </p>
          <div class='reconocer__tabla-scroll'>
            <table class='reconocer__tabla'>
              <thead>
                <tr>
                  <th>Intervalo</th>
                  <th>Nota desde Do</th>
                  <th>Qué aporta</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>1</td><td>Do</td><td>Fundamental: da nombre al acorde</td></tr>
                <tr><td>b3</td><td>Re# / Mib</td><td>Tercera menor: acorde menor</td></tr>
                <tr><td>3</td><td>Mi</td><td>Tercera mayor: acorde mayor</td></tr>
                <tr><td>4</td><td>Fa</td><td>Cuarta: acordes sus4</td></tr>
                <tr><td>b5</td><td>Fa# / Solb</td><td>Quinta disminuida: dim y m7b5</td></tr>
                <tr><td>5</td><td>Sol</td><td>Quinta justa: la que más se omite</td></tr>
                <tr><td>#5</td><td>Sol# / Lab</td><td>Quinta aumentada: aug</td></tr>
                <tr><td>6</td><td>La</td><td>Sexta: acordes 6 y m6</td></tr>
                <tr><td>b7</td><td>Sib / La#</td><td>Séptima menor: 7, m7, 9, 11 y 13</td></tr>
                <tr><td>7</td><td>Si</td><td>Séptima mayor: maj7 y maj9</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            Con esa base, <a href='/glosario/do/'>Do</a> es 1-3-5,
            <a href='/glosario/lam/'>Lam</a> es 1-b3-5, <a href='/glosario/si7/'>Si7</a> es 1-3-5-b7
            y <a href='/glosario/sim7b5/'>Sim7b5</a> es 1-b3-b5-b7.
          </p>

          <h3>Acordes que comparten notas</h3>
          <p>
            Una misma postura puede tener varias lecturas. <a href='/glosario/do6/'>Do6</a> y
            <a href='/glosario/lam7/'>Lam7</a> comparten las mismas notas;
            <a href='/glosario/do-sostenido-dim7/'>Do#dim7</a> y
            <a href='/glosario/si-bemol-dim7/'>Sibdim7</a>, también. Mostramos la más probable según
            el bajo y la posición, y debajo las alternativas. Si la postura está en el
            <a href='/glosario/'>glosario</a>, verás además el nombre con el que la tiene la web y el
            enlace a su página.
          </p>

          <h3>Inversiones: qué significa Do/Mi</h3>
          <p>
            La nota más grave que suena decide la inversión. <a href='/glosario/do-mi/'>Do/Mi</a> es
            un Do mayor con Mi en el bajo: las notas siguen siendo Do, Mi y Sol, pero cambia el orden
            y el color del acorde. El reconocedor escribe la inversión con una barra y, si la postura
            está en el glosario, enlaza con su página.
          </p>
        </section>

        <section class='reconocer__seccion'>
          <h2 id='cejilla-y-transporte'>Cejilla y transporte</h2>
          <p>
            El mástil está en afinación estándar y <strong>no corrige la cejilla</strong>. Si pones
            una cejilla y haces la postura de Do, el acorde sonará más agudo: el nombre que te damos
            es el de la postura sin cejilla. Para saber qué suena de verdad, suma los semitonos de la
            cejilla.
          </p>
          <div class='reconocer__tabla-scroll'>
            <table class='reconocer__tabla'>
              <thead>
                <tr>
                  <th>Cejilla</th>
                  <th>Semitonos</th>
                  <th>Do suena como</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>1</td><td>+1</td><td>Do#</td></tr>
                <tr><td>2</td><td>+2</td><td>Re</td></tr>
                <tr><td>3</td><td>+3</td><td>Re#</td></tr>
                <tr><td>4</td><td>+4</td><td>Mi</td></tr>
                <tr><td>5</td><td>+5</td><td>Fa</td></tr>
                <tr><td>7</td><td>+7</td><td>Sol</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            Por ejemplo, con cejilla en el traste 2, la postura de Do suena como Re. Si la copla
            necesita cejilla, la página de cada acorde lo indica.
          </p>
        </section>

        <section class='reconocer__seccion'>
          <h2 id='si-no-reconoce'>Si no reconoce tu acorde</h2>
          <p>
            Cuando la postura no encaja en ningún acorde conocido, el reconocedor te muestra las
            notas que suenan. Revisa estos puntos antes de darla por perdida:
          </p>
          <ul class='reconocer__errores'>
            <li>
              <strong>Cuerdas mudas:</strong> comprueba que las que no se tocan están marcadas con ×.
            </li>
            <li>
              <strong>Cuerdas al aire:</strong> las que suenan sin pisar deben llevar ○.
            </li>
            <li>
              <strong>La tercera:</strong> sin tercera no se puede saber si el acorde es mayor o
              menor. Es la nota que más cambia el nombre.
            </li>
            <li>
              <strong>Notas de más:</strong> una sola nota fuera del acorde impide reconocerlo.
              Prueba a quitar cuerdas hasta encontrar el núcleo.
            </li>
            <li>
              <strong>Cejilla o afinación distinta:</strong> el mástil asume afinación estándar y no
              corrige la cejilla. Si usas otra afinación, el resultado no será exacto.
            </li>
          </ul>
        </section>

        <section class='reconocer__seccion'>
          <h2 id='tipos-de-acorde'>Qué tipos de acorde reconoce</h2>
          <p>
            No consulta una lista cerrada de posturas: analiza las notas de cualquier combinación de
            trastes. Reconoce estas familias:
          </p>
          <ul class='reconocer__tipos-lista'>
            <li>
              <strong>Tríadas</strong>: mayor (<a href='/glosario/do/'>Do</a>), menor
              (<a href='/glosario/lam/'>Lam</a>), quinta o power chord
              (<a href='/glosario/sol5/'>Sol5</a>), disminuido
              (<a href='/glosario/do-sostenido-dim/'>Do#dim</a>) y aumentado
              (<a href='/glosario/doaug/'>Doaug</a>).
            </li>
            <li>
              <strong>Con séptima</strong>: 7 (<a href='/glosario/si7/'>Si7</a>), m7, maj7, dim7
              (<a href='/glosario/do-sostenido-dim7/'>Do#dim7</a>), m7b5
              (<a href='/glosario/sim7b5/'>Sim7b5</a>), mmaj7, 7sus4, 7b5, 7maj5, 7b9 y 7#9.
            </li>
            <li>
              <strong>Con sexta</strong>: 6 (<a href='/glosario/do6/'>Do6</a>), m6 y 6add9.
            </li>
            <li><strong>Suspendidos</strong>: sus2, sus4 y sus9.</li>
            <li>
              <strong>Extensiones</strong>: add9, m(add9), add11, 9
              (<a href='/glosario/do9/'>Do9</a>), m9 (<a href='/glosario/lam9/'>Lam9</a>), maj9, 11
              y 13.
            </li>
            <li>
              <strong>Inversiones</strong>: cualquier acorde con otra nota en el bajo, como
              <a href='/glosario/do-mi/'>Do/Mi</a>.
            </li>
          </ul>
          <p>
            Si la combinación no encaja en ningún acorde conocido, te muestra las notas que suenan y
            te avisa de que no se reconoce.
          </p>
        </section>

        <section class='reconocer__seccion reconocer__ejemplos' aria-labelledby='ejemplos-titulo'>
          <h2 id='ejemplos-titulo'>Ejemplos de acordes por postura</h2>
          <p>
            Estas son algunas de las posturas que puedes dibujar en el mástil. Pincha en cualquiera
            para ver todas sus posiciones, la digitación y las coplas que lo usan.
          </p>
          <ul class='reconocer__ejemplos-lista'>
            {ejemplos.map(({ etiqueta, entrada }) => (
              <li>
                <a
                  class='reconocer__ejemplo'
                  href={`/glosario/${entrada.slug}/`}
                  data-ga-event='click_ejemplo_reconocer'
                >
                  <span class='reconocer__ejemplo-nombre'>{etiqueta}</span>
                  <DiagramaAcorde
                    nombre={etiqueta}
                    posicion={entrada.posiciones[0]!}
                    ancho={100}
                    alto={126}
                  />
                </a>
              </li>
            ))}
          </ul>

          <p class='reconocer__mas-intro'>
            También puedes consultar estos acordes directamente en el glosario:
          </p>
          <div class='reconocer__mas'>
            {gruposAcordes.map(({ titulo, acordes }) => (
              <div class='reconocer__mas-grupo'>
                <h3>{titulo}</h3>
                <ul class='reconocer__mas-lista'>
                  {acordes.map(({ etiqueta, entrada }) => (
                    <li>
                      <a href={`/glosario/${entrada.slug}/`}>{etiqueta}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section class='reconocer__seccion'>
          <h2 id='del-mastil-a-la-copla'>Del mástil a la copla</h2>
          <p>
            Si lo que quieres es tocar una copla del Carnaval de Cádiz, el reconocedor también te
            sirve para comprobar una postura antes de llevarla al cifrado. En cada ficha del
            cancionero tienes el panel <strong>«Acordes usados»</strong> con los acordes de esa copla
            y su enlace al glosario.
          </p>
          <p>
            <a href='/lista/'>Ver todas las coplas del Carnaval</a> ·
            <a href='/glosario/'>Volver al glosario de acordes</a>
          </p>
          <p>
            Si ya sabes qué acorde quieres aprender, no hace falta dibujarlo: tenemos selecciones
            con los <a href='/acordes-faciles-guitarra/'>acordes fáciles</a>, los
            <a href='/acordes-con-cejilla/'>acordes con cejilla</a>, los que mejor suenan en
